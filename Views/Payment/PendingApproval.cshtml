@{
    ViewData["Title"] = "Pending Approval - NutrInfo FNS";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="/Logo/cp.png" />
    <title>Pending Approval - NutrInfo FNS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/fns-ui.css" rel="stylesheet" />
</head>
<body class="fns-status-shell">
    <div class="container text-center" style="max-width: 540px;">
        <div class="mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-amber-subtle rounded-circle p-4 mb-3" style="width: 88px; height: 88px; background: rgba(245, 158, 11, 0.15); border: 2px solid rgba(245, 158, 11, 0.3);">
                <i class="fas fa-clock fs-1 text-warning"></i>
            </div>
            <h2 class="fw-bold mb-2" style="font-family: 'Outfit', sans-serif;">Approval Pending</h2>
            <p class="text-secondary">Your subscription payment has been received and is currently being verified by our team.</p>
        </div>

        <div class="info-box text-start mb-4">
            <h6 class="fw-bold text-dark mb-2"><i class="fas fa-info-circle text-primary me-2"></i>What happens next?</h6>
            <p class="small text-secondary mb-2">• An administrator will review your payment transaction details.</p>
            <p class="small text-secondary mb-2">• Once verified, your account will instantly unlock full access.</p>
            <p class="small text-secondary m-0">• You will receive an automated confirmation email upon decision.</p>
        </div>

        <div class="d-grid gap-2 d-sm-flex justify-content-center">
            <button onclick="window.location.reload();" class="btn btn-primary px-4 py-2 fw-semibold">
                <i class="fas fa-sync-alt me-2"></i> Check Status
            </button>
            <a href="/User/Login" class="btn btn-secondary px-4 py-2 fw-semibold">
                <i class="fas fa-sign-out-alt me-2"></i> Sign Out
            </a>
        </div>
    </div>
</body>
</html>
