@{
    ViewData["Title"] = "Payment - ReserveEase";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="/Logo/cp.png" />
    <title>Payment - ReserveEase</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
            overflow-x: hidden;
        }

        .payment-container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            width: 100%;
            max-width: 480px;
            padding: 35px 30px;
            max-height: 90vh;
            overflow-y: auto;
        }

        .payment-container::-webkit-scrollbar {
            width: 8px;
        }

        .payment-container::-webkit-scrollbar-track {
            background: #f1f1f1;
            border-radius: 10px;
        }

        .payment-container::-webkit-scrollbar-thumb {
            background: #667eea;
            border-radius: 10px;
        }

        .payment-container::-webkit-scrollbar-thumb:hover {
            background: #764ba2;
        }

        .payment-header {
            text-align: center;
            margin-bottom: 28px;
        }

        .payment-header h2 {
            color: #333;
            font-weight: 700;
            margin-bottom: 8px;
            font-size: 1.8rem;
        }

        .payment-header p {
            color: #666;
            font-size: 0.95rem;
            margin: 0;
        }

        .amount-section {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 25px;
            border-radius: 12px;
            text-align: center;
            margin-bottom: 28px;
        }

        .amount-label {
            font-size: 0.85rem;
            opacity: 0.9;
            margin-bottom: 8px;
            letter-spacing: 0.5px;
            text-transform: uppercase;
        }

        .amount-value {
            font-size: 2.8rem;
            font-weight: 700;
            margin-bottom: 8px;
            line-height: 1;
        }

        .amount-currency {
            font-size: 0.9rem;
            opacity: 0.85;
        }

        .payment-details {
            background: #f8f9fa;
            border-radius: 10px;
            padding: 20px;
            margin-bottom: 25px;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 12px;
            font-size: 0.93rem;
        }

        .detail-row:last-child {
            margin-bottom: 0;
        }

        .detail-label {
            color: #666;
            font-weight: 500;
        }

        .detail-value {
            color: #333;
            font-weight: 600;
        }

        .button-group {
            display: flex;
            gap: 12px;
            margin-top: 26px;
        }

        .btn-pay {
            flex: 1;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 13px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.98rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-pay:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.35);
        }

        .btn-pay:active {
            transform: translateY(0);
        }

        .btn-pay:disabled {
            opacity: 0.7;
            cursor: not-allowed;
        }

        .btn-cancel {
            flex: 1;
            background: #f0f0f0;
            color: #333;
            border: 1.5px solid #ddd;
            padding: 13px 20px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 0.98rem;
            cursor: pointer;
            transition: all 0.3s ease;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .btn-cancel:hover {
            background: #e9e9e9;
            border-color: #bbb;
        }

        .btn-cancel:active {
            background: #ddd;
        }

        .info-section {
            background: #e8f4f8;
            border-left: 4px solid #667eea;
            padding: 14px 15px;
            border-radius: 6px;
            margin-top: 20px;
            font-size: 0.88rem;
            color: #555;
            line-height: 1.5;
        }

        .info-icon {
            color: #667eea;
            margin-right: 8px;
            font-weight: 600;
        }

        .loading-spinner {
            display: none;
            text-align: center;
            padding: 40px 20px;
        }

        .spinner {
            display: inline-block;
            width: 45px;
            height: 45px;
            border: 4px solid rgba(102, 126, 234, 0.2);
            border-top-color: #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            to { transform: rotate(360deg); }
        }

        .error-alert {
            display: none;
            background: #fff3cd;
            border: 1.5px solid #ffc107;
            color: #856404;
            padding: 13px 14px;
            border-radius: 8px;
            margin-bottom: 18px;
            font-size: 0.92rem;
            line-height: 1.4;
        }

        .success-message {
            display: none;
            text-align: center;
            padding: 30px 20px;
        }

        .success-icon {
            font-size: 3.5rem;
            color: #28a745;
            margin-bottom: 16px;
        }

        .success-message h3 {
            color: #28a745;
            margin-bottom: 12px;
            font-size: 1.5rem;
        }

        .success-message p {
            color: #666;
            margin-bottom: 0;
            font-size: 0.95rem;
        }
    </style>
    <link href="/css/fns-ui.css" rel="stylesheet" />
</head>
<body class="fns-payment-shell">
    <div class="payment-container">
        <div class="payment-header">
            <h2>💳 Dummy Payment</h2>
            <p>Complete your payment to continue to ReserveEase</p>
        </div>

        <div class="amount-section">
            <div class="amount-label">Amount to Pay</div>
            <div class="amount-value">₹@ViewBag.Amount</div>
            <div class="amount-currency">@ViewBag.Currency</div>
        </div>

        <div class="error-alert" id="errorAlert"></div>

        <div id="paymentForm">
            <div class="payment-details">
                <div class="detail-row">
                    <span class="detail-label">Name:</span>
                    <span class="detail-value">@ViewBag.Name</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Email:</span>
                    <span class="detail-value">@ViewBag.Email</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Amount:</span>
                    <span class="detail-value">₹@ViewBag.Amount @ViewBag.Currency</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status:</span>
                    <span class="detail-value" style="color: #667eea;">Pending Admin Approval</span>
                </div>
            </div>

            <div class="button-group">
                <button class="btn-pay" id="payBtn" onclick="completePayment()">Proceed to Pay</button>
                <button class="btn-cancel" onclick="cancelPayment()">Cancel</button>
            </div>

            <div class="info-section">
                <span class="info-icon">ℹ️</span>
                <strong>Note:</strong> This is a dummy payment gateway. Your payment will be processed for admin review before granting access.
            </div>
        </div>

        <div class="loading-spinner" id="loadingSpinner">
            <div class="spinner"></div>
            <p style="margin-top: 15px; color: #667eea; font-weight: 600;">Processing payment...</p>
        </div>

        <div class="success-message" id="successMessage">
            <div class="success-icon">⏳</div>
            <h3>Payment Submitted!</h3>
            <p>Your payment is awaiting admin approval. You will receive an email notification soon.</p>
        </div>
    </div>

    <script>
        const email = '@ViewBag.Email';
        const name = '@ViewBag.Name';

        function completePayment() {
            document.getElementById('paymentForm').style.display = 'none';
            document.getElementById('loadingSpinner').style.display = 'block';

            const paymentData = {
                paymentMethod: 'Dummy Gateway'
            };

            fetch('/Payment/ProcessPayment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(paymentData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('loadingSpinner').style.display = 'none';
                    document.getElementById('successMessage').style.display = 'block';

                    setTimeout(function() {
                        window.location.href = data.redirectUrl;
                    }, 3000);
                } else {
                    document.getElementById('loadingSpinner').style.display = 'none';
                    document.getElementById('paymentForm').style.display = 'block';
                    showError(data.message || 'Payment processing failed');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById('loadingSpinner').style.display = 'none';
                document.getElementById('paymentForm').style.display = 'block';
                showError('An error occurred during payment processing');
            });
        }

        function showError(message) {
            const errorAlert = document.getElementById('errorAlert');
            errorAlert.textContent = message;
            errorAlert.style.display = 'block';
        }

        function cancelPayment() {
            if (confirm('Are you sure you want to cancel the payment?')) {
                window.history.back();
            }
        }
    </script>
</body>
</html>
