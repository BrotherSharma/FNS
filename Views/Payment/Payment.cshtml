@{
    ViewData["Title"] = "Payment - NutrInfo FNS";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="/Logo/cp.png" />
    <title>Payment - NutrInfo FNS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>
    <link href="/css/fns-ui.css" rel="stylesheet" />
</head>
<body class="fns-payment-shell">
    <div class="payment-container">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-white rounded-circle p-3 shadow-sm mb-3" style="width: 64px; height: 64px;">
                <i class="fas fa-credit-card fs-3 text-success"></i>
            </div>
            <h3 class="fw-bold m-0" style="font-family: 'Outfit', sans-serif;">Payment Gateway</h3>
            <p class="text-secondary small m-0 mt-1">Complete your subscription to unlock full NutrInfo features</p>
        </div>

        <div class="amount-section shadow-sm">
            <div class="amount-label text-uppercase fw-semibold" style="letter-spacing: 1px; opacity: 0.9; font-size: 12px;">Amount to Pay</div>
            <div class="amount-value fw-extrabold display-5 my-1">₹@ViewBag.Amount</div>
            <div class="amount-currency small opacity-75">@ViewBag.Currency</div>
        </div>

        <div class="alert alert-warning border-0 rounded-3 small py-2 px-3 mb-3" id="errorAlert" style="display: none;"></div>

        <div id="paymentForm">
            <div class="payment-details mb-4">
                <div class="detail-row d-flex justify-content-between py-2 border-bottom">
                    <span class="detail-label text-muted">Subscriber Name:</span>
                    <span class="detail-value fw-bold text-dark">@ViewBag.Name</span>
                </div>
                <div class="detail-row d-flex justify-content-between py-2 border-bottom">
                    <span class="detail-label text-muted">Email:</span>
                    <span class="detail-value fw-bold text-dark">@ViewBag.Email</span>
                </div>
                <div class="detail-row d-flex justify-content-between py-2 border-bottom">
                    <span class="detail-label text-muted">Total:</span>
                    <span class="detail-value fw-bold text-success">₹@ViewBag.Amount @ViewBag.Currency</span>
                </div>
                <div class="detail-row d-flex justify-content-between py-2">
                    <span class="detail-label text-muted">Status:</span>
                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3">Pending Admin Review</span>
                </div>
            </div>

            <div class="row g-2">
                <div class="col-8">
                    <button class="btn btn-primary w-100 py-3 shadow-sm btn-pay fw-bold" id="payBtn" onclick="completePayment()">
                        <span>Proceed to Pay</span>
                        <i class="fas fa-lock ms-2"></i>
                    </button>
                </div>
                <div class="col-4">
                    <button class="btn btn-light w-100 py-3 btn-cancel fw-semibold border" onclick="cancelPayment()">Cancel</button>
                </div>
            </div>

            <div class="info-section mt-4 small text-secondary">
                <i class="fas fa-shield-alt text-success me-2 fs-6"></i>
                <strong>Notice:</strong> This is a secure dummy payment gateway. Your subscription request will be sent for instant admin approval.
            </div>
        </div>

        <div class="loading-spinner text-center py-4" id="loadingSpinner" style="display: none;">
            <div class="spinner-border text-success my-3" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <p class="text-success fw-bold m-0">Processing secure payment...</p>
        </div>

        <div class="success-message text-center py-4" id="successMessage" style="display: none;">
            <div class="text-success display-3 mb-3">
                <i class="fas fa-check-circle"></i>
            </div>
            <h4 class="fw-bold text-dark mb-2">Payment Submitted!</h4>
            <p class="text-secondary small">Your payment request has been submitted for admin verification. Redirecting...</p>
        </div>
    </div>

    <script>
        const email = '@ViewBag.Email';
        const name = '@ViewBag.Name';

        function completePayment() {
            document.getElementById('paymentForm').style.display = 'none';
            document.getElementById('loadingSpinner').style.display = 'block';

            const paymentData = {
                paymentMethod: 'Dummy Gateway'
            };

            fetch('/Payment/ProcessPayment', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(paymentData)
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    document.getElementById('loadingSpinner').style.display = 'none';
                    document.getElementById('successMessage').style.display = 'block';

                    setTimeout(function() {
                        window.location.href = data.redirectUrl;
                    }, 2500);
                } else {
                    document.getElementById('loadingSpinner').style.display = 'none';
                    document.getElementById('paymentForm').style.display = 'block';
                    showError(data.message || 'Payment processing failed');
                }
            })
            .catch(error => {
                console.error('Error:', error);
                document.getElementById('loadingSpinner').style.display = 'none';
                document.getElementById('paymentForm').style.display = 'block';
                showError('An error occurred during payment processing');
            });
        }

        function showError(message) {
            const errorAlert = document.getElementById('errorAlert');
            errorAlert.textContent = message;
            errorAlert.style.display = 'block';
        }

        function cancelPayment() {
            if (confirm('Are you sure you want to cancel the payment?')) {
                window.history.back();
            }
        }
    </script>
</body>
</html>
