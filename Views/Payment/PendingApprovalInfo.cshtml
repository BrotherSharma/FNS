@{
    ViewData["Title"] = "Payment Pending - NutrInfo FNS";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="/Logo/cp.png" />
    <title>Payment Pending - NutrInfo FNS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/fns-ui.css" rel="stylesheet" />
</head>
<body class="fns-status-shell">
    <div class="container" style="max-width: 580px;">
        <div class="text-center mb-4">
            <div class="d-inline-flex align-items-center justify-content-center rounded-circle p-3 mb-3" style="width: 72px; height: 72px; background: rgba(13, 148, 136, 0.15); border: 2px solid rgba(13, 148, 136, 0.3);">
                <i class="fas fa-hourglass-half fs-2 text-teal" style="color: #0d9488;"></i>
            </div>
            <h3 class="fw-bold m-0" style="font-family: 'Outfit', sans-serif;">Payment Verification in Progress</h3>
            <p class="text-secondary small mt-1">Thank you! Your transaction is currently awaiting administrator review.</p>
        </div>

        <div class="info-box mb-4">
            <h6 class="fw-bold text-dark mb-3"><i class="fas fa-receipt text-success me-2"></i>Summary Information</h6>
            <div class="d-flex justify-content-between py-1 small border-bottom">
                <span class="text-muted">Verification Code:</span>
                <span class="fw-semibold font-monospace text-dark">#FNS-PENDING-REG</span>
            </div>
            <div class="d-flex justify-content-between py-1 small border-bottom">
                <span class="text-muted">Estimated Wait Time:</span>
                <span class="fw-semibold text-dark">Under 2 hours</span>
            </div>
            <div class="d-flex justify-content-between py-1 small pt-2">
                <span class="text-muted">Account Status:</span>
                <span class="badge bg-warning-subtle text-warning border rounded-pill px-3">Pending Admin Sign-Off</span>
            </div>
        </div>

        <div class="d-grid gap-2 d-sm-flex justify-content-center">
            <button onclick="window.location.reload();" class="btn btn-primary px-4 py-2 fw-semibold">
                <i class="fas fa-redo-alt me-2"></i> Refresh Status
            </button>
            <a href="/User/Login" class="btn btn-secondary px-4 py-2 fw-semibold">
                <i class="fas fa-arrow-left me-2"></i> Return to Login
            </a>
        </div>
    </div>
</body>
</html>
