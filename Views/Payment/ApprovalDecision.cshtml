@{
    ViewData["Title"] = "Approval Decision - NutrInfo FNS";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="/Logo/cp.png" />
    <title>Approval Decision - NutrInfo FNS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="/css/fns-ui.css" rel="stylesheet" />
</head>
<body class="fns-status-shell">
    <div class="container text-center" style="max-width: 540px;">
        @if (ViewBag.Status == "Approved")
        {
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-success-subtle rounded-circle p-4 mb-3" style="width: 88px; height: 88px; background: rgba(16, 185, 129, 0.15); border: 2px solid rgba(16, 185, 129, 0.3);">
                    <i class="fas fa-check-circle fs-1 text-success"></i>
                </div>
                <h2 class="fw-bold text-success mb-2" style="font-family: 'Outfit', sans-serif;">Account Approved!</h2>
                <p class="text-secondary">Great news! Your payment has been verified and your NutrInfo subscription is now active.</p>
            </div>

            <div class="info-box text-start mb-4">
                <div class="d-flex justify-content-between py-2 border-bottom">
                    <span class="text-muted small">Access Level:</span>
                    <span class="fw-bold text-success small">Full Premium Access</span>
                </div>
                <div class="d-flex justify-content-between py-2">
                    <span class="text-muted small">Verification Date:</span>
                    <span class="fw-semibold text-dark small">@DateTime.Now.ToString("MMM dd, yyyy")</span>
                </div>
            </div>

            <div class="d-grid">
                <a href="/Home/Index" class="btn btn-primary py-3 fw-bold fs-6 shadow">
                    <span>Enter Dashboard</span>
                    <i class="fas fa-arrow-right ms-2"></i>
                </a>
            </div>
        }
        else
        {
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center bg-danger-subtle rounded-circle p-4 mb-3" style="width: 88px; height: 88px; background: rgba(239, 68, 68, 0.15); border: 2px solid rgba(239, 68, 68, 0.3);">
                    <i class="fas fa-times-circle fs-1 text-danger"></i>
                </div>
                <h2 class="fw-bold text-danger mb-2" style="font-family: 'Outfit', sans-serif;">Approval Declined</h2>
                <p class="text-secondary">Unfortunately, your payment verification could not be completed at this time.</p>
            </div>

            <div class="reason-box text-start mb-4 border-left-danger" style="border-left: 5px solid #ef4444;">
                <h6 class="fw-bold text-danger mb-1"><i class="fas fa-exclamation-triangle me-2"></i>Reason</h6>
                <p class="small text-secondary m-0">@(ViewBag.Reason ?? "Payment credentials could not be verified. Please retry or contact support.")</p>
            </div>

            <div class="d-grid gap-2 d-sm-flex justify-content-center">
                <a href="/Payment/Payment" class="btn btn-primary px-4 py-2 fw-semibold">
                    <i class="fas fa-redo me-2"></i> Retry Payment
                </a>
                <a href="/User/Login" class="btn btn-secondary px-4 py-2 fw-semibold">
                    <i class="fas fa-sign-out-alt me-2"></i> Sign Out
                </a>
            </div>
        }
    </div>
</body>
</html>
