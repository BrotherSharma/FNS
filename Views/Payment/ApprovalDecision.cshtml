@{
    ViewData["Title"] = "Approval Decision - ReserveEase";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="/Logo/cp.png" />
    <title>Approval Decision - ReserveEase</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            width: 100%;
            max-width: 500px;
            padding: 40px 30px;
            text-align: center;
        }

        .approved .icon {
            font-size: 4rem;
            color: #28a745;
            margin-bottom: 20px;
        }

        .rejected .icon {
            font-size: 4rem;
            color: #dc3545;
            margin-bottom: 20px;
        }

        h1 {
            color: #333;
            font-size: 1.8rem;
            margin-bottom: 15px;
        }

        .approved h1 {
            color: #28a745;
        }

        .rejected h1 {
            color: #dc3545;
        }

        p {
            color: #666;
            font-size: 1rem;
            line-height: 1.6;
            margin-bottom: 10px;
        }

        .details {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 10px;
            margin: 25px 0;
            text-align: left;
        }

        .detail-row {
            display: flex;
            justify-content: space-between;
            margin-bottom: 10px;
            font-size: 0.9rem;
        }

        .detail-row:last-child {
            margin-bottom: 0;
        }

        .detail-label {
            color: #666;
        }

        .detail-value {
            font-weight: 600;
            color: #333;
        }

        .info-message {
            background: #e8f4f8;
            border-left: 4px solid #667eea;
            padding: 15px;
            border-radius: 8px;
            margin: 25px 0;
            text-align: left;
            color: #555;
            font-size: 0.9rem;
            line-height: 1.5;
        }

        .button-group {
            margin-top: 30px;
        }

        button {
            padding: 12px 30px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .approved button {
            background: linear-gradient(135deg, #28a745 0%, #20c997 100%);
            color: white;
        }

        .approved button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(40, 167, 69, 0.4);
        }

        .rejected button {
            background: linear-gradient(135deg, #dc3545 0%, #fd7e14 100%);
            color: white;
        }

        .rejected button:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(220, 53, 69, 0.4);
        }
    </style>
</head>
<body>
    <div class="container @ViewBag.Status.ToLower()">
        @if (ViewBag.Status == "Approved")
        {
            <div class="icon">✓</div>
            <h1>Payment Approved!</h1>
            <p>Your request has been approved by the admin.</p>

            <div class="details">
                <div class="detail-row">
                    <span class="detail-label">Order ID:</span>
                    <span class="detail-value">@ViewBag.OrderId</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">User Email:</span>
                    <span class="detail-value">@ViewBag.UserEmail</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status:</span>
                    <span class="detail-value" style="color: #28a745;">Approved</span>
                </div>
            </div>

            <div class="info-message">
                <strong>✓ Access Granted</strong><br/>
                The user has been notified via email and can now access the ReserveEase application.
            </div>

            <div class="button-group">
                <button onclick="window.location.href = '/Home/Index'">Go to Dashboard</button>
            </div>
        }
        else
        {
            <div class="icon">✗</div>
            <h1>Payment Rejected</h1>
            <p>The payment request has been rejected.</p>

            <div class="details">
                <div class="detail-row">
                    <span class="detail-label">Order ID:</span>
                    <span class="detail-value">@ViewBag.OrderId</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">User Email:</span>
                    <span class="detail-value">@ViewBag.UserEmail</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Status:</span>
                    <span class="detail-value" style="color: #dc3545;">Rejected</span>
                </div>
            </div>

            <div class="info-message">
                <strong>✗ Request Rejected</strong><br/>
                The user has been notified about the rejection.
            </div>

            <div class="button-group">
                <button onclick="window.location.href = '/'">Back to Home</button>
            </div>
        }
    </div>
</body>
</html>
