@{
    ViewData["Title"] = "Access Denied - ReserveEase";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="shortcut icon" href="/Logo/cp.png" />
    <title>Access Denied - ReserveEase</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            width: 100%;
            height: 100%;
        }

        body {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            padding: 20px;
        }

        .container {
            background: white;
            border-radius: 15px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
            width: 100%;
            max-width: 550px;
            padding: 45px 35px;
            text-align: center;
        }

        .icon {
            font-size: 4rem;
            color: #dc3545;
            margin-bottom: 20px;
        }

        h1 {
            color: #dc3545;
            font-size: 1.8rem;
            margin-bottom: 10px;
            font-weight: 700;
        }

        .subtitle {
            color: #666;
            font-size: 0.95rem;
            margin-bottom: 20px;
        }

        .info-box {
            background: #fee;
            border-left: 4px solid #dc3545;
            padding: 20px;
            border-radius: 8px;
            margin: 30px 0;
            text-align: left;
            color: #721c24;
            font-size: 0.9rem;
            line-height: 1.6;
        }

        .info-box strong {
            color: #721c24;
            display: block;
            margin-bottom: 8px;
        }

        .reason-box {
            background: #f8f9fa;
            padding: 20px;
            border-radius: 8px;
            margin: 25px 0;
            text-align: left;
            border: 1px solid #dee2e6;
        }

        .reason-title {
            font-size: 0.9rem;
            font-weight: 600;
            color: #333;
            margin-bottom: 10px;
        }

        .reason-content {
            font-size: 0.85rem;
            color: #666;
            line-height: 1.5;
        }

        .next-steps {
            background: #e8f4f8;
            border-left: 4px solid #667eea;
            padding: 20px;
            border-radius: 8px;
            margin: 25px 0;
            text-align: left;
            color: #555;
            font-size: 0.9rem;
        }

        .next-steps strong {
            display: block;
            margin-bottom: 10px;
            color: #333;
        }

        .step-item {
            margin-bottom: 8px;
            padding-left: 20px;
            position: relative;
        }

        .step-item:last-child {
            margin-bottom: 0;
        }

        .step-item::before {
            content: "→";
            position: absolute;
            left: 0;
            color: #667eea;
            font-weight: 600;
        }

        .button-group {
            margin-top: 35px;
            display: flex;
            gap: 10px;
        }

        button {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(102, 126, 234, 0.4);
        }

        .btn-secondary {
            background: #f0f0f0;
            color: #333;
            border: 1.5px solid #ddd;
        }

        .btn-secondary:hover {
            background: #e9e9e9;
        }

        .contact-section {
            background: #f8f9fa;
            padding: 15px;
            border-radius: 8px;
            margin: 20px 0;
            font-size: 0.9rem;
            color: #666;
        }

        .contact-section strong {
            color: #333;
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="icon">✗</div>
        <h1>Access Denied</h1>
        <p class="subtitle">Your payment request has been rejected</p>

        <div class="info-box">
            <strong>❌ Request Rejected</strong>
            <p>Unfortunately, your payment request was not approved by the administrator. You cannot access the ReserveEase application at this time.</p>
        </div>

        <div class="reason-box">
            <div class="reason-title">📋 Rejection Details</div>
            <div class="reason-content">
                Your request was reviewed and did not meet our requirements. For specific details about the rejection reason, please contact our support team.
            </div>
        </div>

        <div class="next-steps">
            <strong>📌 What you can do:</strong>
            <div class="step-item">Contact support for more information</div>
            <div class="step-item">Request a review of your application</div>
            <div class="step-item">Try registering with different information</div>
        </div>

        <div class="contact-section">
            <strong>📧 Need Help?</strong><br/>
            If you believe this is a mistake, please reach out to us at support@reserveease.com
        </div>

        <div class="button-group">
            <button class="btn-primary" onclick="window.location.href = '/'">Home</button>
            <button class="btn-secondary" onclick="window.location.href = '/User/Logout'">Logout</button>
        </div>
    </div>
</body>
</html>
