                            <div class="referral-step-arrow"><i class="fas fa-chevron-right"></i></div>
                            <div class="referral-step">
                                <div class="referral-step-num">3</div>
                                <span>You earn 100 points</span>
                            </div>
                        </div>
                    </div>
                    <div class="referral-hero-right">
                        <div class="referral-trophy-icon">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <div class="referral-points-display">
                            <span class="referral-pts-number">100</span>
                            <span class="referral-pts-label">Points per referral</span>
                        </div>
                    </div>
                </div>

                <!-- Invite Form Card -->
                <div class="referral-invite-card">
                    <div class="referral-invite-header">
                        <div class="referral-invite-icon">
                            <i class="fas fa-envelope-open-text"></i>
                        </div>
                        <div>
                            <h4 class="referral-invite-title">Send an Invitation</h4>
                            <p class="referral-invite-sub">Your friend will receive a personalised invite email from you.</p>
                        </div>
                    </div>
                    <div class="referral-form-row">
                        <div class="referral-input-wrap">
                            <i class="fas fa-envelope referral-input-icon"></i>
                            <input type="email" id="referralEmailInput" class="referral-email-input" placeholder="Enter friend's email address">
                        </div>
                        <button type="button" class="btn-referral-send" onclick="sendReferralInvite()">
                            <i class="fas fa-paper-plane"></i> Send Invite
                        </button>
                    </div>
                    <p class="referral-privacy-note"><i class="fas fa-lock"></i> We'll never share your friend's email with third parties.</p>
                </div>
            </div>

            <!-- Edit Profile Form (Initially Hidden) -->
            <div id="editProfileForm" class="edit-profile-box" style="display: none;">
                <h3>Edit Your Profile</h3>
                <form onsubmit="event.preventDefault(); saveProfileChanges();" class="edit-profile-form" style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;">
                    <div class="form-field">
                        <label for="editFirstName">First Name</label>
                        <input type="text" id="editFirstName" value="@FirstName" required>
                    </div>
                    <div class="form-field">
                        <label for="editLastName">Last Name</label>
                        <input type="text" id="editLastName" value="@LastName" required>
                    </div>
                    <div class="form-field full-width">
                        <label for="editGoal">Goal</label>
                        <select id="editGoal" required style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-card); font-size: 15px; color: var(--text-main); font-weight: 500;">
                            <option value="Weight Loss">Weight Loss</option>
                            <option value="Maintain">Maintain</option>
                            <option value="Gain">Weight Gain</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="editWeight">Weight (kg)</label>
                        <input type="number" step="0.1" id="editWeight">
                    </div>
                    <div class="form-field">
                        <label for="editHeight">Height (cm)</label>
                        <input type="number" step="0.1" id="editHeight">
                    </div>
                    <div class="form-field">
                        <label for="editDiet">Diet Preference</label>
                        <select id="editDiet" style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-card); font-size: 15px; color: var(--text-main); font-weight: 500;">
                            <option value="">Select Diet</option>
                            <option value="Veg">Vegetarian</option>
                            <option value="Non-Veg">Non-Vegetarian</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="editLifestyle">Lifestyle</label>
                        <select id="editLifestyle" style="width: 100%; padding: 12px 14px; border-radius: 8px; border: 1px solid var(--border-color); background: var(--bg-card); font-size: 15px; color: var(--text-main); font-weight: 500;">
                            <option value="">Select Lifestyle</option>
                            <option value="Sedentary">Sedentary</option>
                            <option value="Active">Active</option>
                            <option value="Hyperactive">Hyperactive</option>
                        </select>
                    </div>
                    <div class="form-field">
                        <label for="editSleep">Sleep (hours)</label>
                        <input type="number" step="0.5" id="editSleep">
                    </div>
                    <div class="form-field full-width">
                        <button type="submit" class="btn-save-changes">Save Changes</button>
                    </div>
                </form>
            </div>
        </div>

    </div>

    <!-- SweetAlert and JS scripts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
    <script>
        const Email = '@Email';
        const Name = '@Name';
        window.Email = Email;
        window.Name = Name;
        window.FNSUserName = Name || 'Member';
        window.FNSUserEmail = Email || 'guest@example.com';
        window.FNSUserDiet = 'Non-Veg';
        window.FNSUserGender = 'all';
        window.FNSUserLogoUrl = '@Url.Content("~/Logo/logo1.png")';

        // Go Premium function
        window.upgradeToPremium = async function () {
            try {
                // Show loading state
                Swal.fire({
                    title: 'Upgrading to Premium...',
                    text: 'Please wait while we unlock your features.',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                const resp = await fetch('/User/UpgradeUser', { method: 'POST' });
                const data = await resp.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Welcome to Premium! 👑',
                        text: 'Your new features have been unlocked.',
                        confirmButtonColor: '#0f4c3a'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Upgrade Failed', text: data.message });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Network Error', text: 'Could not reach the server.' });
            }
        };

        // Global function - defined outside DOMContentLoaded so inline onclick handlers can access it immediately
        function switchSection(sectionId) {
            document.querySelectorAll('.page-section').forEach(sec => sec.classList.remove('active'));
            document.querySelectorAll('.sidebar .nav-link').forEach(link => link.classList.remove('active'));
            
            const activeSection = document.getElementById(sectionId);
            if (activeSection) activeSection.classList.add('active');
            
            const activeLink = document.querySelector(`.sidebar [data-section="${sectionId}"]`);
            if (activeLink) activeLink.classList.add('active');
            
            if (sectionId === 'todayChecklist' && typeof loadChecklist === 'function') loadChecklist();
            if (sectionId === 'moodTracker' && typeof loadMood === 'function') loadMood();
        }

        document.addEventListener("DOMContentLoaded", async () => {
                window.FNSUserName = '@Name';
                window.FNSUserEmail = '@Email';
            // Set today's date in Daily Summary section
            const todayDateElement = document.getElementById('todayDate');
            const todayDayNameElement = document.getElementById('todayDayName');
            const today = new Date();
            
            if (todayDayNameElement) {
                todayDayNameElement.textContent = today.toLocaleDateString('en-US', { weekday: 'long' });
            }
            if (todayDateElement) {
                todayDateElement.textContent = today.toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                });
            }

            // Local hydration log support for seamless experience
            const todayStr = today.toDateString();
            window.addWaterLocally = function () {
                let localWater = parseFloat(localStorage.getItem('localWater_' + todayStr)) || 0;
                localWater += 0.25;
                localStorage.setItem('localWater_' + todayStr, localWater);
                Swal.fire({
                    icon: 'success',
                    title: 'Hydrated!',
                    text: '+0.25 L added!',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 1500
                });
                loadDailyNutrition();
            };

            // Referral trigger — sends a real email via backend
            window.sendReferralInvite = async function () {
                const input = document.getElementById('referralEmailInput');
                const friendEmail = input ? input.value.trim() : '';
                if (!friendEmail) {
                    Swal.fire({ icon: 'info', title: 'Email Required', text: 'Please enter your friend\'s email address.' });
                    return;
                }

                // Show loading state
                const btn = document.querySelector('.btn-referral-send');
                const originalHtml = btn ? btn.innerHTML : '';
                if (btn) { btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...'; btn.disabled = true; }

                try {
                    const resp = await fetch('/User/SendReferralInvite', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ friendEmail })
                    });
                    const data = await resp.json();

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Invitation Sent! 🎉',
                            text: `A personalised invite email has been sent to ${friendEmail}.`,
                            confirmButtonColor: '#0f4c3a'
                        });
                        if (input) input.value = '';
                    } else {
                        Swal.fire({ icon: 'error', title: 'Could Not Send', text: data.message || 'Something went wrong.', confirmButtonColor: '#0f4c3a' });
                    }
                } catch (err) {
                    Swal.fire({ icon: 'error', title: 'Network Error', text: 'Could not reach the server. Please try again.', confirmButtonColor: '#0f4c3a' });
                } finally {
                    if (btn) { btn.innerHTML = originalHtml; btn.disabled = false; }
                }
            };

            // Update stats cards
            async function updateDashboardStats() {
                try {
                    const resp = await fetch(`/api/nutrition/daily?email=${encodeURIComponent(Email)}`);
                    if (resp.ok) {
                        const data = await resp.json();
                        document.getElementById('dashboardCalories').textContent = data.calories ?? 0;
                    }
                } catch (err) { console.error('Failed to update stats', err); }
            }

            // Checklist functions (unchanged placeholder)
            const checklistDateInput = document.getElementById('checklistDate');
            const checklistTableBody = document.getElementById('checklistTableBody');

            function toDateInputValue(date) {
                const offsetDate = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
                return offsetDate.toISOString().split('T')[0];
            }

            function renderChecklist(items) {
                if (!checklistTableBody) return;
                checklistTableBody.innerHTML = '';
                if (items.length === 0) {
                    checklistTableBody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No checklist tasks.</td></tr>';
                    return;
                }
                // existing rendering logic continues...
            }

            window.openProfileImageZoom = function () {
                const overlay = document.getElementById('profileImageZoomOverlay');
                const zoomImage = document.getElementById('profileImageZoomContent');
                const avatar = document.getElementById('profileAvatarImage');
                if (!overlay || !zoomImage || !avatar) return;

                zoomImage.src = avatar.src;
                overlay.classList.add('active');
                document.body.style.overflow = 'hidden';
            };

            window.closeProfileImageZoom = function () {
                const overlay = document.getElementById('profileImageZoomOverlay');
                if (!overlay) return;
                overlay.classList.remove('active');
                document.body.style.overflow = '';
            };

            document.addEventListener('keydown', function (event) {
                if (event.key === 'Escape') {
                    closeProfileImageZoom();
                }
            });

            // --- New Functions for Profile Image Options ---
            window.showProfileImageOptions = function() {
                Swal.fire({
                    title: 'Profile Photo',
                    text: 'Choose an action',
                    showConfirmButton: true,
                    showDenyButton: true,
                    confirmButtonText: 'Edit Photo',
                    denyButtonText: 'Remove Photo',
                    icon: 'question'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // trigger hidden file input
                        document.getElementById('profileImageInput').click();
                    } else if (result.isDenied) {
                        removeProfileImage();
                    }
                });
            };

            window.removeProfileImage = function() {
                const email = '@Email';
                const formData = new FormData();
                formData.append('email', email);
                fetch('/User/RemoveProfileImage', {
                    method: 'POST',
                    body: formData
                })
                .then(resp => resp.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire('Removed', 'Profile image removed.', 'success');
                        // reset avatar to default
                        const avatar = document.getElementById('profileAvatarImage');
                        if (avatar) avatar.src = '@DefaultAvatarSrc';
                    } else {
                        Swal.fire('Error', data.message || 'Failed to remove image.', 'error');
                    }
                })
                .catch(err => {
                    Swal.fire('Error', err.message || 'Error removing image.', 'error');
                });
            };

            // Initialize any needed functions
            // (you may call updateDashboardStats() etc. as before)

            async function loadChecklist() {
                if (!checklistDateInput || !checklistTableBody) return;
                checklistTableBody.innerHTML = '<tr><td colspan="3" class="text-center">Loading checklist...</td></tr>';
                try {
                    const resp = await fetch(`/api/nutrition/checklist?email=${encodeURIComponent(Email)}&date=${encodeURIComponent(checklistDateInput.value)}`);
                    if (!resp.ok) throw new Error('Failed to load checklist');
                    const data = await resp.json();
                    renderChecklist(data.items || []);
                } catch (err) {
                    console.error('Failed to load checklist', err);
                    checklistTableBody.innerHTML = '<tr><td colspan="3" class="text-center text-danger">Could not load checklist.</td></tr>';
                }
            }

            async function saveChecklist() {
                const items = Array.from(document.querySelectorAll('.checklist-toggle')).map(input => ({
                    taskKey: input.dataset.taskKey,
                    taskLabel: input.dataset.taskLabel,
                    isCompleted: input.checked
                }));

                try {
                    const resp = await fetch('/api/nutrition/checklist', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            email: Email,
                            checklistDate: checklistDateInput.value,
                            items
                        })
                    });
                    if (!resp.ok) throw new Error('Failed to save checklist');
                } catch (err) {
                    console.error('Failed to save checklist', err);
                    Swal.fire({ icon: 'error', title: 'Checklist Error', text: 'Could not save checklist.' });
                }
            }

            if (checklistDateInput) {
                checklistDateInput.value = toDateInputValue(new Date());
                checklistDateInput.addEventListener('change', loadChecklist);
            }

            if (checklistTableBody) {
                checklistTableBody.addEventListener('change', async event => {
                    if (!event.target.classList.contains('checklist-toggle')) return;
                    const row = event.target.closest('tr');
                    const badge = row?.querySelector('.badge');
                    if (badge) {
                        badge.textContent = event.target.checked ? 'Completed' : 'Pending';
                        badge.className = event.target.checked ? 'badge bg-success' : 'badge bg-warning text-dark';
                    }
                    await saveChecklist();
                });
            }

            // Mood Tracker hooks
            const moodDateInput = document.getElementById('moodDate');
            const moodReasonInput = document.getElementById('moodReason');
            let currentMood = '';

            const moodEmojis = {
                "Happy": "😊", "Neutral": "😐", "Sad": "😢",
                "Excited": "🤩", "Tired": "😴", "Angry": "😠"
            };

            function renderMood(mood, reason = '') {
                const moodDisplay = document.getElementById('selectedMood');
                const icons = document.querySelectorAll('.mood-tracker i');
                
                icons.forEach(icon => {
                    icon.style.color = '#9ca3af';
                    icon.style.transform = 'none';
                });
                
                currentMood = mood || '';
                if (moodReasonInput) moodReasonInput.value = reason || '';

                if (!mood) {
                    if (moodDisplay) moodDisplay.textContent = 'How was your day? Log it below.';
                    return;
                }

                const matchingIcon = Array.from(icons).find(el => el.title === mood);
                if (matchingIcon) {
                    matchingIcon.style.color = 'var(--primary)';
                    matchingIcon.style.transform = 'scale(1.25)';
                }

                const emoji = moodEmojis[mood] || "";
                if (moodDisplay) {
                    moodDisplay.textContent = `Eaten & Evolving: ${emoji} You felt ${mood} today.`;
                }
            }

            async function loadMood() {
                if (!moodDateInput) return;
                try {
                    const resp = await fetch(`/api/nutrition/mood?email=${encodeURIComponent(Email)}&date=${encodeURIComponent(moodDateInput.value)}`);
                    if (!resp.ok) throw new Error('Failed to load mood');
                    const data = await resp.json();
                    renderMood(data.mood || '', data.reason || '');
                } catch (err) { console.error('Failed to load mood', err); }
            }

            async function saveMood(mood) {
                const reason = moodReasonInput ? moodReasonInput.value.trim() : '';
                try {
                    const resp = await fetch('/api/nutrition/mood', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            email: Email,
                            moodDate: moodDateInput.value,
                            mood,
                            reason
                        })
                    });
                    if (!resp.ok) throw new Error('Failed to save mood');
                } catch (err) {
                    console.error('Failed to save mood', err);
                    Swal.fire({ icon: 'error', title: 'Mood Error', text: 'Could not save mood.' });
                }
            }

            window.saveCurrentMoodReason = async function () {
                if (!currentMood) {
                    Swal.fire({ icon: 'info', title: 'Select Mood', text: 'Please tap a mood emoji first.' });
                    return;
                }
                await saveMood(currentMood);
                Swal.fire({ icon: 'success', title: 'Saved Note', toast: true, position: 'top-end', showConfirmButton: false, timer: 1500 });
            };

            window.selectMood = function (mood) {
                renderMood(mood);
                saveMood(mood);
            };

            if (moodDateInput) {
                moodDateInput.value = toDateInputValue(new Date());
                moodDateInput.addEventListener('change', loadMood);
            }

            // Exercise configuration
            const exercisePlans = {
                loss: {
                    title: 'Weight Loss',
                    image: '/excersize/weight-loss.svg',
                    summary: 'Preserve lean mass and maximize the calorie deficit with dynamic cardio intervals paired with progressive resistance training.',
                    planDuration: '4 Weeks',
                    sessionsPerWeek: '6 Training + 1 Mobility',
                    focus: 'Strength & Recovery',
                    dailyTarget: '1,670 kcal',
                    items: [
                        { title: 'Brisk Walk Intervals', image: '/excersize/weight-loss.svg', text: 'Alternate 3 minutes brisk walking with 1 minute easy walking for 30 minutes.', tags: ['Cardio', '4x/week', 'Beginner'] },
                        { title: 'Full Body Circuit', image: '/excersize/weight-loss.svg', text: 'Perform squats, push-ups, and step-ups in quick rounds with steady rest.', tags: ['Strength', '3x/week', 'Moderate'] }
                    ],
