                        { title: '20 Minute Fat Burning HIIT', channel: 'AI Motion Coach', duration: '20 min', accent: '#f97316', note: 'High-energy cardio with guided intervals.', related: ['Jump Squats', 'Mountain Climbers', 'Burpees'], supplements: ['Whey Protein', 'BCAA', 'Electrolyte Mix'] },
                        { title: 'Full Body Weight Loss Workout', channel: 'AI Motion Coach', duration: '30 min', accent: '#10b981', note: 'Balanced strength and mobility flow.', related: ['Kettlebell Swings', 'Push-Up Variations', 'Walking Lunges'], supplements: ['Lean Protein Isolate', 'Omega-3s', 'Green Superfood'], products: ['Adjustable Dumbbells', 'Resistance Bands', 'Gym Towel'] },
                        { title: 'Beginner Cardio for Fat Loss', channel: 'AI Motion Coach', duration: '25 min', accent: '#3b82f6', note: 'Gentle pacing with steady tempo cues.', related: ['Walking Intervals', 'Stationary Bike', 'Jump Rope'], supplements: ['Pre-Workout Energy', 'Protein Bars', 'Recovery Gummies'] },
