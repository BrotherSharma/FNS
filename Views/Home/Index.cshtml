            function escapeHtml(value) {
                return (value || '').replace(/[&<>"']/g, char => ({
                    '&': '&amp;',
                    '<': '&lt;',
                    '>': '&gt;',
                    '"': '&quot;',
                    "'": '&#39;'
                }[char]));
            }

            function formatCoachRecommendation(text) {
                const sectionLabels = ['Avoid', 'Recommended', 'Mini Plan', 'Nutrition Tip'];
                const cleaned = (text || '')
                    .replace(/\*\*/g, '')
                    .replace(/\r/g, '')
                    .replace(/\s+(Avoid|Recommended|Mini Plan|Nutrition Tip):/g, '\n$1:')
                    .trim();

                if (!cleaned) return '<p style="margin:0;">No recommendation returned. Try adding more details.</p>';

                const sections = [];
                const pattern = /(Avoid|Recommended|Mini Plan|Nutrition Tip):([\s\S]*?)(?=\n(?:Avoid|Recommended|Mini Plan|Nutrition Tip):|$)/g;
                let match;
                while ((match = pattern.exec(cleaned)) !== null) {
                    const title = match[1];
                    const body = match[2].trim();
                    if (!body) continue;
                    const bullets = body
                        .split(/\n+|(?<=\.)\s+(?=[A-Z0-9-])/)
                        .map(line => line.replace(/^[-\d.]+\s*/, '').trim())
                        .filter(Boolean)
                        .slice(0, 5);

                    sections.push(`
                        <div style="padding: 12px 0; border-top: 1px solid var(--border-color);">
                            <h4 style="font-size: 14px; color: var(--text-main); font-weight: 800; margin: 0 0 8px;">${escapeHtml(title)}</h4>
                            <ul style="padding-left: 18px; margin: 0; color: var(--text-muted); font-size: 13px; line-height: 1.55;">
                                ${bullets.map(item => `<li style="margin-bottom: 5px;">${escapeHtml(item)}</li>`).join('')}
                            </ul>
                        </div>
                    `);
                }

                if (sections.length > 0) return sections.join('');

                return `<p style="white-space: pre-line; margin: 0; color: var(--text-muted);">${escapeHtml(cleaned)}</p>`;
            }

            function renderExerciseLibrary() {
                const search = (document.getElementById('exerciseSearch')?.value || '').toLowerCase();
                const filter = document.getElementById('exerciseFilter')?.value || 'all';
                const box = document.getElementById('exerciseLibrary');
                if (!box) return;
                const filtered = exerciseLibraryItems.filter(item => {
                    const matchesSearch = item.name.toLowerCase().includes(search) || item.muscle.toLowerCase().includes(search);
                    const matchesFilter = filter === 'all' || [item.level, item.place, item.muscle].includes(filter);
                    return matchesSearch && matchesFilter;
                });
                box.innerHTML = filtered.map(item => `
                    <div class="grid-card" style="min-height:auto; padding:16px;">
                        <img src="${item.media}" alt="${item.name}" style="height:82px; width:100%; object-fit:contain; margin-bottom:8px;">
                        <h4 style="font-size:15px; font-weight:700; margin:0 0 4px;">${item.name}</h4>
                        <p style="font-size:12px; color:var(--text-muted); margin:0 0 8px;">${item.level} · ${item.place} · ${item.muscle} · ${item.kcal} kcal/min</p>
                        <ol style="font-size:12px; color:var(--text-muted); padding-left:18px; margin-bottom:8px;">${item.steps.map(s => `<li>${s}</li>`).join('')}</ol>
