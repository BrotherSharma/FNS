            function renderWorkoutCalendar() {
                const cal = document.getElementById('workoutCalendar');
                if (!cal) return;
                const now = new Date();
                const daysInMonth = new Date(now.getFullYear(), now.getMonth() + 1, 0).getDate();
                let completed = 0;
                cal.innerHTML = '';
                for (let day = 1; day <= daysInMonth; day++) {
                    const key = `${now.getFullYear()}-${now.getMonth() + 1}-${day}`;
                    const done = !!exerciseState.completed[key];
                    if (done) completed++;
                    cal.insertAdjacentHTML('beforeend', `<button type="button" onclick="toggleWorkoutDay('${key}')" style="border:1px solid var(--border-color); border-radius:8px; min-height:34px; background:${done ? 'var(--primary-light)' : '#fff'}; color:${done ? 'var(--primary)' : 'var(--text-main)'}; font-weight:700;">${done ? '✓' : day}</button>`);
                }
                const summary = document.getElementById('workoutCalendarSummary');
                if (summary) summary.textContent = `Completed: ${completed}/${daysInMonth} workouts this month`;
                renderAchievements(completed);
            }

            window.toggleWorkoutDay = function (key) {
