@{
    ViewData["Title"] = "Home Page";
    string Name = ViewBag.Name;
    string Email = ViewBag.Email;
    string FirstName = ViewBag.FirstName ?? "User";
    string LastName = ViewBag.LastName ?? "";
    string ProfileImagePath = ViewBag.ProfileImagePath as string ?? string.Empty;
    string DefaultAvatarSrc = Url.Content("~/images/default-avatar.svg");
    string ProfileImageSrc = string.IsNullOrWhiteSpace(ProfileImagePath)
        ? DefaultAvatarSrc
        : ProfileImagePath;
    bool isPremium = Context.Session.GetString("IsPremium") == "True";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NutrInfo</title>
    
    <!-- Google Font & Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <link href="/css/dashboard-premium.css" rel="stylesheet" />
</head>
<body class="dashboard-shell">

    <!-- Sidebar Navigation -->
    <div class="sidebar">
        <div class="logo-container">
            <i class="fas fa-leaf logo-icon"></i>
            <div class="logo-text">
                <span class="logo-title">NutrInfo</span>
                <span class="logo-subtitle">FUEL YOUR BEST</span>
            </div>
        </div>
        
        <div class="sidebar-nav">
            <a href="#" class="nav-link active" data-section="dashboard" onclick="event.preventDefault(); switchSection('dashboard')">
                <i class="fas fa-th-large"></i> Dashboard
            </a>
            <a href="#" class="nav-link" data-section="dailySummary" onclick="event.preventDefault(); switchSection('dailySummary')">
                <i class="fas fa-chart-line"></i> Daily Summary
            </a>
            <a href="#" class="nav-link" data-section="todayGoal" onclick="event.preventDefault(); switchSection('todayGoal')">
                <i class="fas fa-bullseye"></i> Today's Goal
            </a>
            <a href="#" class="nav-link" data-section="exercise" onclick="event.preventDefault(); switchSection('exercise')">
                <i class="fas fa-dumbbell"></i> Exercise
            </a>
            <a href="#" class="nav-link" data-section="todayChecklist" onclick="event.preventDefault(); switchSection('todayChecklist')">
                <i class="fas fa-tasks"></i> Today's Checklist
            </a>
            <a href="#" class="nav-link" data-section="addFood" onclick="event.preventDefault(); switchSection('addFood')">
                <i class="fas fa-plus-circle"></i> Add Food
            </a>
            <a href="#" class="nav-link" data-section="notes" onclick="event.preventDefault(); switchSection('notes')">
                <i class="fas fa-sticky-note"></i> Notes
            </a>
            <a href="#" class="nav-link" data-section="quickStats" onclick="event.preventDefault(); switchSection('quickStats')">
                <i class="fas fa-bolt"></i> Quick Stats
            </a>
            <a href="#" class="nav-link" data-section="moodTracker" onclick="event.preventDefault(); switchSection('moodTracker')">
                <i class="fas fa-smile"></i> Mood Tracker
            </a>
            <a href="#" class="nav-link" data-section="suggestions" onclick="event.preventDefault(); switchSection('suggestions')">
                <i class="fas fa-lightbulb"></i> Suggestions
            </a>
            <a href="#" class="nav-link" data-section="progressCharts" onclick="event.preventDefault(); switchSection('progressCharts')">
                <i class="fas fa-chart-bar"></i> Progress Charts
            </a>
            <a href="#" class="nav-link" data-section="profile" onclick="event.preventDefault(); switchSection('profile')">
                <i class="fas fa-user"></i> Profile
            </a>
        </div>

        <div class="premium-card">
            <div class="premium-card-content">
                <h4>Go Premium</h4>
                <p>Unlock advanced insights and personalized tips.</p>
            </div>
            <button class="premium-card-action" onclick="event.preventDefault(); switchSection('profile')">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        
        <!-- Floating Header Widget -->
        <div class="top-header-widget">
            @if (!isPremium)
            {
                <a href="#" class="btn-go-premium header-premium-cta" onclick="event.preventDefault(); upgradeToPremium()">
                    <i class="fas fa-crown"></i> Go Premium
                </a>
            }
            <div class="notification-bell" onclick="alert('You are all caught up!')">
                <i class="far fa-bell"></i>
                <span class="notification-badge">2</span>
            </div>
            <div class="user-avatar-widget" onclick="switchSection('profile')">
                <span class="text-sm font-semibold" style="margin-right: 4px;">@FirstName</span>
                <img src="@ProfileImageSrc" class="user-avatar-img" alt="User profile" onerror="this.onerror=null;this.src='@DefaultAvatarSrc';">
            </div>
        </div>

        <!-- Dashboard Overview Section -->
        <div id="dashboard" class="page-section active">
            <div class="page-header-block">
                <h2>Dashboard Overview</h2>
                <p>Welcome back, @FirstName! Here's how your nutrition is shaping up.</p>
            </div>
            
            <div class="grid-card" style="min-height: auto; margin-bottom: 24px; padding: 28px;">
                <h3 style="font-size: 18px; font-weight: 700; color: var(--primary); margin: 0 0 12px 0;">Welcome to Your Nutrition Tracker</h3>
                <p style="color: var(--text-muted); line-height: 1.6; margin-bottom: 20px;">
                    Track your daily nutrition, log meals, count macros, and establish healthy habits. Select options from the left sidebar to access your profile:
                </p>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px;">
                    <div style="background-color: var(--bg-canvas); padding: 16px; border-radius: 12px; border: 1px solid var(--border-color);">
                        <strong style="color: var(--primary); display: block; margin-bottom: 4px;"><i class="fas fa-chart-line" style="margin-right: 6px;"></i> Daily Summary</strong>
                        <span style="font-size: 12px; color: var(--text-muted);">View calories, hydration, and daily macro progression.</span>
                    </div>
                    <div style="background-color: var(--bg-canvas); padding: 16px; border-radius: 12px; border: 1px solid var(--border-color);">
                        <strong style="color: var(--primary); display: block; margin-bottom: 4px;"><i class="fas fa-plus-circle" style="margin-right: 6px;"></i> Add Food</strong>
                        <span style="font-size: 12px; color: var(--text-muted);">Log your breakfast, lunch, dinner, or snacks.</span>
                    </div>
                    <div style="background-color: var(--bg-canvas); padding: 16px; border-radius: 12px; border: 1px solid var(--border-color);">
                        <strong style="color: var(--primary); display: block; margin-bottom: 4px;"><i class="fas fa-chart-bar" style="margin-right: 6px;"></i> Progress Charts</strong>
                        <span style="font-size: 12px; color: var(--text-muted);">Visualize caloric trends and macro breakdowns.</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Daily Summary Section -->
        <div id="dailySummary" class="page-section">
            <div class="page-header-block">
                <h2>Daily Summary</h2>
                <p>Here's how you're doing today. <i class="fas fa-heart footer-heart-icon"></i></p>
            </div>

            <!-- 4 Column Premium Cards Grid -->
            <div class="premium-card-grid">
                <!-- Date Card -->
                <div class="grid-card date-card">
                    <div class="card-title-row">
                        <h3>Date</h3>
                        <div class="card-icon-container green">
                            <i class="far fa-calendar-alt"></i>
                        </div>
                    </div>
                    <div class="date-card-content">
                        <div class="date-card-day" id="todayDayName">Monday</div>
                        <div class="date-card-full" id="todayDate">June 22, 2026</div>
                    </div>
                    <div class="hills-illustration"></div>
                </div>

                <!-- Calories Consumed Card -->
                <div class="grid-card">
                    <div class="card-title-row">
                        <h3>Calories Consumed</h3>
                        <div class="card-icon-container orange">
                            <i class="fas fa-fire"></i>
                        </div>
                    </div>
                    <div class="radial-progress-container">
                        <div class="radial-progress-circle" id="calorieProgressCircle" style="--progress: 0%;">
                            <div class="radial-progress-center">
                                <i class="fas fa-fire" style="font-size: 18px; color: #f87171; margin-bottom: 2px;"></i>
                                <span class="radial-progress-value" id="caloriesConsumed">0</span>
                                <span class="radial-progress-unit">kcal</span>
                            </div>
                        </div>
                        <span class="radial-progress-goal">of <span id="caloriesGoalText">2,000</span> kcal</span>
                    </div>
                </div>

                <!-- Macros Card -->
                <div class="grid-card">
                    <div class="card-title-row">
                        <h3>Macros</h3>
                        <div class="card-icon-container green">
                            <i class="fas fa-sliders-h"></i>
                        </div>
                    </div>
                    <div class="macro-progress-list">
                        <div class="macro-item">
                            <div class="macro-header">
                                <span class="macro-name">
                                    <span class="macro-bullet protein"></span>Protein
                                </span>
                                <span class="macro-value"><span id="proteinCount">0</span>g / <span id="macroProteinTarget">150g</span></span>
                            </div>
                            <div class="macro-track protein">
                                <div class="macro-fill protein" id="proteinBarFill"></div>
                            </div>
                        </div>
                        <div class="macro-item">
                            <div class="macro-header">
                                <span class="macro-name">
                                    <span class="macro-bullet carbs"></span>Carbs
                                </span>
                                <span class="macro-value"><span id="carbCount">0</span>g / <span id="macroCarbsTarget">250g</span></span>
                            </div>
                            <div class="macro-track carbs">
                                <div class="macro-fill carbs" id="carbsBarFill"></div>
                            </div>
                        </div>
                        <div class="macro-item">
                            <div class="macro-header">
                                <span class="macro-name">
                                    <span class="macro-bullet fat"></span>Fat
                                </span>
                                <span class="macro-value"><span id="fatCount">0</span>g / <span id="macroFatTarget">70g</span></span>
                            </div>
                            <div class="macro-track fat">
                                <div class="macro-fill fat" id="fatBarFill"></div>
                            </div>
                        </div>
                    </div>
                    <a href="#" onclick="event.preventDefault(); switchSection('progressCharts')" class="macro-footer-link">
                        View macro breakdown <i class="fas fa-chevron-right" style="font-size: 10px;"></i>
                    </a>
                </div>

                <!-- Hydration Card -->
                <div class="grid-card">
                    <div class="card-title-row">
                        <h3>Hydration</h3>
                        <div class="card-icon-container blue">
                            <i class="fas fa-tint"></i>
                        </div>
                    </div>
                    <div class="hydration-container">
                        <div class="hydration-value-row">
                            <span class="hydration-value"><span id="hydrationAmount">0</span> L</span>
                            <div class="hydration-goal">of 2.5 L goal</div>
                        </div>
                        <div class="glass-wrapper">
                            <div class="glass-outer">
                                <div class="glass-water" id="glassWaterFill"></div>
                            </div>
                            <div class="glass-markings">
                                <span>2.5 L</span>
                                <span>1.5 L</span>
                                <span>0.5 L</span>
                                <span>0 L</span>
                            </div>
                        </div>
                        <button type="button" class="btn-add-water" onclick="addWaterLocally()">+ Add Water</button>
                    </div>
                </div>
            </div>

            <!-- Streak Banner -->
            <div class="streak-banner">
                <div class="streak-banner-left">
                    <div class="streak-wreath-icon">
                        <i class="fas fa-fire"></i>
                    </div>
                    <div class="streak-text-block">
                        <h3>You're on fire!</h3>
                        <div class="streak-text-main"><span id="streakText">263-day</span> healthy streak</div>
                        <p class="streak-text-sub">Consistency today, a stronger you tomorrow.</p>
                    </div>
                </div>
                <button type="button" class="btn-keep-streak" onclick="alert('Keep it up!')">Keep it up! 💪</button>
            </div>

            <!-- Advice Bar Footer -->
            <div class="footer-advice-bar">
                <div class="footer-advice-left">
                    <i class="fas fa-leaf"></i>
                    <span>Small steps every day lead to big changes over time.</span>
                </div>
                <i class="fas fa-heart footer-heart-icon"></i>
            </div>
        </div>

        <!-- Today's Goal Section -->
        <div id="todayGoal" class="page-section">
            <div class="page-header-block">
                <h2>Today's Goal</h2>
                <p>Check your targets for the day.</p>
            </div>
            
            <div class="grid-card" style="min-height: auto;">
                <div class="card-title-row">
                    <h3>Your Daily Nutrition Targets</h3>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px; margin-bottom: 24px;">
                    <div style="background-color: var(--bg-canvas); padding: 20px; border-radius: 16px; border: 1px solid var(--border-color); text-align: center;">
                        <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 6px;">Calories</span>
                        <strong style="font-size: 24px; color: var(--primary);" id="goalCalories">2000</strong>
                        <span style="font-size: 12px; color: var(--text-muted); display: block; margin-top: 2px;">kcal</span>
                    </div>
                    <div style="background-color: var(--bg-canvas); padding: 20px; border-radius: 16px; border: 1px solid var(--border-color); text-align: center;">
                        <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 6px;">Protein</span>
                        <strong style="font-size: 24px; color: var(--primary);" id="goalProtein">100</strong>
                        <span style="font-size: 12px; color: var(--text-muted); display: block; margin-top: 2px;">g</span>
                    </div>
                    <div style="background-color: var(--bg-canvas); padding: 20px; border-radius: 16px; border: 1px solid var(--border-color); text-align: center;">
                        <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 6px;">Carbs</span>
                        <strong style="font-size: 24px; color: var(--primary);" id="goalCarbs">250</strong>
                        <span style="font-size: 12px; color: var(--text-muted); display: block; margin-top: 2px;">g</span>
                    </div>
                    <div style="background-color: var(--bg-canvas); padding: 20px; border-radius: 16px; border: 1px solid var(--border-color); text-align: center;">
                        <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 6px;">Fat</span>
                        <strong style="font-size: 24px; color: var(--primary);" id="goalFat">70</strong>
                        <span style="font-size: 12px; color: var(--text-muted); display: block; margin-top: 2px;">g</span>
                    </div>
                </div>
                <div style="background-color: var(--primary-light); color: var(--primary); padding: 16px; border-radius: 12px; font-weight: 600; font-size: 14px; text-align: center;" id="motd">
                    Message of the day: Keep going!
                </div>
            </div>
        </div>

        <!-- Exercise Section -->
        <div id="exercise" class="page-section">
            <div class="page-header-block">
                <h2>Exercise</h2>
                <p>Workouts matched to your goal.</p>
            </div>
                      <div class="grid-card @(isPremium ? "" : "premium-locked-section")" style="min-height: auto; margin-bottom: 24px;">
                @if (!isPremium)
                {
                    <div class="premium-locked-overlay">
                        <i class="fas fa-crown"></i>
                        <h3>Premium Feature</h3>
                        <p>Unlock curated workout videos tailored to your fitness goals.</p>
                        <button class="btn-go-premium" onclick="upgradeToPremium()">Upgrade Now</button>
                    </div>
                }
                <div class="@(isPremium ? "" : "blur-content")">
                    <div class="exercise-hero" style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 24px; align-items: center;">
                        <div>
                            <p id="exerciseGoalSummary" style="color: var(--text-muted); line-height: 1.6; margin-bottom: 16px;">
                                Workouts are matched to your current nutrition goal.
                            </p>
                            <div class="exercise-tabs" style="display: flex; gap: 8px;">
                                <button type="button" class="btn-profile-outline active" data-exercise-goal="loss">Weight Loss</button>
                                <button type="button" class="btn-profile-outline" data-exercise-goal="maintain">Maintain</button>
                                <button type="button" class="btn-profile-outline" data-exercise-goal="gain">Gain Weight</button>
                            </div>
                        </div>
                        <img id="exerciseHeroImage" src="/excersize/maintain-weight.svg" style="max-height: 140px; object-fit: contain;" alt="Exercise plan">
                    </div>
    
                    <div class="premium-card-grid" id="exerciseCards"></div>
    
                    <h3 style="font-size: 18px; font-weight: 700; color: var(--text-main); margin: 24px 0 16px 0;">Videos</h3>
                    <div class="premium-card-grid" id="exerciseVideos"></div>
                    <p style="font-size: 12px; color: var(--text-muted); margin-top: 16px;">
                        Start light, warm up first, and stop if you feel pain, dizziness, or unusual shortness of breath.
                    </p>
                </div>
            </div>
        </div>

        <!-- Checklist Section -->
        <div id="todayChecklist" class="page-section">
            <div class="page-header-block">
                <h2>Today's Checklist</h2>
                <p>Complete your daily health tasks to stay on track.</p>
            </div>

            <div class="grid-card" style="min-height: auto;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
                    <span style="color: var(--text-muted); font-size: 14px;">Log meals and keep streaks active:</span>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <label for="checklistDate" style="font-size: 13px; font-weight: 600;">Date:</label>
                        <input type="date" id="checklistDate" style="padding: 6px 12px; border: 1px solid var(--border-color); border-radius: 8px;">
                    </div>
                </div>

                <div class="checklist-table-wrap">
                    <table class="checklist-table table table-hover" style="margin: 0;">
                        <thead>
                            <tr>
                                <th style="width: 80px; text-align: center;">Done</th>
                                <th>Task</th>
                                <th style="width: 160px;">Status</th>
                            </tr>
                        </thead>
                        <tbody id="checklistTableBody">
                            <tr>
                                <td colspan="3" class="text-center">Loading checklist...</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Add Food Section -->
        <div id="addFood" class="page-section">
            <div class="page-header-block">
                <h2>Add Food</h2>
                <p>Log your meals and snacks.</p>
            </div>
            <partial name="_AddFoodPartial" />
        </div>

        <!-- Notes Section -->
        <div id="notes" class="page-section">
            <div class="page-header-block">
                <h2>Nutrition Notes</h2>
                <p>Write down food items or recipes for instant analysis.</p>
            </div>
            <div class="grid-card" style="min-height: auto;">
                <textarea id="foodDescriptionInput" rows="6" style="padding: 16px; border: 1px solid var(--border-color); border-radius: 12px; width: 100%; font-size: 14px;" placeholder="Write your meal plans, e.g., 2 eggs, 1 slice of whole wheat toast for breakfast..."></textarea>
                <div style="display: flex; align-items: center; gap: 12px; margin-top: 16px;">
                    <button class="btn btn-success" id="analyzeFoodButton" onclick="analyzeFood()" style="background-color: var(--primary) !important; border-radius: 12px; font-weight: 700; padding: 12px 24px;">Analyze Food</button>
                    <span id="analyzeFoodLoader" style="display:none; font-size: 14px; color: var(--text-muted);"><i class="fas fa-spinner fa-spin"></i> Analyzing...</span>
                </div>
            </div>
        </div>

        <!-- Quick Stats Section -->
        <div id="quickStats" class="page-section">
            <div class="page-header-block">
                <h2>Quick Stats</h2>
                <p>Overview of current accomplishments.</p>
            </div>
            <div class="premium-card-grid">
                <div class="grid-card" style="min-height: 160px; justify-content: center; text-align: center;">
                    <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Calories Today</span>
                    <strong style="font-size: 36px; color: var(--primary); display: block; margin: 8px 0;" id="dashboardCalories">0</strong>
                    <span style="font-size: 12px; color: var(--text-muted);">kcal</span>
                </div>
                <div class="grid-card" style="min-height: 160px; justify-content: center; text-align: center;">
                    <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; letter-spacing: 0.05em;">Current Streak</span>
                    <strong style="font-size: 36px; color: #ea580c; display: block; margin: 8px 0;" id="dashboardStreak">0</strong>
                    <span style="font-size: 12px; color: var(--text-muted);">days 🔥</span>
                </div>
            </div>
        </div>

        <!-- Mood Tracker Section -->
        <div id="moodTracker" class="page-section">
            <div class="page-header-block">
                <h2>How are you feeling today?</h2>
                <p>Track your daily mood to recognize patterns.</p>
            </div>
            <div class="grid-card" style="min-height: auto;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap; gap: 12px;">
                    <span style="color: var(--text-muted); font-size: 14px;">Select an emoji:</span>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <label for="moodDate" style="font-size: 13px; font-weight: 600;">Date:</label>
                        <input type="date" id="moodDate" style="padding: 6px 12px; border: 1px solid var(--border-color); border-radius: 8px;">
                    </div>
                </div>

                <div class="mood-tracker" style="display: flex; justify-content: space-around; font-size: 36px; padding: 20px 0;">
                    <i class="far fa-smile" title="Happy" style="cursor: pointer; transition: transform 0.2s;" onclick="selectMood('Happy')"></i>
                    <i class="far fa-meh" title="Neutral" style="cursor: pointer; transition: transform 0.2s;" onclick="selectMood('Neutral')"></i>
                    <i class="far fa-frown" title="Sad" style="cursor: pointer; transition: transform 0.2s;" onclick="selectMood('Sad')"></i>
                    <i class="far fa-laugh-beam" title="Excited" style="cursor: pointer; transition: transform 0.2s;" onclick="selectMood('Excited')"></i>
                    <i class="far fa-tired" title="Tired" style="cursor: pointer; transition: transform 0.2s;" onclick="selectMood('Tired')"></i>
                    <i class="far fa-angry" title="Angry" style="cursor: pointer; transition: transform 0.2s;" onclick="selectMood('Angry')"></i>
                </div>

                <div style="text-align: center; margin: 12px 0;">
                    <span class="mood-message" id="selectedMood" style="font-size: 16px; font-weight: 700; color: var(--primary);">No mood logged.</span>
                </div>

                <div style="margin-top: 20px;">
                    <label for="moodReason" style="font-size: 13px; font-weight: 600; color: var(--text-muted); display: block; margin-bottom: 6px;">Notes or triggers (optional)</label>
                    <textarea id="moodReason" rows="3" style="padding: 12px; border: 1px solid var(--border-color); border-radius: 12px; width: 100%; font-size: 14px;" placeholder="What contributed to this mood..."></textarea>
                    <button type="button" class="btn btn-primary" onclick="saveCurrentMoodReason()" style="background-color: var(--primary) !important; border-radius: 12px; margin-top: 12px; font-weight: 700; padding: 10px 20px;">Save Notes</button>
                </div>
            </div>
        </div>

        <!-- Suggestions Section -->
        <div id="suggestions" class="page-section">
            <div class="page-header-block">
                <h2>Suggestions</h2>
                <p>AI recommendations based on your logs.</p>
            </div>
            
            <div class="grid-card" style="min-height: auto;">
                <div style="background-color: var(--primary-light); color: var(--primary); padding: 16px; border-radius: 12px; font-weight: 600; font-size: 15px; margin-bottom: 24px;" id="suggestionsText">
                    You haven't logged any meals yet. Start by adding some food items to get personalized suggestions!
                </div>
                
                <h3 style="font-size: 16px; font-weight: 700; color: var(--text-main); margin-bottom: 16px;">General Guidelines</h3>
                <div style="display: flex; flex-direction: column; gap: 12px;" id="suggestionsList">
                    <div style="border-left: 4px solid var(--primary); padding-left: 14px;">
                        <strong style="display: block; font-size: 14px; color: var(--text-main);">💧 Increase Hydration</strong>
                        <span style="font-size: 13px; color: var(--text-muted);">Drink water throughout the day to support recovery and digestion.</span>
                    </div>
                    <div style="border-left: 4px solid var(--macro-carbs); padding-left: 14px;">
                        <strong style="display: block; font-size: 14px; color: var(--text-main);">🥗 Balance Carb Sources</strong>
                        <span style="font-size: 13px; color: var(--text-muted);">Prioritize complex carbs (oats, brown rice) over refined sugars.</span>
                    </div>
                    <div style="border-left: 4px solid var(--macro-protein); padding-left: 14px;">
                        <strong style="display: block; font-size: 14px; color: var(--text-main);">🍗 Lean Proteins</strong>
                        <span style="font-size: 13px; color: var(--text-muted);">Incorporate protein in each meal to preserve muscle tissues.</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Progress Charts Section -->
        <div id="progressCharts" class="page-section">
            <div class="charts-filter-row">
                <div class="page-header-block" style="margin: 0;">
                    <h2>Progress Charts</h2>
                    <p>Visualize your nutrition and fitness progress</p>
                </div>
                <div class="charts-filter-actions">
                    <button class="dropdown-filter-btn" type="button">
                        <i class="far fa-calendar"></i> May 12 - May 18, 2024 <i class="fas fa-chevron-down" style="font-size: 10px;"></i>
                    </button>
                    <button class="dropdown-filter-btn" type="button">
                        <i class="fas fa-filter"></i> All Data <i class="fas fa-chevron-down" style="font-size: 10px;"></i>
                    </button>
                </div>
            </div>

            <!-- Donut Charts Row -->
            <div class="chart-grid">
                <!-- Calorie Intake Progress -->
                <div class="chart-card">
                    <h4>Calorie Intake Progress</h4>
                    <div class="chart-card-content">
                        <div class="chart-container-half">
                            <canvas id="calorieProgressChart"></canvas>
                        </div>
                        <div class="chart-legend-half">
                            <div class="legend-item">
                                <span class="legend-label-col">
                                    <span class="legend-dot" style="background-color: var(--primary);"></span> Consumed
                                </span>
                                <span class="legend-value-col" id="chartCalConsumed">0 kcal</span>
                            </div>
                            <div class="legend-item">
                                <span class="legend-label-col">
                                    <span class="legend-dot" style="background-color: #f87171;"></span> Remaining
                                </span>
                                <span class="legend-value-col" id="chartCalRemaining">2,000 kcal</span>
                            </div>
                            <div class="chart-summary-footer">
                                <span>Daily Goal</span>
                                <span class="chart-summary-goal" id="chartCalGoal">2,200 kcal</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Daily Progress -->
                <div class="chart-card">
                    <h4>Daily Progress</h4>
                    <div class="chart-card-content">
                        <div class="chart-container-half" style="width: 100%; height: 220px;">
                            <canvas id="goalCompletionChart"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Profile Section -->
        <div id="profile" class="page-section">
            <div class="page-header-block">
                <h2>Profile</h2>
                <p>Manage your profile and preferences.</p>
            </div>

            <!-- Profile Info Card -->
            <div class="profile-main-card">
                <div class="profile-card-header">
                    <div class="profile-identity-block">
                         <div class="profile-avatar-wrapper">
                           <img id="profileAvatarImage" src="@ProfileImageSrc" class="profile-avatar-large" alt="User Avatar" title="Click to change photo" style="cursor:pointer;" onclick="document.getElementById('profileImageInput').click();" onerror="this.onerror=null;this.src='@DefaultAvatarSrc';">
                           <input type="file" id="profileImageInput" accept="image/*" style="display:none;" onchange="uploadProfileImage(this.files && this.files[0] ? this.files[0] : null)">
                           <div class="profile-avatar-actions" style="margin-top:8px; display:flex; gap:8px; justify-content:center;">
                             <button type="button" class="btn-profile-outline" onclick="document.getElementById('profileImageInput').click();">Edit Photo</button>
                             <button type="button" class="btn-profile-outline red" onclick="removeProfileImage();">Remove Photo</button>
                           </div>
                         </div>
                        <div class="profile-identity-details">
                            <h2>@Name</h2>
                            <p>@Email</p>
                            <div class="profile-badges-row">
                                <span class="profile-badge green">
                                    <i class="fas fa-bullseye"></i> Goal: <span id="goal" style="font-weight: 700; margin-left: 2px;">Weight Loss</span>
                                </span>
                                <span class="profile-badge grey">
                                    <i class="fas fa-user"></i> Age <span id="Age" style="font-weight: 700; margin-left: 2px;">23</span>
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="profile-actions-block">
                        <button type="button" onclick="toggleEditProfile()" class="btn-profile-outline">Edit Profile</button>
                        <form id="logoutForm" method="get" action="/User/Logout" style="margin: 0;">
                            <button type="submit" class="btn-profile-outline red">
                                <i class="fas fa-sign-out-alt"></i> Logout
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Stats Rows (Days Completed, Remaining, Streak) -->
            <div class="profile-stats-grid">
                <div class="profile-stat-card">
                    <div class="profile-stat-icon-box green">
                        <i class="far fa-calendar-check"></i>
                    </div>
                    <div class="profile-stat-text-box">
                        <h4 id="profileDaysCompleted">12</h4>
                        <p>Days Completed</p>
                    </div>
                </div>
                
                <div class="profile-stat-card" style="justify-content: space-between;">
                    <div style="display: flex; align-items: center; gap: 16px;">
                        <div class="profile-stat-icon-box green">
                            <i class="fas fa-hourglass-half"></i>
                        </div>
                        <div class="profile-stat-text-box">
                            <h4 id="profileDaysRemaining">18</h4>
                            <p>Days Remaining</p>
                        </div>
                    </div>
                    <!-- Small SVG Circular indicator -->
                    <svg width="36" height="36" viewBox="0 0 36 36" style="transform: rotate(-90deg);">
                        <circle cx="18" cy="18" r="16" fill="none" stroke="#eef8f3" stroke-width="3"></circle>
                        <circle cx="18" cy="18" r="16" fill="none" stroke="#0f4c3a" stroke-width="3" stroke-dasharray="100" stroke-dashoffset="60" id="profileRemainingCircleDash"></circle>
                    </svg>
                </div>

                <div class="profile-stat-card">
                    <div class="profile-stat-icon-box orange">
                        <i class="fas fa-fire"></i>
                    </div>
                    <div class="profile-stat-text-box">
                        <h4 id="streakTextprofile">263</h4>
                        <p>Current Streak</p>
                    </div>
                </div>
            </div>

            <!-- Goal Completion card -->
            <div class="profile-goal-card">
                <div class="profile-goal-header">
                    <h3>Goal Completion</h3>
                    <span class="profile-goal-percent" id="goalPercentText">40%</span>
                </div>
                <div class="profile-goal-track">
                    <div class="profile-goal-fill" id="goalProgressBarFill" style="width: 40%;"></div>
                </div>
                <p class="profile-goal-subtext">You're making great progress towards your goal!</p>
            </div>

            <!-- Referral Friend Section — Professional Redesign -->
            <div class="referral-hero-section @(isPremium ? "" : "premium-locked-section")">
                @if (!isPremium)
                {
                    <div class="premium-locked-overlay">
                        <i class="fas fa-crown"></i>
                        <h3>Premium Feature</h3>
                        <p>Unlock the Rewards Program to invite friends and earn points for premium perks.</p>
                        <button class="btn-go-premium" onclick="upgradeToPremium()">Upgrade Now</button>
                    </div>
                }
                <div class="@(isPremium ? "" : "blur-content")">
                    <!-- Gradient Hero Banner -->
                <div class="referral-hero-banner">
                    <div class="referral-hero-left">
                        <div class="referral-badge-pill">
                            <i class="fas fa-gem"></i> Rewards Program
                        </div>
                        <h2 class="referral-hero-title">Share NutrInfo, Earn Together</h2>
                        <p class="referral-hero-desc">Invite friends and earn <strong>100 points</strong> for every friend who joins. Points unlock premium features, meal plans, and more.</p>
                        <div class="referral-steps-row">
                            <div class="referral-step">
                                <div class="referral-step-num">1</div>
                                <span>Share your invite link</span>
                            </div>
                            <div class="referral-step-arrow"><i class="fas fa-chevron-right"></i></div>
                            <div class="referral-step">
                                <div class="referral-step-num">2</div>
                                <span>Friend signs up</span>
                            </div>
                            <div class="referral-step-arrow"><i class="fas fa-chevron-right"></i></div>
                            <div class="referral-step">
                                <div class="referral-step-num">3</div>
                                <span>You earn 100 points</span>
                            </div>
                        </div>
                    </div>
                    <div class="referral-hero-right">
                        <div class="referral-trophy-icon">
                            <i class="fas fa-trophy"></i>
                        </div>
                        <div class="referral-points-display">
                            <span class="referral-pts-number">100</span>
                            <span class="referral-pts-label">Points per referral</span>
                        </div>
                    </div>
                </div>

                <!-- Invite Form Card -->
                <div class="referral-invite-card">
                    <div class="referral-invite-header">
                        <div class="referral-invite-icon">
                            <i class="fas fa-envelope-open-text"></i>
                        </div>
                        <div>
                            <h4 class="referral-invite-title">Send an Invitation</h4>
                            <p class="referral-invite-sub">Your friend will receive a personalised invite email from you.</p>
                        </div>
                    </div>
                    <div class="referral-form-row">
                        <div class="referral-input-wrap">
                            <i class="fas fa-envelope referral-input-icon"></i>
                            <input type="email" id="referralEmailInput" class="referral-email-input" placeholder="Enter friend's email address">
                        </div>
                        <button type="button" class="btn-referral-send" onclick="sendReferralInvite()">
                            <i class="fas fa-paper-plane"></i> Send Invite
                        </button>
                    </div>
                    <p class="referral-privacy-note"><i class="fas fa-lock"></i> We'll never share your friend's email with third parties.</p>
                </div>
            </div>

            <!-- Edit Profile Form (Initially Hidden) -->
            <div id="editProfileForm" class="edit-profile-box" style="display: none;">
                <h3>Edit Your Profile</h3>
                <form onsubmit="event.preventDefault(); saveProfileChanges();" class="edit-profile-form">
                    <div class="form-field">
                        <label for="editFirstName">First Name</label>
                        <input type="text" id="editFirstName" value="@FirstName" required>
                    </div>
                    <div class="form-field">
                        <label for="editLastName">Last Name</label>
                        <input type="text" id="editLastName" value="@LastName" required>
                    </div>
                    <div class="form-field full-width">
                        <label for="editGoal">Goal</label>
                        <input type="text" id="editGoal" value="Weight Loss" required>
                    </div>
                    <button type="submit" class="btn-save-changes">Save Changes</button>
                </form>
            </div>
        </div>

    </div>

    <!-- SweetAlert and JS scripts -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Go Premium function
        window.upgradeToPremium = async function () {
            try {
                // Show loading state
                Swal.fire({
                    title: 'Upgrading to Premium...',
                    text: 'Please wait while we unlock your features.',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });

                const resp = await fetch('/User/UpgradeUser', { method: 'POST' });
                const data = await resp.json();

                if (data.success) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Welcome to Premium! 👑',
                        text: 'Your new features have been unlocked.',
                        confirmButtonColor: '#0f4c3a'
                    }).then(() => {
                        window.location.reload();
                    });
                } else {
                    Swal.fire({ icon: 'error', title: 'Upgrade Failed', text: data.message });
                }
            } catch (err) {
                Swal.fire({ icon: 'error', title: 'Network Error', text: 'Could not reach the server.' });
            }
        };

        // Global function - defined outside DOMContentLoaded so inline onclick handlers can access it immediately
        function switchSection(sectionId) {
            document.querySelectorAll('.page-section').forEach(sec => sec.classList.remove('active'));
            document.querySelectorAll('.sidebar .nav-link').forEach(link => link.classList.remove('active'));
            
            const activeSection = document.getElementById(sectionId);
            if (activeSection) activeSection.classList.add('active');
            
            const activeLink = document.querySelector(`.sidebar [data-section="${sectionId}"]`);
            if (activeLink) activeLink.classList.add('active');
            
            if (sectionId === 'todayChecklist' && typeof loadChecklist === 'function') loadChecklist();
            if (sectionId === 'moodTracker' && typeof loadMood === 'function') loadMood();
        }

        document.addEventListener("DOMContentLoaded", async () => {
            const Name = '@Name';
const Email = '@Email';
            
            // Set today's date in Daily Summary section
            const todayDateElement = document.getElementById('todayDate');
            const todayDayNameElement = document.getElementById('todayDayName');
            const today = new Date();
            
            if (todayDayNameElement) {
                todayDayNameElement.textContent = today.toLocaleDateString('en-US', { weekday: 'long' });
            }
            if (todayDateElement) {
                todayDateElement.textContent = today.toLocaleDateString('en-US', { 
                    year: 'numeric', 
                    month: 'long', 
                    day: 'numeric' 
                });
            }

            // Local hydration log support for seamless experience
            const todayStr = today.toDateString();
            window.addWaterLocally = function () {
                let localWater = parseFloat(localStorage.getItem('localWater_' + todayStr)) || 0;
                localWater += 0.25;
                localStorage.setItem('localWater_' + todayStr, localWater);
                Swal.fire({
                    icon: 'success',
                    title: 'Hydrated!',
                    text: '+0.25 L added!',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 1500
                });
                loadDailyNutrition();
            };

            // Referral trigger — sends a real email via backend
            window.sendReferralInvite = async function () {
                const input = document.getElementById('referralEmailInput');
                const friendEmail = input ? input.value.trim() : '';
                if (!friendEmail) {
                    Swal.fire({ icon: 'info', title: 'Email Required', text: 'Please enter your friend\'s email address.' });
                    return;
                }

                // Show loading state
                const btn = document.querySelector('.btn-referral-send');
                const originalHtml = btn ? btn.innerHTML : '';
                if (btn) { btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Sending...'; btn.disabled = true; }

                try {
                    const resp = await fetch('/User/SendReferralInvite', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ friendEmail })
                    });
                    const data = await resp.json();

                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Invitation Sent! 🎉',
                            text: `A personalised invite email has been sent to ${friendEmail}.`,
                            confirmButtonColor: '#0f4c3a'
                        });
                        if (input) input.value = '';
                    } else {
                        Swal.fire({ icon: 'error', title: 'Could Not Send', text: data.message || 'Something went wrong.', confirmButtonColor: '#0f4c3a' });
                    }
                } catch (err) {
                    Swal.fire({ icon: 'error', title: 'Network Error', text: 'Could not reach the server. Please try again.', confirmButtonColor: '#0f4c3a' });
                } finally {
                    if (btn) { btn.innerHTML = originalHtml; btn.disabled = false; }
                }
            };

            // Update stats cards
            async function updateDashboardStats() {
                try {
                    const resp = await fetch(`/api/nutrition/daily?email=${encodeURIComponent(Email)}`);
                    if (resp.ok) {
                        const data = await resp.json();
                        document.getElementById('dashboardCalories').textContent = data.calories ?? 0;
                    }
                } catch (err) { console.error('Failed to update stats', err); }
            }

            // Checklist functions (unchanged placeholder)
            const checklistDateInput = document.getElementById('checklistDate');
            const checklistTableBody = document.getElementById('checklistTableBody');

            function toDateInputValue(date) {
                const offsetDate = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
                return offsetDate.toISOString().split('T')[0];
            }

            function renderChecklist(items) {
                if (!checklistTableBody) return;
                checklistTableBody.innerHTML = '';
                if (items.length === 0) {
                    checklistTableBody.innerHTML = '<tr><td colspan="3" class="text-center text-muted">No checklist tasks.</td></tr>';
                    return;
                }
                // existing rendering logic continues...
            }

            // --- New Functions for Profile Image Options ---
            window.showProfileImageOptions = function() {
                Swal.fire({
                    title: 'Profile Photo',
                    text: 'Choose an action',
                    showConfirmButton: true,
                    showDenyButton: true,
                    confirmButtonText: 'Edit Photo',
                    denyButtonText: 'Remove Photo',
                    icon: 'question'
                }).then((result) => {
                    if (result.isConfirmed) {
                        // trigger hidden file input
                        document.getElementById('profileImageInput').click();
                    } else if (result.isDenied) {
                        removeProfileImage();
                    }
                });
            };

            window.removeProfileImage = function() {
                const email = '@Email';
                const formData = new FormData();
                formData.append('email', email);
                fetch('/User/RemoveProfileImage', {
                    method: 'POST',
                    body: formData
                })
                .then(resp => resp.json())
                .then(data => {
                    if (data.success) {
                        Swal.fire('Removed', 'Profile image removed.', 'success');
                        // reset avatar to default
                        const avatar = document.getElementById('profileAvatarImage');
                        if (avatar) avatar.src = '@DefaultAvatarSrc';
                    } else {
                        Swal.fire('Error', data.message || 'Failed to remove image.', 'error');
                    }
                })
                .catch(err => {
                    Swal.fire('Error', err.message || 'Error removing image.', 'error');
                });
            };

            // Initialize any needed functions
            // (you may call updateDashboardStats() etc. as before)

            async function loadChecklist() {
                if (!checklistDateInput || !checklistTableBody) return;
                checklistTableBody.innerHTML = '<tr><td colspan="3" class="text-center">Loading checklist...</td></tr>';
                try {
                    const resp = await fetch(`/api/nutrition/checklist?email=${encodeURIComponent(Email)}&date=${encodeURIComponent(checklistDateInput.value)}`);
                    if (!resp.ok) throw new Error('Failed to load checklist');
                    const data = await resp.json();
                    renderChecklist(data.items || []);
                } catch (err) {
                    console.error('Failed to load checklist', err);
                    checklistTableBody.innerHTML = '<tr><td colspan="3" class="text-center text-danger">Could not load checklist.</td></tr>';
                }
            }

            async function saveChecklist() {
                const items = Array.from(document.querySelectorAll('.checklist-toggle')).map(input => ({
                    taskKey: input.dataset.taskKey,
                    taskLabel: input.dataset.taskLabel,
                    isCompleted: input.checked
                }));

                try {
                    const resp = await fetch('/api/nutrition/checklist', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            email: Email,
                            checklistDate: checklistDateInput.value,
                            items
                        })
                    });
                    if (!resp.ok) throw new Error('Failed to save checklist');
                } catch (err) {
                    console.error('Failed to save checklist', err);
                    Swal.fire({ icon: 'error', title: 'Checklist Error', text: 'Could not save checklist.' });
                }
            }

            if (checklistDateInput) {
                checklistDateInput.value = toDateInputValue(new Date());
                checklistDateInput.addEventListener('change', loadChecklist);
            }

            if (checklistTableBody) {
                checklistTableBody.addEventListener('change', async event => {
                    if (!event.target.classList.contains('checklist-toggle')) return;
                    const row = event.target.closest('tr');
                    const badge = row?.querySelector('.badge');
                    if (badge) {
                        badge.textContent = event.target.checked ? 'Completed' : 'Pending';
                        badge.className = event.target.checked ? 'badge bg-success' : 'badge bg-warning text-dark';
                    }
                    await saveChecklist();
                });
            }

            // Mood Tracker hooks
            const moodDateInput = document.getElementById('moodDate');
            const moodReasonInput = document.getElementById('moodReason');
            let currentMood = '';

            const moodEmojis = {
                "Happy": "😊", "Neutral": "😐", "Sad": "😢",
                "Excited": "🤩", "Tired": "😴", "Angry": "😠"
            };

            function renderMood(mood, reason = '') {
                const moodDisplay = document.getElementById('selectedMood');
                const icons = document.querySelectorAll('.mood-tracker i');
                
                icons.forEach(icon => {
                    icon.style.color = '#9ca3af';
                    icon.style.transform = 'none';
                });
                
                currentMood = mood || '';
                if (moodReasonInput) moodReasonInput.value = reason || '';

                if (!mood) {
                    if (moodDisplay) moodDisplay.textContent = 'How was your day? Log it below.';
                    return;
                }

                const matchingIcon = Array.from(icons).find(el => el.title === mood);
                if (matchingIcon) {
                    matchingIcon.style.color = 'var(--primary)';
                    matchingIcon.style.transform = 'scale(1.25)';
                }

                const emoji = moodEmojis[mood] || "";
                if (moodDisplay) {
                    moodDisplay.textContent = `Eaten & Evolving: ${emoji} You felt ${mood} today.`;
                }
            }

            async function loadMood() {
                if (!moodDateInput) return;
                try {
                    const resp = await fetch(`/api/nutrition/mood?email=${encodeURIComponent(Email)}&date=${encodeURIComponent(moodDateInput.value)}`);
                    if (!resp.ok) throw new Error('Failed to load mood');
                    const data = await resp.json();
                    renderMood(data.mood || '', data.reason || '');
                } catch (err) { console.error('Failed to load mood', err); }
            }

            async function saveMood(mood) {
                const reason = moodReasonInput ? moodReasonInput.value.trim() : '';
                try {
                    const resp = await fetch('/api/nutrition/mood', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            email: Email,
                            moodDate: moodDateInput.value,
                            mood,
                            reason
                        })
                    });
                    if (!resp.ok) throw new Error('Failed to save mood');
                } catch (err) {
                    console.error('Failed to save mood', err);
                    Swal.fire({ icon: 'error', title: 'Mood Error', text: 'Could not save mood.' });
                }
            }

            window.saveCurrentMoodReason = async function () {
                if (!currentMood) {
                    Swal.fire({ icon: 'info', title: 'Select Mood', text: 'Please tap a mood emoji first.' });
                    return;
                }
                await saveMood(currentMood);
                Swal.fire({ icon: 'success', title: 'Saved Note', toast: true, position: 'top-end', showConfirmButton: false, timer: 1500 });
            };

            window.selectMood = function (mood) {
                renderMood(mood);
                saveMood(mood);
            };

            if (moodDateInput) {
                moodDateInput.value = toDateInputValue(new Date());
                moodDateInput.addEventListener('change', loadMood);
            }

            // Exercise configuration
            const exercisePlans = {
                loss: {
                    title: 'Weight Loss',
                    image: '/excersize/weight-loss.svg',
                    summary: 'Preserve lean mass & maximize deficit with dynamic cardio intervals and lifting.',
                    items: [
                        { title: 'Brisk Walk Intervals', image: '/excersize/weight-loss.svg', text: 'Alternate 3 minutes brisk walking with 1 minute easy walking for 30 minutes.', tags: ['Cardio', '4x/week', 'Beginner'] },
                        { title: 'Full Body Circuit', image: '/excersize/weight-loss.svg', text: 'Perform squats, push-ups, and step-ups in quick rounds with steady rest.', tags: ['Strength', '3x/week', 'Moderate'] }
                    ],
                    videos: [
                        { title: '20 Minute Fat Burning HIIT', channel: 'MommaStrong', duration: '20 min', id: 'ml6cT4AZdqI', url: 'https://www.youtube.com/watch?v=ml6cT4AZdqI' },
                        { title: 'Full Body Weight Loss Workout', channel: 'SELF', duration: '30 min', id: 'vWcMQdlQe7I', url: 'https://www.youtube.com/watch?v=vWcMQdlQe7I' },
                        { title: 'Beginner Cardio for Fat Loss', channel: 'Caroline Girvan', duration: '25 min', id: 'UItWltVZZmE', url: 'https://www.youtube.com/watch?v=UItWltVZZmE' }
                    ]
                },
                maintain: {
                    title: 'Maintain Weight',
                    image: '/excersize/maintain-weight.svg',
                    summary: 'Ensure caloric homeostasis, mobility, muscle tone, and recovery.',
                    items: [
                        { title: 'Steady Cardio', image: '/excersize/maintain-weight.svg', text: 'Cycle, swim, or jog at a comfortable pace for 30-40 minutes.', tags: ['Cardio', '3x/week', 'All Levels'] },
                        { title: 'Strength Basics', image: '/excersize/maintain-weight.svg', text: 'Perform squat, push, pull, hinge, and brace patterns with weights.', tags: ['Strength', '2x/week', 'Moderate'] }
                    ],
                    videos: [
                        { title: '30-Min Total Body Strength', channel: 'Heather Robertson', duration: '30 min', id: 'cbKkB3POqaY', url: 'https://www.youtube.com/watch?v=cbKkB3POqaY' },
                        { title: 'Yoga for Balance & Core', channel: 'Yoga with Adriene', duration: '32 min', id: 'VaoV1PrYft4', url: 'https://www.youtube.com/watch?v=VaoV1PrYft4' },
                        { title: 'Low Impact Cardio Workout', channel: 'Sydney Cummings', duration: '28 min', id: 'u-9OcaZqY7A', url: 'https://www.youtube.com/watch?v=u-9OcaZqY7A' }
                    ]
                },
                gain: {
                    title: 'Gain Weight',
                    image: '/excersize/gain-weight.svg',
                    summary: 'Load heavy, target hypertrophy, and give muscles adequate recovery.',
                    items: [
                        { title: 'Progressive Compound Lifts', image: '/excersize/gain-weight.svg', text: 'Build around deadlifts, weighted squats, overhead presses, and rows.', tags: ['Strength', '4x/week', 'Hypertrophy'] },
                        { title: 'Hypertrophy Sets', image: '/excersize/gain-weight.svg', text: 'Split routines targeting specific muscle groups with 3-5 sets of 8-12 reps.', tags: ['Muscle', '3x/week', 'Hypertrophy'] }
                    ],
                    videos: [
                        { title: 'Full Body Muscle Building (Beginner)', channel: 'Jeff Nippard', duration: '35 min', id: 'U9KBBnRBYRY', url: 'https://www.youtube.com/watch?v=U9KBBnRBYRY' },
                        { title: 'Hypertrophy Push Day Workout', channel: 'AthleanX', duration: '30 min', id: 'rT7DgGymasA', url: 'https://www.youtube.com/watch?v=rT7DgGymasA' },
                        { title: 'Mass Building Upper Body', channel: 'Jeremy Ethier', duration: '22 min', id: 'nHpbmKhDfgg', url: 'https://www.youtube.com/watch?v=nHpbmKhDfgg' }
                    ]
                }
            };

            function goalKeyFromText(goalText) {
                const value = (goalText || '').toLowerCase();
                if (value.includes('gain') || value.includes('increase') || value.includes('bulk')) return 'gain';
                if (value.includes('loss') || value.includes('lose') || value.includes('reduce') || value.includes('cut')) return 'loss';
                return 'maintain';
            }

            function renderExercisePlan(goalKey) {
                const plan = exercisePlans[goalKey] || exercisePlans.maintain;
                document.querySelectorAll('#exercise [data-exercise-goal]').forEach(btn => {
                    btn.classList.toggle('active', btn.dataset.exerciseGoal === goalKey);
                });
                const img = document.getElementById('exerciseHeroImage');
                if (img) img.src = plan.image;
                
                const sum = document.getElementById('exerciseGoalSummary');
                if (sum) sum.textContent = plan.summary;

                const cards = document.getElementById('exerciseCards');
                if (cards) {
                    cards.innerHTML = plan.items.map(item => `
                        <div class="grid-card" style="min-height: auto; padding: 18px;">
                            <img src="${item.image}" style="max-height: 100px; object-fit: contain; margin-bottom: 12px;" alt="">
                            <h4 style="font-size: 15px; font-weight: 700; margin: 0 0 6px 0;">${item.title}</h4>
                            <p style="font-size: 13px; color: var(--text-muted); line-height: 1.4; margin-bottom: 12px;">${item.text}</p>
                            <div style="display:flex; gap:6px; flex-wrap:wrap;">
                                ${item.tags.map(t => `<span style="font-size: 10px; font-weight: 700; background-color: var(--primary-light); color: var(--primary); padding: 4px 8px; border-radius: 20px;">${t}</span>`).join('')}
                            </div>
                        </div>
                    `).join('');
                }

                const videos = document.getElementById('exerciseVideos');
                if (videos) {
                    videos.innerHTML = plan.videos.map(v => `
                        <a href="${v.url}" target="_blank" rel="noopener noreferrer" class="yt-video-card" style="text-decoration:none; display:block;">
                            <div class="yt-thumb-wrap">
                                <img src="https://img.youtube.com/vi/${v.id}/mqdefault.jpg"
                                     alt="${v.title}"
                                     class="yt-thumb-img"
                                     onerror="this.style.display='none'; this.nextElementSibling.style.display='flex';">
                                <div class="yt-thumb-fallback" style="display:none;">
                                    <i class="fab fa-youtube" style="font-size:36px; color:#ff0000;"></i>
                                </div>
                                <div class="yt-play-overlay">
                                    <div class="yt-play-btn"><i class="fas fa-play"></i></div>
                                </div>
                                <span class="yt-duration-badge">${v.duration}</span>
                            </div>
                            <div class="yt-card-body">
                                <h4 class="yt-card-title">${v.title}</h4>
                                <div class="yt-card-meta">
                                    <i class="fab fa-youtube" style="color:#ff0000; font-size:13px;"></i>
                                    <span>${v.channel}</span>
                                </div>
                            </div>
                        </a>
                    `).join('');
                }
            }

            document.querySelectorAll('#exercise [data-exercise-goal]').forEach(btn => {
                btn.addEventListener('click', () => renderExercisePlan(btn.dataset.exerciseGoal));
            });

            // Initial load of user attributes
            try {
                const response = await fetch(`/User/streak?email=${encodeURIComponent(Email)}`);
                if (response.ok) {
                    const data = await response.json();
                    const streakCount = data.streak ?? 0;
                    const dob = data.dob;
                    const goal = data.goal || 'Weight Loss';
                    
                    let Age = "23";
                    if (dob) {
                        let [d, m, y] = dob.split(" ")[0].split("-");
                        let birthDate = new Date(y, m - 1, d);
                        let today = new Date();
                        let computedAge = today.getFullYear() - birthDate.getFullYear();
                        if (today.getMonth() < birthDate.getMonth() || (today.getMonth() === birthDate.getMonth() && today.getDate() < birthDate.getDate())) {
                            computedAge--;
                        }
                        Age = computedAge;
                    }

                    document.getElementById("streakText").textContent = `${streakCount}-day`;
                    document.getElementById("streakTextprofile").textContent = streakCount;
                    document.getElementById("Age").textContent = Age;
                    document.getElementById("goal").textContent = goal;
                    
                    // Profile stats
                    const daysCompleted = 12; // Static or derived from logs
                    const daysRemaining = 18;
                    document.getElementById("profileDaysCompleted").textContent = daysCompleted;
                    document.getElementById("profileDaysRemaining").textContent = daysRemaining;
                    
                    // Update remaining dash circle
                    const circleDash = document.getElementById('profileRemainingCircleDash');
                    if (circleDash) {
                        const totalDays = daysCompleted + daysRemaining;
                        const pctCompleted = (daysCompleted / totalDays) * 100;
                        const offset = 100 - pctCompleted;
                        circleDash.setAttribute('stroke-dashoffset', offset);
                        
                        document.getElementById('goalPercentText').textContent = `${Math.round(pctCompleted)}%`;
                        document.getElementById('goalProgressBarFill').style.width = `${pctCompleted}%`;
                    }

                    document.getElementById("editGoal").value = goal;
                    renderExercisePlan(goalKeyFromText(goal));
                }
            } catch (err) { console.error("Error loading user profile details", err); }

            // Calorie doughnut config
            const calorieCtx = document.getElementById('calorieProgressChart').getContext('2d');
            const calorieChart = new Chart(calorieCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Consumed', 'Remaining'],
                    datasets: [{
                        data: [0, 2000],
                        backgroundColor: ['#0f4c3a', '#eef8f3'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '80%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Daily bar progress config
            const goalCtx = document.getElementById('goalCompletionChart').getContext('2d');
            const goalChart = new Chart(goalCtx, {
                type: 'bar',
                data: {
                    labels: ['Consumed', 'Remaining'],
                    datasets: [{
                        data: [0, 2000],
                        backgroundColor: ['#0f4c3a', '#fca5a5'],
                        borderRadius: 8,
                        barThickness: 32
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { display: false, beginAtZero: true },
                        x: { grid: { display: false } }
                    }
                }
            });

            // Load today's logs
            async function loadDailyNutrition() {
                try {
                    const resp = await fetch(`/api/nutrition/daily?email=${encodeURIComponent(Email)}`);
                    if (resp.ok) {
                        const data = await resp.json();
                        const consumed = data.calories ?? 0;
                        const p = data.protein ?? 0;
                        const c = data.carbs ?? 0;
                        const f = data.fat ?? 0;
                        
                        // Hydration calculations incorporating local offset
                        const serverHydration = data.hydration ?? 0;
                        const localOffset = parseFloat(localStorage.getItem('localWater_' + todayStr)) || 0;
                        const finalHydration = Math.round((serverHydration + localOffset) * 10) / 10;

                        document.getElementById('caloriesConsumed').textContent = consumed;
                        document.getElementById('proteinCount').textContent = p;
                        document.getElementById('carbCount').textContent = c;
                        document.getElementById('fatCount').textContent = f;
                        document.getElementById('hydrationAmount').textContent = finalHydration;
                        
                        // Glass animation fill
                        const glassFill = document.getElementById('glassWaterFill');
                        if (glassFill) {
                            const percent = Math.min(100, (finalHydration / 2.5) * 100);
                            glassFill.style.height = `${percent}%`;
                        }

                        // Chart inputs
                        document.getElementById('chartCalConsumed').textContent = `${consumed} kcal`;

                        updateChartsWithData(consumed);
                        updateMacroBars();
                    }
                } catch (err) { console.error('Error loading daily summary logs', err); }
            }

            // Sync consumed with calorie circles/bars
            async function updateChartsWithData(consumedVal) {
                try {
                    const goalResp = await fetch(`/api/nutrition/goal?email=${encodeURIComponent(Email)}`);
                    if (goalResp.ok) {
                        const gData = await goalResp.json();
                        const goal = gData.calories ?? 2000;
                        const remaining = Math.max(0, goal - consumedVal);
                        
                        // Circle text update
                        const circle = document.getElementById('calorieProgressCircle');
                        if (circle) {
                            const percentage = Math.min(100, (consumedVal / goal) * 100);
                            circle.style.setProperty('--progress', `${percentage}%`);
                        }
                        
                        document.getElementById('caloriesGoalText').textContent = goal.toLocaleString();
                        document.getElementById('chartCalRemaining').textContent = `${remaining} kcal`;
                        document.getElementById('chartCalGoal').textContent = `${goal} kcal`;

                        if (calorieChart) {
                            calorieChart.data.datasets[0].data = [consumedVal, remaining];
                            calorieChart.update();
                        }
                        if (goalChart) {
                            goalChart.data.datasets[0].data = [consumedVal, remaining];
                            goalChart.update();
                        }
                    }
                } catch (err) { console.error('Failed to update progress charts', err); }
            }

            // Sync macro fills
            function updateMacroBars() {
                const consumedP = parseFloat(document.getElementById('proteinCount').textContent) || 0;
                const consumedC = parseFloat(document.getElementById('carbCount').textContent) || 0;
                const consumedF = parseFloat(document.getElementById('fatCount').textContent) || 0;
                
                const goalP = parseFloat(document.getElementById('goalProtein').textContent) || 100;
                const goalC = parseFloat(document.getElementById('goalCarbs').textContent) || 250;
                const goalF = parseFloat(document.getElementById('goalFat').textContent) || 70;
                
                document.getElementById('macroProteinTarget').textContent = `${goalP}g`;
                document.getElementById('macroCarbsTarget').textContent = `${goalC}g`;
                document.getElementById('macroFatTarget').textContent = `${goalF}g`;
                
                const pctP = Math.min(100, (consumedP / goalP) * 100);
                const pctC = Math.min(100, (consumedC / goalC) * 100);
                const pctF = Math.min(100, (consumedF / goalF) * 100);
                
                document.getElementById('proteinBarFill').style.width = `${pctP}%`;
                document.getElementById('carbsBarFill').style.width = `${pctC}%`;
                document.getElementById('fatBarFill').style.width = `${pctF}%`;
            }

            async function loadUserGoal() {
                try {
                    const resp = await fetch(`/api/nutrition/goal?email=${encodeURIComponent(Email)}`);
                    if (resp.ok) {
                        const d = await resp.json();
                        document.getElementById('goalCalories').textContent = d.calories ?? 2000;
                        document.getElementById('goalProtein').textContent = d.protein ?? 100;
                        document.getElementById('goalCarbs').textContent = d.carbs ?? 250;
                        document.getElementById('goalFat').textContent = d.fat ?? 70;
                        if (d.message) document.getElementById('motd').textContent = d.message;
                        updateMacroBars();
                    }
                } catch (err) { console.error('Failed to load targets', err); }
            }

            async function loadSuggestions() {
                try {
                    const resp = await fetch(`/api/nutrition/suggestions?email=${encodeURIComponent(Email)}`);
                    if (resp.ok) {
                        const data = await resp.json();
                        if (data.suggestion) {
                            document.getElementById('suggestionsText').textContent = data.suggestion;
                        }
                    }
                } catch (err) { console.error('Failed to load suggestions', err); }
            }

            // Food analyzer logic
            window.analyzeFood = async function () {
                const foodDesc = document.getElementById("foodDescriptionInput").value;
                const btn = document.getElementById("analyzeFoodButton");
                const ldr = document.getElementById("analyzeFoodLoader");

                if (!foodDesc.trim()) {
                    Swal.fire('Input Error', 'Please write a food description.', 'info');
                    return;
                }

                btn.disabled = true;
                ldr.style.display = "inline-block";

                try {
                    const response = await fetch('/api/nutrition/analyze', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ description: foodDesc })
                    });

                    if (!response.ok) throw new Error("Analysis failed.");
                    const data = await response.json();

                    Swal.fire({
                        icon: 'success',
                        title: 'Food Analyzed!',
                        html: `<div style="text-align: left; font-size:14px; padding: 10px 20px;">
                                <strong>Calories:</strong> ${data.calories} kcal<br/>
                                <strong>Protein:</strong> ${data.protein} g<br/>
                                <strong>Carbs:</strong> ${data.carbs} g<br/>
                                <strong>Fat:</strong> ${data.fat} g
                               </div>`
                    });
                    document.getElementById("foodDescriptionInput").value = '';
                    loadDailyNutrition();
                } catch (err) {
                    console.error(err);
                    Swal.fire('Error', 'Failed to analyze food. Try again.', 'error');
                } finally {
                    ldr.style.display = "none";
                    btn.disabled = false;
                }
            };

            // Profile togglers
            window.toggleEditProfile = function () {
                const form = document.getElementById('editProfileForm');
                if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
            };

            window.saveProfileChanges = async function() {
                const firstName = document.getElementById('editFirstName').value.trim();
                const lastName = document.getElementById('editLastName').value.trim();
                const goal = document.getElementById('editGoal').value.trim();

                if (!firstName || !lastName || !goal) {
                    Swal.fire('Profile Error', 'Please fill in all fields', 'warning');
                    return;
                }

                try {
                    const formData = new FormData();
                    formData.append('email', Email);
                    formData.append('firstName', firstName);
                    formData.append('lastName', lastName);
                    formData.append('goal', goal);

                    const response = await fetch('/User/UpdateProfile', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Profile updated!',
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                } catch (error) {
                    console.error('Error updating profile:', error);
                    Swal.fire('Error', 'Unable to save profile.', 'error');
                }
            };

            window.uploadProfileImage = async function (profileImage) {
                if (!profileImage) return;

                if (profileImage.size > 1024 * 1024) {
                    Swal.fire('File limit exceeded', 'Avatar image must be 1 MB or smaller.', 'warning');
                    document.getElementById('profileImageInput').value = '';
                    return;
                }

                const formData = new FormData();
                formData.append('email', Email);
                formData.append('profileImage', profileImage);

                try {
                    const response = await fetch('/User/UpdateProfileImage', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();
                    if (data.success) {
                        const avatar = document.getElementById('profileAvatarImage');
                        if (avatar) avatar.src = data.profileImagePath || '@DefaultAvatarSrc';
                        document.getElementById('profileImageInput').value = '';
                        Swal.fire('Avatar Updated!', 'New profile image loaded successfully.', 'success');
                        return;
                    }
                    Swal.fire('Upload Failed', data.message, 'error');
                    document.getElementById('profileImageInput').value = '';
                } catch (error) {
                    console.error('Error updating profile image:', error);
                    Swal.fire('Error', 'Unable to upload image.', 'error');
                    document.getElementById('profileImageInput').value = '';
                }
            };

            window.removeProfileImage = async function () {
                const confirmed = await Swal.fire({
                    title: 'Remove Avatar?',
                    text: "Revert back to the default profile image?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: 'var(--primary)',
                    cancelButtonColor: '#ef4444',
                    confirmButtonText: 'Yes, remove it'
                });

                if (!confirmed.isConfirmed) return;

                try {
                    const formData = new FormData();
                    formData.append('email', Email);

                    const response = await fetch('/User/RemoveProfileImage', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();
                    if (data.success) {
                        document.getElementById('profileAvatarImage').src = '@DefaultAvatarSrc';
                        Swal.fire('Avatar Removed', 'Profile image reset back to default.', 'success');
                        return;
                    }
                    Swal.fire('Remove Failed', data.message, 'error');
                } catch (error) {
                    console.error('Error removing profile image:', error);
                    Swal.fire('Error', 'Unable to remove image.', 'error');
                }
            };

            // Logout interceptor with delay
            document.getElementById("logoutForm")?.addEventListener("submit", function (e) {
                e.preventDefault();
                Swal.fire({
                    icon: 'info',
                    title: 'We’ll Miss You!',
                    text: 'Keep nourishing your body!',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                setTimeout(() => { window.location.href = '/User/Logout'; }, 3000);
            });

            // Redirect simple fallback names if needed
            if (Name === "user" || Email === "user@gmail.com") {
                window.location.href = '/Home/Index';
            }

            // Initial fetches
            loadDailyNutrition();
            loadUserGoal();
            loadSuggestions();
            updateDashboardStats();
        });
    </script>
</body>
</html>
