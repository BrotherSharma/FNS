@{
    ViewData["Title"] = "Home Page";
    string Name = ViewBag.Name;
    string Email = ViewBag.Email;
    string FirstName = ViewBag.FirstName ?? "User";
    string LastName = ViewBag.LastName ?? "";
    string ProfileImagePath = ViewBag.ProfileImagePath as string ?? string.Empty;
    string DefaultAvatarSrc = Url.Content("~/images/default-avatar.svg");
    string ProfileImageSrc = string.IsNullOrWhiteSpace(ProfileImagePath)
        ? DefaultAvatarSrc
        : ProfileImagePath;
    bool isPremium = Context.Session.GetString("IsPremium") == "True";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>NutrInfo</title>
    
    <!-- Google Font & Icons -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>
    <link href="/css/dashboard-premium.css" rel="stylesheet" />
</head>
<body class="dashboard-shell">

    <!-- Sidebar Navigation -->
    <div class="sidebar">
        <div class="logo-container">
            <i class="fas fa-leaf logo-icon"></i>
            <div class="logo-text">
                <span class="logo-title">NutrInfo</span>
                <span class="logo-subtitle">FUEL YOUR BEST</span>
            </div>
        </div>
        
        <div class="sidebar-nav">
            <a href="#" class="nav-link active" data-section="dashboard" onclick="event.preventDefault(); switchSection('dashboard')">
                <i class="fas fa-th-large"></i> Dashboard
            </a>
            <a href="#" class="nav-link" data-section="todayGoal" onclick="event.preventDefault(); switchSection('todayGoal')">
                <i class="fas fa-bullseye"></i> Today's Goal
            </a>
            <a href="#" class="nav-link" data-section="exercise" onclick="event.preventDefault(); switchSection('exercise')">
                <i class="fas fa-dumbbell"></i> Exercise
            </a>
            <a href="#" class="nav-link" data-section="todayChecklist" onclick="event.preventDefault(); switchSection('todayChecklist')">
                <i class="fas fa-tasks"></i> Today's Checklist
            </a>
            <a href="#" class="nav-link" data-section="addFood" onclick="event.preventDefault(); switchSection('addFood')">
                <i class="fas fa-plus-circle"></i> Add Food
            </a>
            <a href="#" class="nav-link" data-section="notes" onclick="event.preventDefault(); switchSection('notes')">
                <i class="fas fa-sticky-note"></i> Notes
            </a>
            <a href="#" class="nav-link" data-section="moodTracker" onclick="event.preventDefault(); switchSection('moodTracker')">
                <i class="fas fa-smile"></i> Mood Tracker
            </a>
            <a href="#" class="nav-link" data-section="suggestions" onclick="event.preventDefault(); switchSection('suggestions')">
                <i class="fas fa-lightbulb"></i> Suggestions
            </a>
            <a href="#" class="nav-link" data-section="progressCharts" onclick="event.preventDefault(); switchSection('progressCharts')">
                <i class="fas fa-chart-bar"></i> Progress Charts
            </a>
            <a href="#" class="nav-link" data-section="profile" onclick="event.preventDefault(); switchSection('profile')">
                <i class="fas fa-user"></i> Profile
            </a>
        </div>

        <div class="premium-card">
            <div class="premium-card-content">
                <h4>Go Premium</h4>
                <p>Unlock advanced insights and personalized tips.</p>
            </div>
            <button class="premium-card-action" onclick="event.preventDefault(); switchSection('profile')">
                <i class="fas fa-chevron-right"></i>
            </button>
        </div>
    </div>

    <!-- Main Content Area -->
    <div class="main-content">
        
        <!-- Floating Header Widget -->
        <div class="top-header-widget">
            @if (!isPremium)
            {
                <a href="#" class="btn-go-premium header-premium-cta" onclick="event.preventDefault(); upgradeToPremium()">
                    <i class="fas fa-crown"></i> Go Premium
                </a>
            }
            <div class="notification-bell" onclick="alert('You are all caught up!')">
                <i class="far fa-bell"></i>
                <span class="notification-badge">2</span>
            </div>
            <div class="user-avatar-widget" onclick="switchSection('profile')">
                <span class="text-sm font-semibold" style="margin-right: 4px;">@FirstName</span>
                <img src="@ProfileImageSrc" class="user-avatar-img" alt="User profile" onerror="this.onerror=null;this.src='@DefaultAvatarSrc';">
            </div>
        </div>

        <!-- Dashboard Overview Section -->
        <div id="dashboard" class="page-section active">
            <div class="page-header-block">
                <h2>Dashboard Overview</h2>
                <p>Welcome back, @FirstName! Here's how your nutrition is shaping up. <i class="fas fa-heart footer-heart-icon"></i></p>
            </div>

            <!-- 4 Column Premium Cards Grid -->
            <div class="premium-card-grid">
                <!-- Date Card -->
                <div class="grid-card date-card">
                    <div class="card-title-row">
                        <h3>Date</h3>
                        <div class="card-icon-container green">
                            <i class="far fa-calendar-alt"></i>
                        </div>
                    </div>
                    <div class="date-card-content">
                        <div class="date-card-day" id="todayDayName">Monday</div>
                        <div class="date-card-full" id="todayDate">June 22, 2026</div>
                    </div>
                    <div class="hills-illustration"></div>
                </div>

                <!-- Calories Consumed Card -->
                <div class="grid-card">
                    <div class="card-title-row">
                        <h3>Calories Consumed</h3>
                        <div class="card-icon-container orange">
                            <i class="fas fa-fire"></i>
                        </div>
                    </div>
                    <div class="radial-progress-container">
                        <div class="radial-progress-circle" id="calorieProgressCircle" style="--progress: 0%;">
                            <div class="radial-progress-center">
                                <i class="fas fa-fire" style="font-size: 18px; color: #f87171; margin-bottom: 2px;"></i>
                                <span class="radial-progress-value" id="caloriesConsumed">0</span>
                                <span class="radial-progress-unit">kcal</span>
                            </div>
                        </div>
                        <span class="radial-progress-goal">of <span id="caloriesGoalText">2,000</span> kcal</span>
                    </div>
                </div>

                <!-- Macros Card -->
                <div class="grid-card">
                    <div class="card-title-row">
                        <h3>Macros</h3>
                        <div class="card-icon-container green">
                            <i class="fas fa-sliders-h"></i>
                        </div>
                    </div>
                    <div class="macro-progress-list">
                        <div class="macro-item">
                            <div class="macro-header">
                                <span class="macro-name">
                                    <span class="macro-bullet protein"></span>Protein
                                </span>
                                <span class="macro-value"><span id="proteinCount">0</span>g / <span id="macroProteinTarget">150g</span></span>
                            </div>
                            <div class="macro-track protein">
                                <div class="macro-fill protein" id="proteinBarFill"></div>
                            </div>
                        </div>
                        <div class="macro-item">
                            <div class="macro-header">
                                <span class="macro-name">
                                    <span class="macro-bullet carbs"></span>Carbs
                                </span>
                                <span class="macro-value"><span id="carbCount">0</span>g / <span id="macroCarbsTarget">250g</span></span>
                            </div>
                            <div class="macro-track carbs">
                                <div class="macro-fill carbs" id="carbsBarFill"></div>
                            </div>
                        </div>
                        <div class="macro-item">
                            <div class="macro-header">
                                <span class="macro-name">
                                    <span class="macro-bullet fat"></span>Fat
                                </span>
                                <span class="macro-value"><span id="fatCount">0</span>g / <span id="macroFatTarget">70g</span></span>
                            </div>
                            <div class="macro-track fat">
                                <div class="macro-fill fat" id="fatBarFill"></div>
                            </div>
                        </div>
                    </div>
                    <a href="#" onclick="event.preventDefault(); switchSection('progressCharts')" class="macro-footer-link">
                        View macro breakdown <i class="fas fa-chevron-right" style="font-size: 10px;"></i>
                    </a>
                </div>

                <!-- Hydration Card -->
                <div class="grid-card">
                    <div class="card-title-row">
                        <h3>Hydration</h3>
                        <div class="card-icon-container blue">
                            <i class="fas fa-tint"></i>
                        </div>
                    </div>
                    <div class="hydration-container">
                        <div class="hydration-value-row">
                            <span class="hydration-value"><span id="hydrationAmount">0</span> L</span>
                            <div class="hydration-goal">of 2.5 L goal</div>
                        </div>
                        <div class="glass-wrapper">
                            <div class="glass-outer">
                                <div class="glass-water" id="glassWaterFill"></div>
                            </div>
                            <div class="glass-markings">
                                <span>2.5 L</span>
                                <span>1.5 L</span>
                                <span>0.5 L</span>
                                <span>0 L</span>
                            </div>
                        </div>
                        <button type="button" class="btn-add-water" onclick="addWaterLocally()">+ Add Water</button>
                    </div>
                </div>
            </div>

            <!-- Streak Banner -->
            <div class="streak-banner">
                <div class="streak-banner-left">
                    <div class="streak-wreath-icon">
                        <i class="fas fa-fire"></i>
                    </div>
                    <div class="streak-text-block">
                        <h3>You're on fire!</h3>
                        <div class="streak-text-main"><span id="streakText">263-day</span> healthy streak</div>
                        <p class="streak-text-sub">Consistency today, a stronger you tomorrow.</p>
                    </div>
                </div>
                <button type="button" class="btn-keep-streak" onclick="alert('Keep it up!')">Keep it up! 💪</button>
            </div>

            <!-- Advice Bar Footer -->
            <div class="footer-advice-bar">
                <div class="footer-advice-left">
                    <i class="fas fa-leaf"></i>
                    <span>Small steps every day lead to big changes over time.</span>
                </div>
                <i class="fas fa-heart footer-heart-icon"></i>
            </div>
        </div>

        <!-- Today's Goal Section -->
        <div id="todayGoal" class="page-section">
            <div class="page-header-block">
                <h2>Today's Goal</h2>
                <p>Check your targets for the day.</p>
            </div>
            
            <div class="grid-card" style="min-height: auto;">
                <div class="card-title-row">
                    <h3>Your Daily Nutrition Targets</h3>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 16px; margin-bottom: 24px;">
                    <div style="background-color: var(--bg-canvas); padding: 20px; border-radius: 16px; border: 1px solid var(--border-color); text-align: center;">
                        <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 6px;">Calories</span>
                        <strong style="font-size: 24px; color: var(--primary);" id="goalCalories">2000</strong>
                        <span style="font-size: 12px; color: var(--text-muted); display: block; margin-top: 2px;">kcal</span>
                    </div>
                    <div style="background-color: var(--bg-canvas); padding: 20px; border-radius: 16px; border: 1px solid var(--border-color); text-align: center;">
                        <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 6px;">Protein</span>
                        <strong style="font-size: 24px; color: var(--primary);" id="goalProtein">100</strong>
                        <span style="font-size: 12px; color: var(--text-muted); display: block; margin-top: 2px;">g</span>
                    </div>
                    <div style="background-color: var(--bg-canvas); padding: 20px; border-radius: 16px; border: 1px solid var(--border-color); text-align: center;">
                        <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 6px;">Carbs</span>
                        <strong style="font-size: 24px; color: var(--primary);" id="goalCarbs">250</strong>
                        <span style="font-size: 12px; color: var(--text-muted); display: block; margin-top: 2px;">g</span>
                    </div>
                    <div style="background-color: var(--bg-canvas); padding: 20px; border-radius: 16px; border: 1px solid var(--border-color); text-align: center;">
                        <span style="font-size: 12px; color: var(--text-muted); text-transform: uppercase; font-weight: 700; display: block; margin-bottom: 6px;">Fat</span>
                        <strong style="font-size: 24px; color: var(--primary);" id="goalFat">70</strong>
                        <span style="font-size: 12px; color: var(--text-muted); display: block; margin-top: 2px;">g</span>
                    </div>
                </div>
                <div style="background-color: var(--primary-light); color: var(--primary); padding: 16px; border-radius: 12px; font-weight: 600; font-size: 14px; text-align: center;" id="motd">
                    Message of the day: Keep going!
                </div>
            </div>
        </div>

        <!-- Exercise Section -->
        <div id="exercise" class="page-section">
            <div class="page-header-block">
                <h2>Exercise</h2>
                <p>Workouts matched to your goal.</p>
            </div>

            <!-- Exercise Timer Widget -->
            <div class="grid-card" style="min-height: auto; margin-bottom: 24px; padding: 20px;">
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 42px; height: 42px; border-radius: 12px; background: var(--primary-light); display: flex; align-items: center; justify-content: center;">
                            <i class="fas fa-stopwatch" style="color: var(--primary); font-size: 18px;"></i>
                        </div>
                        <div>
                            <h4 style="font-size: 15px; font-weight: 700; margin: 0;">Exercise Timer</h4>
                            <p style="font-size: 12px; color: var(--text-muted); margin: 0;">Set a countdown for your workout</p>
                        </div>
                    </div>
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <select id="exerciseTimerMinutes" style="padding: 8px 14px; border: 1px solid var(--border-color); border-radius: 10px; font-size: 14px; font-weight: 600;">
                            <option value="5">5 min</option>
                            <option value="10">10 min</option>
                            <option value="15">15 min</option>
                            <option value="20" selected>20 min</option>
                            <option value="25">25 min</option>
                            <option value="30">30 min</option>
                            <option value="45">45 min</option>
                            <option value="60">60 min</option>
                        </select>
                        <span id="exerciseTimerDisplay" style="font-size: 28px; font-weight: 800; color: var(--primary); font-variant-numeric: tabular-nums; min-width: 90px; text-align: center;">20:00</span>
                        <button type="button" id="exerciseTimerStartBtn" class="btn-profile-outline" onclick="toggleExerciseTimer()" style="padding: 8px 18px;">
                            <i class="fas fa-play"></i> Start
                        </button>
                        <button type="button" class="btn-profile-outline" onclick="resetExerciseTimer()" style="padding: 8px 14px;">
                            <i class="fas fa-undo"></i>
                        </button>
                    </div>
                </div>
            </div>

            <div class="grid-card @(isPremium ? "" : "premium-locked-section")" style="min-height: auto; margin-bottom: 24px;">
                @if (!isPremium)
                {
                    <div class="premium-locked-overlay">
                        <i class="fas fa-crown"></i>
                        <h3>Premium Feature</h3>
                        <p>Unlock curated workout videos tailored to your fitness goals.</p>
                        <button class="btn-go-premium" onclick="upgradeToPremium()">Upgrade Now</button>
                    </div>
                }
                <div class="@(isPremium ? "" : "blur-content")">
                    <div class="exercise-hero" style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: 24px; align-items: center;">
                        <div>
                            <p id="exerciseGoalSummary" style="color: var(--text-muted); line-height: 1.6; margin-bottom: 16px;">
                                Workouts are matched to your current nutrition goal.
                            </p>
                            <div class="exercise-tabs" style="display: flex; gap: 8px;">
                                <button type="button" class="btn-profile-outline active" data-exercise-goal="loss">Weight Loss</button>
                                <button type="button" class="btn-profile-outline" data-exercise-goal="maintain">Maintain</button>
                                <button type="button" class="btn-profile-outline" data-exercise-goal="gain">Gain Weight</button>
                            </div>
                        </div>
                        <img id="exerciseHeroImage" src="/excersize/maintain-weight.svg" style="max-height: 140px; object-fit: contain;" alt="Exercise plan">
                    </div>

                    <!-- Warm-Up Section -->
                    <h3 style="font-size: 16px; font-weight: 700; color: var(--text-main); margin: 24px 0 12px 0;"><i class="fas fa-sun" style="color: #f59e0b; margin-right: 6px;"></i>Warm-Up</h3>
                    <div class="premium-card-grid" id="exerciseWarmUp"></div>

                    <!-- Main Workouts -->
                    <h3 style="font-size: 16px; font-weight: 700; color: var(--text-main); margin: 24px 0 12px 0;"><i class="fas fa-dumbbell" style="color: var(--primary); margin-right: 6px;"></i>Main Workouts</h3>
                    <div class="premium-card-grid" id="exerciseCards"></div>

                    <!-- Cooldown Section -->
                    <h3 style="font-size: 16px; font-weight: 700; color: var(--text-main); margin: 24px 0 12px 0;"><i class="fas fa-snowflake" style="color: #3b82f6; margin-right: 6px;"></i>Cool Down</h3>
                    <div class="premium-card-grid" id="exerciseCoolDown"></div>

                    <!-- Weekly Schedule -->
                    <h3 style="font-size: 16px; font-weight: 700; color: var(--text-main); margin: 24px 0 12px 0;"><i class="fas fa-calendar-week" style="color: var(--primary); margin-right: 6px;"></i>Weekly Schedule</h3>
                    <div id="exerciseWeeklySchedule" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 10px; margin-bottom: 24px;"></div>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 16px; margin: 24px 0;">
                        <div class="grid-card" style="min-height: auto; padding: 18px;">
                            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 14px;"><i class="fas fa-user-check" style="color: var(--primary); margin-right: 6px;"></i>Plan Builder</h3>
                            <div style="display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px;">
                                <input id="exerciseAge" type="number" min="12" max="90" placeholder="Age" style="padding: 10px; border: 1px solid var(--border-color); border-radius: 10px;">
                                <input id="exerciseWeight" type="number" min="30" max="250" placeholder="Weight kg" style="padding: 10px; border: 1px solid var(--border-color); border-radius: 10px;">
                                <input id="exerciseHeight" type="number" min="120" max="230" placeholder="Height cm" style="padding: 10px; border: 1px solid var(--border-color); border-radius: 10px;">
                                <select id="exerciseLevel" style="padding: 10px; border: 1px solid var(--border-color); border-radius: 10px;">
                                    <option>Beginner</option>
                                    <option>Intermediate</option>
                                    <option>Advanced</option>
                                </select>
                            </div>
                            <select id="exerciseGoalSelect" style="width: 100%; margin-top: 10px; padding: 10px; border: 1px solid var(--border-color); border-radius: 10px;">
                                <option value="loss">Lose Weight</option>
                                <option value="gain">Build Muscle / Gain Weight</option>
                                <option value="maintain">Stay Fit / Improve Endurance</option>
                            </select>
                            <button type="button" class="btn-profile-outline" onclick="buildPersonalWorkoutPlan()" style="width: 100%; margin-top: 12px;"><i class="fas fa-wand-magic-sparkles"></i> Generate Plan</button>
                        </div>

                        <div class="grid-card" style="min-height: auto; padding: 18px;">
                            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 14px;"><i class="fas fa-fire" style="color: #ef4444; margin-right: 6px;"></i>Calories Burned</h3>
                            <select id="burnExerciseType" style="width: 100%; box-sizing: border-box; padding: 10px; border: 1px solid var(--border-color); border-radius: 10px;">
                                <option value="8.3">Running</option>
                                <option value="6.8">Cycling</option>
                                <option value="5.5">Strength Training</option>
                                <option value="7">Swimming</option>
                                <option value="3.8">Walking</option>
                                <option value="8">HIIT</option>
                            </select>
                            <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 10px; margin-top: 10px;">
                                <input id="burnMinutes" type="number" min="5" value="30" placeholder="Minutes" aria-label="Workout duration in minutes" style="width: 100%; min-width: 0; box-sizing: border-box; padding: 10px; border: 1px solid var(--border-color); border-radius: 10px;">
                                <input id="burnWeight" type="number" min="30" value="70" placeholder="Weight kg" aria-label="Body weight in kilograms" style="width: 100%; min-width: 0; box-sizing: border-box; padding: 10px; border: 1px solid var(--border-color); border-radius: 10px;">
                            </div>
                            <button type="button" class="btn-profile-outline" onclick="calculateExerciseBurn()" style="width: 100%; margin-top: 12px;"><i class="fas fa-calculator"></i> Calculate</button>
                            <div id="burnResult" style="margin-top: 12px; font-weight: 800; color: var(--primary); font-size: 24px;">0 kcal</div>
                        </div>

                        <div class="grid-card" style="min-height: auto; padding: 18px;">
                            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 14px;"><i class="fas fa-chart-line" style="color: var(--primary); margin-right: 6px;"></i>Workout Dashboard</h3>
                            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; text-align: center;">
                                <div><strong id="exerciseConsumed">0</strong><small style="display:block;color:var(--text-muted);">Consumed</small></div>
                                <div><strong id="exerciseBurned">0</strong><small style="display:block;color:var(--text-muted);">Burned</small></div>
                                <div><strong id="exerciseNet">0</strong><small style="display:block;color:var(--text-muted);">Net</small></div>
                            </div>
                            <div id="exerciseAchievements" style="display:flex; gap:8px; flex-wrap:wrap; margin-top:14px;"></div>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 16px; margin-bottom: 24px;">
                        <div class="grid-card" style="min-height: auto; padding: 18px;">
                            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 14px;"><i class="fas fa-calendar-days" style="color: var(--primary); margin-right: 6px;"></i>Workout Calendar</h3>
                            <div id="workoutCalendar" style="display:grid; grid-template-columns: repeat(7, 1fr); gap: 6px;"></div>
                            <p id="workoutCalendarSummary" style="font-size: 13px; color: var(--text-muted); margin: 12px 0 0;"></p>
                        </div>

                        <div class="grid-card" style="min-height: auto; padding: 18px;">
                            <h3 style="font-size: 16px; font-weight: 700; margin-bottom: 14px;"><i class="fas fa-list-check" style="color: var(--primary); margin-right: 6px;"></i>Today & History</h3>
                            <div id="todayWorkoutList"></div>
                            <button type="button" class="btn-profile-outline" onclick="completeTodayWorkout()" style="width: 100%; margin-top: 12px;"><i class="fas fa-check"></i> Complete Today's Workout</button>
                            <div id="workoutHistory" style="margin-top: 14px;"></div>
                        </div>
                    </div>

                    <div class="grid-card" style="min-height: auto; padding: 18px; margin-bottom: 24px;">
                        <div style="display:flex; justify-content:space-between; gap:12px; align-items:center; flex-wrap:wrap; margin-bottom:14px;">
                            <h3 style="font-size: 16px; font-weight: 700; margin:0;"><i class="fas fa-magnifying-glass" style="color: var(--primary); margin-right: 6px;"></i>Exercise Library</h3>
                            <div style="display:flex; gap:8px; flex-wrap:wrap;">
