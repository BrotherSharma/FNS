                    </div>
                `).join('');
            }

            window.getWorkoutCoachAdvice = async function () {
                const prompt = document.getElementById('coachPrompt')?.value?.trim() || '';
                const adviceBox = document.getElementById('coachAdvice');
                const btn = document.getElementById('workoutCoachButton');
                const loader = document.getElementById('workoutCoachLoader');

                if (!prompt) {
                    Swal.fire('Input Error', 'Please describe what you need help with today.', 'info');
                    return;
                }

                if (adviceBox) adviceBox.textContent = 'Getting workout suggestion...';
                if (btn) btn.disabled = true;
                if (loader) loader.style.display = 'inline-block';

                try {
                    const response = await fetch('/api/nutrition/workout-coach', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            prompt,
                            goal: document.getElementById('exerciseGoalSelect')?.selectedOptions?.[0]?.textContent || document.getElementById('goal')?.textContent || '',
                            fitnessLevel: document.getElementById('exerciseLevel')?.value || '',
                            age: Number(document.getElementById('exerciseAge')?.value || 0),
                            weight: Number(document.getElementById('exerciseWeight')?.value || document.getElementById('burnWeight')?.value || 0),
                            height: Number(document.getElementById('exerciseHeight')?.value || 0)
                        })
                    });

                    if (!response.ok) throw new Error('Workout coach request failed.');
                    const data = await response.json();
                    if (adviceBox) adviceBox.innerHTML = formatCoachRecommendation(data.recommendation);
                } catch (err) {
                    console.error(err);
                    if (adviceBox) adviceBox.textContent = 'Could not get a workout suggestion right now. Please try again.';
                    Swal.fire('Error', 'Failed to get workout suggestion. Try again.', 'error');
                } finally {
                    if (loader) loader.style.display = 'none';
                    if (btn) btn.disabled = false;
                }
            };

