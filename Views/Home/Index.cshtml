@{
    string Name = ViewBag.Name;
    string Email = ViewBag.Email;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Nutrition Dashboard</title>

    <!-- External Resources -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@300;600;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

</head>

<body>
    <!-- Sidebar -->
    <div class="sidebar">
        <a href="#" onclick="switchSection('dashboard')"><i class="fas fa-home"></i> Dashboard</a>
        <a href="#" onclick="switchSection('addFood')"><i class="fas fa-utensils"></i> Add Food</a>
        <a href="#" onclick="switchSection('notes')"><i class="fas fa-sticky-note"></i> Notes</a>
        <a href="#" onclick="switchSection('profile')"><i class="fas fa-user"></i> Profile</a>
        <a href="#" onclick="switchSection('logout')"><i class="fas fa-sign-out-alt"></i> Logout</a>
    </div>

    <!-- Main Content -->
    <div class="main-content">
        <!-- Header -->
        <div class="header">
            <h1>Nutrition Tracker</h1>
            <div class="profile-name">@Name</div>
        </div>

        <!-- Dashboard Section -->
        <div id="dashboard" class="page-section active">
            <h2>Daily Summary</h2>
            <p><strong>Date:</strong> <span id="todayDate"></span></p>
            <p><strong>Calories Consumed:</strong> 1800 kcal</p>
            <p><strong>Macros:</strong> Proteins: 90g, Carbs: 200g, Fats: 60g</p>
            <p><strong>Hydration:</strong> 1.5L</p>
            <p><strong>Today's Goal:</strong> 2000 kcal, 100g protein, 250g carbs, 70g fat</p>

            <div class="chart-row">
  <div class="chart-box">
    <canvas id="calorieProgressChart"></canvas>
  </div>
  <div class="chart-box">
    <canvas id="goalCompletionChart"></canvas>
  </div>
</div>



            <div class="section">
            <h2>Today's Checklist</h2>
            <div class="checklist">
                <label><input type="checkbox" checked> Logged All Meals</label>
                <label><input type="checkbox" checked> Met Water Intake</label>
                <label><input type="checkbox"> Completed Step Goal</label>
                <label><input type="checkbox"> Got 8 hrs Sleep</label>
            </div>
        </div>

        <div class="section">
        <h2>Mood Tracker</h2>
        <div class="mood-tracker">
            <i class="fas fa-smile" title="Happy" onclick="selectMood('Happy')"></i>
            <i class="fas fa-meh" title="Neutral" onclick="selectMood('Neutral')"></i>
            <i class="fas fa-frown" title="Sad" onclick="selectMood('Sad')"></i>
            <i class="fas fa-grin-stars" title="Excited" onclick="selectMood('Excited')"></i>
            <i class="fas fa-tired" title="Tired" onclick="selectMood('Tired')"></i>
            <i class="fas fa-angry" title="Angry" onclick="selectMood('Angry')"></i>
            <i class="fas fa-flushed" title="Anxious" onclick="selectMood('Anxious')"></i>
        </div>
        <div class="mood-reaction-container">
        <div id="selectedMood" class="mood-message hidden">You are feeling: 😊</div>
        </div>

        </div>


        <div class="section streak">
            <i class="fas fa-fire"></i>
            <span id="streakText">Loading streak...</span>
        </div>


        <div class="section">
            <h2>Suggestions</h2>
            <p>You’re low on fiber today. Consider adding leafy greens or oatmeal to your next meal.</p>
        </div>

        <div class="section">
            <h2>Export Summary</h2>
            <button onclick="alert('Exported as PDF! (functionality to be implemented)')">Export PDF</button>
        </div>

        </div>

        <!-- Add Food Section -->
        <div id="addFood" class="page-section">
            <h2>Add Food Intake</h2>
            <form>
                <label for="foodName">Food Name:</label>
                <input type="text" id="foodName" name="food">

                <label for="calories">Calories:</label>
                <input type="text" id="calories" name="calories">

                <label for="protein">Protein (g):</label>
                <input type="text" id="protein" name="protein">

                <label for="carbs">Carbohydrates (g):</label>
                <input type="text" id="carbs" name="carbs">

                <label for="fat">Fat (g):</label>
                <input type="text" id="fat" name="fat">

                <button type="submit">Add Food</button>
            </form>
        </div>

        <!-- Notes Section -->
        <!-- Notes Section -->
        <div id="notes" class="page-section">
            <h2>Nutrition Notes</h2>
            <textarea id="notesText" rows="6" placeholder="Write your meal plans, reminders or goals..."></textarea>
            <button onclick="analyzeNutrition()">Analyze & Save Note</button>
        </div>


        <!-- Profile Section -->
        <div id="profile" class="page-section">
            <div class="profile-container">
                <div class="profile-avatar">
                    <img src="https://avatars.githubusercontent.com/u/583231?v=4" alt="User Avatar">
                </div>
                <div class="profile-details">
                    <div class="profile-header-row">
                        <div class="profile-info">
                            <h2> @Name</h2>
                            <p><strong>Email:</strong> @Email</p>
                            <p><strong>Goal:</strong> Weight Loss</p>
                            <p><strong>points:</strong> 23</p>
                        </div>
                        <div>
                            <button onclick="toggleEditProfile()" class="edit-btn">Edit Profile</button>
                        </div>
                    </div>

                    <div class="profile-stats">
                        <div class="stat-box">
                            <h4>12</h4>
                            <p>Days Completed</p>
                        </div>
                        <div class="stat-box">
                            <h4>18</h4>
                            <p>Days Remaining</p>
                        </div>
                        <div class="stat-box">
                            <h4>🔥 6</h4>
                            <p>Current Streak</p>
                        </div>
                    </div>

                    <!-- Edit Profile Toggle Button -->
                    @* <button onclick="toggleEditProfile()">Edit Profile</button> *@
                </div>
            </div>

            <!-- Edit Profile Form (Initially Hidden) -->
            <div id="editProfileForm" style="display: none; margin-top: 30px;">
                <h3>Edit Your Profile</h3>
                <form>
                    <label for="name">Name:</label>
                    <input type="text" id="name" value=@Name>

                    <label for="goal">Goal:</label>
                    <input type="text" id="goal" value="Weight Loss">

                    <button type="submit" onclick="event.preventDefault(); alert('Profile Updated!')">Save Changes</button>
                </form>
            </div>

            <!-- Suggest Friend & Earn Rewards -->
            <div class="referral-section">
                <h3>Refer a Friend 🎉</h3>
                <p>Invite your friends and earn rewards when they sign up!</p>
                <input type="text" placeholder="Enter friend’s email">
                <button onclick="alert('Invitation Sent!')">Send Invite</button>
                <p style="margin-top: 10px;"><strong>Reward:</strong> 100 points for each successful referral 💎</p>
            </div>
        </div>



        <!-- Logout Section -->
        <div id="logout" class="page-section">
            <h2>Logout</h2>
            <p> Have a healthy day!</p>
            <form id="logoutForm" method="post" >
                <button type="submit" class="btn btn-primary">Logout</button>
            </form>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!-- Scripts -->
    <script>
document.addEventListener("DOMContentLoaded", async () => {
    // Set current date
    const currentDate = new Date();
    document.getElementById("todayDate").textContent = currentDate.toDateString();

    // Fetch and display user streak dynamically
    try {
        debugger;
        const userEmail = '@ViewBag.Email';
        const response = await fetch(`/User/streak?email=${encodeURIComponent(userEmail)}`);

        if (!response.ok) throw new Error("Failed to fetch streak");

        const streakCount = await response.json(); // this will be the integer directly
        document.getElementById("streakText").textContent = `${streakCount}-day healthy streak! 🔥`;

    } catch (err) {
        console.error("Error loading streak:", err);
        document.getElementById("streakText").textContent = "Could not load streak 😕";
    }

    // Calorie Progress Chart
    const calorieCtx = document.getElementById('calorieProgressChart').getContext('2d');
    const totalCaloriesGoal = 2000;
    const consumedCalories = 1800;
    const remainingCalories = totalCaloriesGoal - consumedCalories;
    new Chart(calorieCtx, {
        type: 'doughnut',
        data: {
            labels: ['Consumed', 'Remaining'],
            datasets: [{
                data: [consumedCalories, remainingCalories],
                backgroundColor: ['#2e5942', '#cccccc'],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                title: { display: true, text: 'Calorie Intake Progress' }
            }
        }
    });

    // Goal Completion Chart
    const goalCtx = document.getElementById('goalCompletionChart').getContext('2d');
    const totalDays = 30;
    const daysCompleted = 12;
    const daysLeft = totalDays - daysCompleted;
    new Chart(goalCtx, {
        type: 'bar',
        data: {
            labels: ['Completed', 'Remaining'],
            datasets: [{
                label: 'Days',
                data: [daysCompleted, daysLeft],
                backgroundColor: ['#2e5942', '#cccccc']
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                title: { display: true, text: 'Goal Completion (30-Day Plan)' }
            },
            scales: {
                y: { beginAtZero: true, ticks: { stepSize: 1 } }
            }
        }
    });

    // Analyze nutrition notes
    window.analyzeNutrition = function() {
        const note = document.getElementById("notesText").value;
        if (!note.trim()) return alert("Please enter a food description.");

        fetch('/api/nutrition/analyze', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ description: note })
        })
        .then(res => res.json())
        .then(data => {
            Swal.fire({
                icon: 'success',
                title: 'Nutrition Analysis Complete!',
                html: `<strong>Calories:</strong> ${data.calories} kcal<br/>
                       <strong>Protein:</strong> ${data.protein} g<br/>
                       <strong>Carbs:</strong> ${data.carbs} g<br/>
                       <strong>Fats:</strong> ${data.fat} g`
            });
        })
        .catch(err => { console.error(err); alert("Something went wrong!"); });
    }

    // Mood Tracker
    window.selectMood = function(mood) {
        const moodDisplay = document.getElementById('selectedMood');
        const icons = document.querySelectorAll('.mood-tracker i');
        icons.forEach(icon => icon.classList.remove('selected'));

        const selectedIcon = Array.from(icons).find(el => el.title === mood);
        if (selectedIcon) selectedIcon.classList.add('selected');

        const moodEmojis = {
            "Happy": "😊", "Neutral": "😐", "Sad": "😢",
            "Excited": "🤩", "Tired": "😴", "Angry": "😠", "Anxious": "😰"
        };
        const emoji = moodEmojis[mood] || "";
        moodDisplay.textContent = `You are feeling: ${emoji} ${mood}`;
        moodDisplay.classList.remove('show', 'hidden');
        void moodDisplay.offsetWidth; // restart animation
        moodDisplay.classList.add('show');
        setTimeout(() => { moodDisplay.classList.remove('show'); moodDisplay.classList.add('hidden'); }, 5000);
    }

    // Section switching
    window.switchSection = function(sectionId) {
        document.querySelectorAll('.page-section').forEach(sec => sec.classList.remove('active'));
        document.getElementById(sectionId).classList.add('active');
    }

    // Edit profile toggle
    window.toggleEditProfile = function() {
        const form = document.getElementById('editProfileForm');
        form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }

    // Logout form
    document.getElementById("logoutForm").addEventListener("submit", function (e) {
        e.preventDefault();
        Swal.fire({
            icon: 'info', title: 'We’ll Miss You!', text: 'Keep nourishing your body!',
            toast: true, position: 'top-end', showConfirmButton: false, timer: 4000, timerProgressBar: true
        });
        setTimeout(() => { window.location.href = '/User/Logout'; }, 4000);
    });

    // Redirect default user if needed
    const Name = '@Name';
    const Email = '@Email';
    if (Name === "user" || Email === "user@gmail.com") window.location.href = '/Home/Index';
});
</script>

</body>
</html>
