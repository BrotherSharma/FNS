                    ],
                    products: [
                        { name: 'Adjustable Dumbbell Set', desc: 'Perfect for full-body resistance training at the gym or home.', price: '₹7,199', image: 'https://images.unsplash.com/photo-1597776461687-15cab6a8e12e?auto=format&fit=crop&w=800&q=80', dietType: ['all'], gender: ['all'], amazonLink: 'https://www.amazon.in/dp/B08S7WH9KT', flipkartLink: 'https://www.flipkart.com/adjustable-dumbbell-set/p/itm1234567890' },
                        { name: 'High-Grip Resistance Bands', desc: 'Use for warm-ups, mobility, and strength-assisted movements.', price: '₹1,299', image: 'https://images.unsplash.com/photo-1598966735124-95af0a3a9b38?auto=format&fit=crop&w=800&q=80', dietType: ['all'], gender: ['all'], amazonLink: 'https://www.amazon.in/dp/B089K5NDW3', flipkartLink: 'https://www.flipkart.com/resistance-bands/p/itm0987654321' }
                    ],
                    dietChart: [
                        { meal: 'Breakfast', items: 'Oats with berries, paneer or tofu, Greek yogurt', calories: '420', protein: 28, carbs: 52, fat: 11 },
                        { meal: 'Lunch', items: 'Grilled tofu, brown rice, steamed vegetables', calories: '520', protein: 34, carbs: 62, fat: 14 },
                        { meal: 'Snack', items: 'Protein shake and a handful of almonds', calories: '260', protein: 26, carbs: 18, fat: 10 },
                        { meal: 'Dinner', items: 'Tofu, quinoa, mixed greens', calories: '470', protein: 31, carbs: 48, fat: 13 }
                    ]
                },
                maintain: {
                    title: 'Maintain Weight',
                    image: '/excersize/maintain-weight.svg',
                    summary: 'Ensure caloric homeostasis, mobility, muscle tone, and recovery.',
                    items: [
                        { title: 'Steady Cardio', image: '/excersize/maintain-weight.svg', text: 'Cycle, swim, or jog at a comfortable pace for 30-40 minutes.', tags: ['Cardio', '3x/week', 'All Levels'] },
                        { title: 'Strength Basics', image: '/excersize/maintain-weight.svg', text: 'Perform squat, push, pull, hinge, and brace patterns with weights.', tags: ['Strength', '2x/week', 'Moderate'] }
                    ],
                    videos: [
                        { title: '30-Min Total Body Strength', channel: 'AI Motion Coach', duration: '30 min', accent: '#06b6d4', note: 'Full-body strength with recovery focus.', related: ['Goblet Squats', 'Bent Over Rows', 'Plank Holds'], supplements: ['Creatine', 'Casein Protein', 'Joint Support'] },
                        { title: 'Yoga for Balance & Core', channel: 'AI Motion Coach', duration: '32 min', accent: '#14b8a6', note: 'Flow-based balance and posture routine.', related: ['Pilates Roll-Ups', 'Dead Bug', 'Side Plank'], supplements: ['Collagen', 'Omega-3s', 'Magnesium'] },
                        { title: 'Low Impact Cardio Workout', channel: 'AI Motion Coach', duration: '28 min', accent: '#84cc16', note: 'Easy rhythm for active recovery.', related: ['Brisk Walk', 'Stationary Bike', 'Low-Impact Step'], supplements: ['Hydration Electrolytes', 'Protein Smoothie', 'Recovery Tea'] },
                        { title: 'AI Demo: Mobility Flow', channel: 'NutrInfo Demo', duration: '12 min', accent: '#ec4899', note: 'Gentle mobility and stretching routine.', related: ['Hip Openers', 'Thoracic Rotations', 'Leg Swings'], supplements: ['Fish Oil', 'Turmeric', 'Vitamin D'] }
                    ],
