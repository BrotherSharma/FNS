            function normalizeDietPreference(value) {
                if (!value) return 'non-veg';
                const normalized = value.toString().trim().toLowerCase();
                if (['veg', 'vegetarian', 'veg.'].includes(normalized)) return 'vegetarian';
                return 'non-veg';
            }

            function getPreferredDietText(text, dietPreference) {
                const preference = normalizeDietPreference(dietPreference);
                if (preference !== 'vegetarian') return text;
                return text
                    .replace(/\b(grilled chicken|chicken stir-fry|grilled shrimp|chicken|salmon|shrimp|turkey|steak)\b/gi, matched => {
                        const map = {
                            'chicken': 'paneer',
                            'grilled chicken': 'grilled tofu',
                            'chicken stir-fry': 'paneer stir-fry',
                            'salmon': 'tofu',
                            'grilled shrimp': 'grilled tofu',
                            'shrimp': 'paneer',
                            'turkey': 'paneer',
                            'steak': 'soya steak'
                        };
                        return map[matched.toLowerCase()] || matched;
                    })
                    .replace(/\b(egg whites|eggs?)\b/gi, 'paneer or tofu');
            }

            function getGenderFriendlyNote(gender) {
                const key = (gender || 'all').toString().toLowerCase();
                if (key === 'female') return 'Balanced energy, recovery, and hormone-friendly nutrition.';
                if (key === 'male') return 'Strength, lean muscle, and recovery support.';
                return 'Nutrition and training tuned to your profile.';
            }

            function filterProductsByPreference(products) {
                const dietPreference = normalizeDietPreference(window.FNSUserDiet);
                const genderPref = (window.FNSUserGender || 'all').toString().toLowerCase();
                return (products || []).filter(product => {
                    const dietTypes = Array.isArray(product.dietType) ? product.dietType.map(t => t.toString().toLowerCase()) : ['all'];
                    const genderTypes = Array.isArray(product.gender) ? product.gender.map(g => g.toString().toLowerCase()) : ['all'];

                    if (!dietTypes.includes('all')) {
                        if (dietPreference === 'vegetarian' && !dietTypes.includes('vegetarian')) return false;
                        if (dietPreference !== 'vegetarian' && !dietTypes.includes('all')) return false;
                    }
                    if (!genderTypes.includes('all')) {
                        if (genderPref !== 'all' && !genderTypes.includes(genderPref)) return false;
                    }
                    return true;
                });
            }

