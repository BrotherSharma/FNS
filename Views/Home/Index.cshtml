            window.openMoreResourcesModal = function () {
                const modal = document.getElementById('moreResourcesModal');
                const list = document.getElementById('moreResourcesList');
                if (!modal || !list) return;

                const renderResources = (resources) => resources.map(item => `
                    <div class="exercise-popup-card">
                        <img src="${item.image}" alt="${escapeHtml(item.name)}" onerror="this.onerror=null; this.src='https://via.placeholder.com/400x260?text=Image+Unavailable';" />
