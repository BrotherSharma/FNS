            window.closeMoreResourcesModal = function () {
                const modal = document.getElementById('moreResourcesModal');
                if (modal) {
                    modal.style.display = 'none';
                    document.body.style.overflow = '';
                }
            };

            window.filterMoreResources = function () {
                const query = document.getElementById('moreResourcesSearch')?.value.trim().toLowerCase() || '';
                const list = document.getElementById('moreResourcesList');
                if (!list) return;

                const filtered = moreResources.filter(item => {
                    const haystack = `${item.name} ${item.desc} ${item.price}`.toLowerCase();
                    return haystack.includes(query);
                });

                if (!filtered.length) {
                    list.innerHTML = `<div class="exercise-popup-card" style="grid-template-columns:1fr; text-align:center;"><p style="margin:0; padding:30px 0; color:var(--text-muted);">No items match your search. Try keywords like fitness, protein, or plan.</p></div>`;
                    return;
                }

                list.innerHTML = filtered.map(item => `
                    <div class="exercise-popup-card">
                        <img src="${item.image}" alt="${escapeHtml(item.name)}" onerror="this.onerror=null; this.src='https://via.placeholder.com/400x260?text=Image+Unavailable';" />
                        <div>
                            <h5>${escapeHtml(item.name)}</h5>
                            <p>${escapeHtml(item.desc)}</p>
                            <div style="display:flex; gap:8px; flex-wrap:wrap; margin-top:8px;">
                                ${item.amazonLink ? `<a href="${item.amazonLink}" target="_blank" rel="noopener noreferrer" class="btn-profile-outline">Amazon</a>` : ''}
                                ${item.flipkartLink ? `<a href="${item.flipkartLink}" target="_blank" rel="noopener noreferrer" class="btn-profile-outline">Flipkart</a>` : ''}
                            </div>
                        </div>
                    </div>
                `).join('');
            };

            document.querySelectorAll('#exercise [data-exercise-goal]').forEach(btn => {
                btn.addEventListener('click', () => {
                    exerciseState.planGoal = btn.dataset.exerciseGoal;
                    saveExerciseState();
                    renderExercisePlan(btn.dataset.exerciseGoal);
                });
            });
            document.getElementById('exerciseSearch')?.addEventListener('input', renderExerciseLibrary);
            document.getElementById('exerciseFilter')?.addEventListener('change', renderExerciseLibrary);
            renderExercisePlan(exerciseState.planGoal || 'maintain');

            // Initial load of user attributes
            try {
                const response = await fetch(`/User/streak?email=${encodeURIComponent(Email)}`);
                if (response.ok) {
                    const data = await response.json();
                    const streakCount = data.streak ?? 0;
                    const dob = data.dob;
                    const goal = data.goal || 'Weight Loss';
                    window.FNSUserDiet = (data.diet || window.FNSUserDiet || 'Non-Veg').toString();
                    window.FNSUserGender = (data.gender || window.FNSUserGender || 'all').toString();
                    
                    let Age = data.age || "23";
                    if (!data.age && dob) {
                        let [d, m, y] = dob.split(" ")[0].split("-");
                        let birthDate = new Date(y, m - 1, d);
                        let today = new Date();
                        let computedAge = today.getFullYear() - birthDate.getFullYear();
                        if (today.getMonth() < birthDate.getMonth() || (today.getMonth() === birthDate.getMonth() && today.getDate() < birthDate.getDate())) {
                            computedAge--;
                        }
                        Age = computedAge;
                    }

                    document.getElementById("streakText").textContent = `${streakCount}-day`;
                    document.getElementById("streakTextprofile").textContent = streakCount;
                    document.getElementById("Age").textContent = Age;
                    document.getElementById("goal").textContent = goal;
                    
                    // Profile stats (Days Completed & Remaining - Current Month)
                    const currentDate = new Date();
                    const daysCompleted = currentDate.getDate(); 
                    const daysInMonth = new Date(currentDate.getFullYear(), currentDate.getMonth() + 1, 0).getDate();
                    const daysRemaining = daysInMonth - daysCompleted;
                    
                    document.getElementById("profileDaysCompleted").textContent = daysCompleted;
                    document.getElementById("profileDaysRemaining").textContent = daysRemaining;
                    
                    // Update remaining dash circle
                    const circleDash = document.getElementById('profileRemainingCircleDash');
                    if (circleDash) {
                        const pctCompleted = (daysCompleted / daysInMonth) * 100;
                        const offset = 100 - pctCompleted;
                        circleDash.setAttribute('stroke-dashoffset', offset);
                        
                        document.getElementById('goalPercentText').textContent = `${Math.round(pctCompleted)}%`;
                        document.getElementById('goalProgressBarFill').style.width = `${pctCompleted}%`;
                    }

                    // Calculate BMI
                    const weightKg = data.weight || 0;
                    const heightCm = data.height || 0;
                    if (weightKg > 0 && heightCm > 0) {
                        const heightM = heightCm / 100;
                        const bmi = weightKg / (heightM * heightM);
                        document.getElementById("profileBmiValue").textContent = bmi.toFixed(1);
                        
                        let colorHex = "#8aa6ba"; // default gray
                        let bgHex = "#eef4f7";
                        if (bmi < 18.5) {
                            colorHex = "#3b82f6"; bgHex = "#eff6ff";
                        } else if (bmi < 25) {
                            colorHex = "#10b981"; bgHex = "#ecfdf5";
                        } else if (bmi < 30) {
                            colorHex = "#f59e0b"; bgHex = "#fffbeb";
                        } else {
                            colorHex = "#ef4444"; bgHex = "#fef2f2";
                        }
                        document.getElementById("profileBmiCategory").textContent = "BMI";
                        document.getElementById("profileBmiCategory").style.color = colorHex;
                        document.getElementById("bmiIconBox").style.color = colorHex;
                        document.getElementById("bmiIconBox").style.backgroundColor = bgHex;
                    } else {
                        document.getElementById("profileBmiValue").textContent = "N/A";
                        document.getElementById("profileBmiCategory").textContent = "BMI";
                    }

                    // Pre-populate Edit Profile form
                    if (document.getElementById("editGoal")) document.getElementById("editGoal").value = goal;
                    if (document.getElementById("editWeight") && weightKg > 0) document.getElementById("editWeight").value = weightKg;
                    if (document.getElementById("editHeight") && heightCm > 0) document.getElementById("editHeight").value = heightCm;
                    if (document.getElementById("editAge")) document.getElementById("editAge").value = Age;
                    if (document.getElementById("editGender") && data.gender) document.getElementById("editGender").value = data.gender;
                    if (document.getElementById("editDiet") && data.diet) document.getElementById("editDiet").value = data.diet;
                    if (document.getElementById("editLifestyle") && data.lifestyle) document.getElementById("editLifestyle").value = data.lifestyle;
                    if (document.getElementById("editBloodType") && data.bloodType) document.getElementById("editBloodType").value = data.bloodType;
                    if (document.getElementById("editSleep") && data.sleepPatterns > 0) document.getElementById("editSleep").value = data.sleepPatterns;

                    if (document.getElementById("exerciseAge")) document.getElementById("exerciseAge").value = Age;
                    if (document.getElementById("exerciseWeight") && weightKg > 0) document.getElementById("exerciseWeight").value = weightKg;
                    if (document.getElementById("exerciseHeight") && heightCm > 0) document.getElementById("exerciseHeight").value = heightCm;
                    if (document.getElementById("burnWeight") && weightKg > 0) document.getElementById("burnWeight").value = weightKg;

                    exerciseState.planGoal = goalKeyFromText(goal);
                    saveExerciseState();
                    renderExercisePlan(exerciseState.planGoal);
                }
            } catch (err) { console.error("Error loading user profile details", err); }

            // Calorie doughnut config
            const calorieCtx = document.getElementById('calorieProgressChart').getContext('2d');
            const calorieChart = new Chart(calorieCtx, {
                type: 'doughnut',
                data: {
                    labels: ['Consumed', 'Remaining'],
                    datasets: [{
                        data: [0, 2000],
                        backgroundColor: ['#0f4c3a', '#eef8f3'],
                        borderWidth: 0,
                        hoverOffset: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '80%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });

            // Daily bar progress config
            const goalCtx = document.getElementById('goalCompletionChart').getContext('2d');
            const goalChart = new Chart(goalCtx, {
                type: 'bar',
                data: {
                    labels: ['Consumed', 'Remaining'],
                    datasets: [{
                        data: [0, 2000],
                        backgroundColor: ['#0f4c3a', '#fca5a5'],
                        borderRadius: 8,
                        barThickness: 32
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: { display: false, beginAtZero: true },
                        x: { grid: { display: false } }
                    }
                }
            });

            // Load today's logs
            async function loadDailyNutrition() {
                try {
                    const resp = await fetch(`/api/nutrition/daily?email=${encodeURIComponent(Email)}`);
                    if (resp.ok) {
                        const data = await resp.json();
                        const consumed = data.calories ?? 0;
                        const p = data.protein ?? 0;
                        const c = data.carbs ?? 0;
                        const f = data.fat ?? 0;
                        
                        // Hydration calculations incorporating local offset
                        const serverHydration = data.hydration ?? 0;
                        const localOffset = parseFloat(localStorage.getItem('localWater_' + todayStr)) || 0;
                        const finalHydration = Math.round((serverHydration + localOffset) * 10) / 10;

                        document.getElementById('caloriesConsumed').textContent = consumed;
                        document.getElementById('proteinCount').textContent = p;
                        document.getElementById('carbCount').textContent = c;
                        document.getElementById('fatCount').textContent = f;
                        document.getElementById('hydrationAmount').textContent = finalHydration;
                        
                        // Glass animation fill
                        const glassFill = document.getElementById('glassWaterFill');
                        if (glassFill) {
                            const percent = Math.min(100, (finalHydration / 2.5) * 100);
                            glassFill.style.height = `${percent}%`;
                        }

                        // Chart inputs
                        document.getElementById('chartCalConsumed').textContent = `${consumed} kcal`;

                        updateChartsWithData(consumed);
                        updateMacroBars();
                    }
                } catch (err) { console.error('Error loading daily summary logs', err); }
            }

            // Sync consumed with calorie circles/bars
            async function updateChartsWithData(consumedVal) {
                try {
                    const goalResp = await fetch(`/api/nutrition/goal?email=${encodeURIComponent(Email)}`);
                    if (goalResp.ok) {
                        const gData = await goalResp.json();
                        const goal = gData.calories ?? 2000;
                        const remaining = Math.max(0, goal - consumedVal);
                        
                        // Circle text update
                        const circle = document.getElementById('calorieProgressCircle');
                        if (circle) {
                            const percentage = Math.min(100, (consumedVal / goal) * 100);
                            circle.style.setProperty('--progress', `${percentage}%`);
                        }
                        
                        document.getElementById('caloriesGoalText').textContent = goal.toLocaleString();
                        document.getElementById('chartCalRemaining').textContent = `${remaining} kcal`;
                        document.getElementById('chartCalGoal').textContent = `${goal} kcal`;

                        if (calorieChart) {
                            calorieChart.data.datasets[0].data = [consumedVal, remaining];
                            calorieChart.update();
                        }
                        if (goalChart) {
                            goalChart.data.datasets[0].data = [consumedVal, remaining];
                            goalChart.update();
                        }
                    }
                } catch (err) { console.error('Failed to update progress charts', err); }
            }

            // Sync macro fills
            function updateMacroBars() {
                const consumedP = parseFloat(document.getElementById('proteinCount').textContent) || 0;
                const consumedC = parseFloat(document.getElementById('carbCount').textContent) || 0;
                const consumedF = parseFloat(document.getElementById('fatCount').textContent) || 0;
                
                const goalP = parseFloat(document.getElementById('goalProtein').textContent) || 100;
                const goalC = parseFloat(document.getElementById('goalCarbs').textContent) || 250;
                const goalF = parseFloat(document.getElementById('goalFat').textContent) || 70;
                
                document.getElementById('macroProteinTarget').textContent = `${goalP}g`;
                document.getElementById('macroCarbsTarget').textContent = `${goalC}g`;
                document.getElementById('macroFatTarget').textContent = `${goalF}g`;
                
                const pctP = Math.min(100, (consumedP / goalP) * 100);
                const pctC = Math.min(100, (consumedC / goalC) * 100);
                const pctF = Math.min(100, (consumedF / goalF) * 100);
                
                document.getElementById('proteinBarFill').style.width = `${pctP}%`;
                document.getElementById('carbsBarFill').style.width = `${pctC}%`;
                document.getElementById('fatBarFill').style.width = `${pctF}%`;
            }

            async function loadUserGoal() {
                try {
                    const resp = await fetch(`/api/nutrition/goal?email=${encodeURIComponent(Email)}`);
                    if (resp.ok) {
                        const d = await resp.json();
                        document.getElementById('goalCalories').textContent = d.calories ?? 2000;
                        document.getElementById('goalProtein').textContent = d.protein ?? 100;
                        document.getElementById('goalCarbs').textContent = d.carbs ?? 250;
                        document.getElementById('goalFat').textContent = d.fat ?? 70;
                        if (d.message) document.getElementById('motd').textContent = d.message;
                        updateMacroBars();
                    }
                } catch (err) { console.error('Failed to load targets', err); }
            }

            async function loadSuggestions() {
                try {
                    const resp = await fetch(`/api/nutrition/suggestions?email=${encodeURIComponent(Email)}`);
                    if (resp.ok) {
                        const data = await resp.json();
                        if (data.suggestion) {
                            document.getElementById('suggestionsText').textContent = data.suggestion;
                        }
                    }
                } catch (err) { console.error('Failed to load suggestions', err); }
            }

            // Food analyzer logic
            window.analyzeFood = async function () {
                const foodDesc = document.getElementById("foodDescriptionInput").value;
                const btn = document.getElementById("analyzeFoodButton");
                const ldr = document.getElementById("analyzeFoodLoader");

                if (!foodDesc.trim()) {
                    Swal.fire('Input Error', 'Please write a food description.', 'info');
                    return;
                }

                btn.disabled = true;
                ldr.style.display = "inline-block";

                try {
                    const response = await fetch('/api/nutrition/analyze', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ description: foodDesc })
                    });

                    if (!response.ok) throw new Error("Analysis failed.");
                    const data = await response.json();

                    Swal.fire({
                        icon: 'success',
                        title: 'Food Analyzed!',
                        html: `<div style="text-align: left; font-size:14px; padding: 10px 20px;">
                                <strong>Calories:</strong> ${data.calories} kcal<br/>
                                <strong>Protein:</strong> ${data.protein} g<br/>
                                <strong>Carbs:</strong> ${data.carbs} g<br/>
                                <strong>Fat:</strong> ${data.fat} g
                               </div>`
                    });
                    document.getElementById("foodDescriptionInput").value = '';
                    loadDailyNutrition();
                } catch (err) {
                    console.error(err);
                    Swal.fire('Error', 'Failed to analyze food. Try again.', 'error');
                } finally {
                    ldr.style.display = "none";
                    btn.disabled = false;
                }
            };

            // Profile togglers
            window.toggleEditProfile = function () {
                const form = document.getElementById('editProfileForm');
                if (form) form.style.display = form.style.display === 'none' ? 'block' : 'none';
            };

            window.saveProfileChanges = async function() {
                const firstName = document.getElementById('editFirstName').value.trim();
                const lastName = document.getElementById('editLastName').value.trim();
                const goal = document.getElementById('editGoal').value;
                const weight = document.getElementById('editWeight').value;
                const height = document.getElementById('editHeight').value;
                const diet = document.getElementById('editDiet').value;
                const lifestyle = document.getElementById('editLifestyle').value;
                const sleep = document.getElementById('editSleep').value;

                if (!firstName || !lastName || !goal) {
                    Swal.fire('Profile Error', 'Please fill in all required fields (Name, Goal)', 'warning');
                    return;
                }

                try {
                    const formData = new FormData();
                    formData.append('email', Email);
                    formData.append('firstName', firstName);
                    formData.append('lastName', lastName);
                    formData.append('goal', goal);
                    if (weight) formData.append('weight', weight);
                    if (height) formData.append('height', height);
                    if (diet) formData.append('diet', diet);
                    if (lifestyle) formData.append('lifestyle', lifestyle);
                    if (sleep) formData.append('sleepPatterns', sleep);

                    const response = await fetch('/User/UpdateProfile', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();
                    if (data.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Profile updated!',
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 1500
                        }).then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', data.message, 'error');
                    }
                } catch (error) {
                    console.error('Error updating profile:', error);
                    Swal.fire('Error', 'Unable to save profile.', 'error');
                }
            };

            window.uploadProfileImage = async function (profileImage) {
                if (!profileImage) return;

                if (profileImage.size > 1024 * 1024) {
                    Swal.fire('File limit exceeded', 'Avatar image must be 1 MB or smaller.', 'warning');
                    document.getElementById('profileImageInput').value = '';
                    return;
                }

                const formData = new FormData();
                formData.append('email', Email);
                formData.append('profileImage', profileImage);

                try {
                    const response = await fetch('/User/UpdateProfileImage', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();
                    if (data.success) {
                        const avatar = document.getElementById('profileAvatarImage');
                        if (avatar) avatar.src = data.profileImagePath || '@DefaultAvatarSrc';
                        document.getElementById('profileImageInput').value = '';
                        Swal.fire('Avatar Updated!', 'New profile image loaded successfully.', 'success');
                        return;
                    }
                    Swal.fire('Upload Failed', data.message, 'error');
                    document.getElementById('profileImageInput').value = '';
                } catch (error) {
                    console.error('Error updating profile image:', error);
                    Swal.fire('Error', 'Unable to upload image.', 'error');
                    document.getElementById('profileImageInput').value = '';
                }
            };

            window.removeProfileImage = async function () {
                const confirmed = await Swal.fire({
                    title: 'Remove Avatar?',
                    text: "Revert back to the default profile image?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: 'var(--primary)',
                    cancelButtonColor: '#ef4444',
                    confirmButtonText: 'Yes, remove it'
                });

                if (!confirmed.isConfirmed) return;

                try {
                    const formData = new FormData();
                    formData.append('email', Email);

                    const response = await fetch('/User/RemoveProfileImage', {
                        method: 'POST',
                        body: formData
                    });

                    const data = await response.json();
                    if (data.success) {
                        document.getElementById('profileAvatarImage').src = '@DefaultAvatarSrc';
                        Swal.fire('Avatar Removed', 'Profile image reset back to default.', 'success');
                        return;
                    }
                    Swal.fire('Remove Failed', data.message, 'error');
                } catch (error) {
                    console.error('Error removing profile image:', error);
                    Swal.fire('Error', 'Unable to remove image.', 'error');
                }
            };

            // Logout interceptor with delay
            document.getElementById("logoutForm")?.addEventListener("submit", function (e) {
                e.preventDefault();
                Swal.fire({
                    icon: 'info',
                    title: 'We’ll Miss You!',
                    text: 'Keep nourishing your body!',
                    toast: true,
                    position: 'top-end',
                    showConfirmButton: false,
                    timer: 3000,
                    timerProgressBar: true
                });
                setTimeout(() => { window.location.href = '/User/Logout'; }, 3000);
            });

            // Redirect simple fallback names if needed
            if (Name === "user" || Email === "user@gmail.com") {
                window.location.href = '/Home/Index';
            }

            // Initial fetches
            loadDailyNutrition();
            loadUserGoal();
            loadSuggestions();
            updateDashboardStats();
        });
    </script>
</body>
</html>
