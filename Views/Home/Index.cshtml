                                <h3 style="font-size:16px; font-weight:700; margin:0;"><i class="fas fa-box-open" style="color:var(--primary); margin-right:6px;"></i>Gym Products</h3>
                                <button type="button" onclick="openMoreResourcesModal()" class="btn-profile-outline" style="font-size:13px; padding:8px 12px; white-space:nowrap;">Gym & Diet Resources</button>
