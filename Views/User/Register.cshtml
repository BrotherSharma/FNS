@model FNS.Models.Register
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <link rel="shortcut icon" href="/Logo/cp.png" />
    <title>ReserveEase - Register</title>

    <!-- Bootstrap for simple layout -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>

    <style>
        body { background: #f1f5f9; overflow: auto}
        .card-center { max-width: 520px; margin: 48px auto; padding: 20px; border-radius: 8px; background: #fff; box-shadow: 0 6px 20px rgba(16,24,40,0.06); }
        .brand-logo { height:48px; display:block; margin: 0 auto 8px; }
        .form-control { height: calc(2.2em + .75rem + 2px); }
        .error-message { color: #d9534f; font-size: 0.9rem; margin-top:6px; display:block; min-height:18px; }
        .muted { color:#6b7280; }
    </style>
</head>

<body>
    <div class="container">
        <div class="card-center">
            <img src="/logo/logoo.jpeg" class="brand-logo" alt="Logo" />
            <h3 class="text-center mb-3">Create Account</h3>

            <form id="registerForm" method="post" novalidate>
                
                <div class="mt-2">
                    <input asp-for="c_firstname" class="form-control" placeholder="First name" autocomplete="given-name" />
                    <span id="firstNameValidateMessage" class="error-message" hidden></span>
                </div>
                <div class="mt-2">
                    <input asp-for="c_lastname" class="form-control" placeholder="Last name" autocomplete="family-name" />
                    <span id="lastNameValidateMessage" class="error-message" hidden></span>
                </div>

                <div class="mt-2">
                    <input asp-for="c_username" class="form-control" placeholder="Username" autocomplete="username" />
                    <span id="usernameValidateMessage" class="error-message" hidden></span>
                </div>

                <div class="mt-2">
                    <input asp-for="c_email" type="email" class="form-control" placeholder="Email" autocomplete="email" style="margin-bottom: 20px; border: 1px solid #ccc;" />
                    <span id="emailIdValidateMessage" class="error-message" hidden></span>
                </div>

                <div class="mt-2">
                    <input asp-for="c_password" type="password" class="form-control" placeholder="Password" autocomplete="new-password" style="margin-bottom: 20px; border: 1px solid #ccc;" />
                    <span id="passwordValidateMessage" class="error-message" hidden></span>
                </div>

                <div class="mt-2">
                    <input type="password" class="form-control" placeholder="Confirm password" id="c_confirmPassword" name="c_confirmPassword" autocomplete="new-password" style="margin-bottom: 20px; border: 1px solid #ccc;" />
                    <span id="confirmPasswordValidateMessage" class="error-message" hidden></span>
                </div>

                <div class="mt-2">
                    <select id="c_gender" name="c_gender" class="form-control" style="margin-bottom: 20px; border: 1px solid #ccc;">
                        <option value="">Select Gender</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                        <option value="Other">Other</option>
                    </select>
                    <span id="genderValidateMessage" class="error-message" hidden></span>
                </div>
                <div class="mt-2">
                    <input type="date" class="form-control" id="c_dob" name="c_dob" placeholder="Date of Birth" style="margin-bottom: 20px; border: 1px solid #ccc;" />
                    <span id="dobValidateMessage" class="error-message" hidden></span>
                </div>

                <div class="d-grid gap-2 mt-3">
                    <button type="button" id="registerBtn" class="btn btn-primary">Register</button>
                </div>

                <div class="text-center mt-3 muted small">Already have an account? <a href="/User/Login">Sign in</a></div>
            </form>
        </div>
    </div>

    <script>
        $(function() {
            function clearErrors() {
                $('#firstNameValidateMessage').text('');
                $('#lastNameValidateMessage').text('');
                $('#usernameValidateMessage').text('');
                $('#emailIdValidateMessage').text('');
                $('#passwordValidateMessage').text('');
                $('#confirmPasswordValidateMessage').text('');
                $('#genderValidateMessage').text('');
                $('#dobValidateMessage').text('');
            }

            function validateForm() {
                clearErrors();
                let ok = true;
                const first = $('#c_firstname').val().trim();
                const last = $('#c_lastname').val().trim();
                const user = $('#c_username').val().trim();
                const email = $('#c_email').val().trim();
                const pass = $('#c_password').val().trim();
                const conf = $('#c_confirmPassword').val().trim();
                const gender = $('#c_gender').val().trim();
                const dob = $('#c_dob').val().trim();

                if (!first) {
                    $('#firstNameValidateMessage').text('First name is required.').removeAttr('hidden');
                    ok = false;
                }

                if (!last) {
                    $('#lastNameValidateMessage').text('Last name is required.').removeAttr('hidden');
                    ok = false;
                }

                if (!user) {
                    $('#usernameValidateMessage').text('Username is required.').removeAttr('hidden');
                    ok = false;
                }

                if (!email) {
                    $('#emailIdValidateMessage').text('Email is required.').removeAttr('hidden');
                    ok = false;
                }

                if (!pass) {
                    $('#passwordValidateMessage').text('Password is required.').removeAttr('hidden');
                    ok = false;
                }
                else if (pass.length < 6) {
                    $('#passwordValidateMessage').text('Password must be at least 6 characters.').removeAttr('hidden');
                    ok = false;
                }

                if (!conf) {
                    $('#confirmPasswordValidateMessage').text('Confirm your password.').removeAttr('hidden');
                    ok = false;
                }
                else if (pass !== conf) {
                    $('#confirmPasswordValidateMessage').text('Passwords do not match.').removeAttr('hidden');
                    ok = false;
                }

                if (!gender) {
                    $('#genderValidateMessage').text('Gender is required.').removeAttr('hidden');
                    ok = false;
                }

                if (!dob) {
                    $('#dobValidateMessage').text('Date of birth is required.').removeAttr('hidden');
                    ok = false;
                }

                return ok;
            }

            $('#registerBtn').on('click', function(e) {
                e.preventDefault();
                if (!validateForm()) return;

                const payload = {
                    c_firstname: $('#c_firstname').val(),
                    c_lastname: $('#c_lastname').val(),
                    c_username: $('#c_username').val(),
                    c_email: $('#c_email').val(),
                    c_password: $('#c_password').val(),
                    c_gender: $('#c_gender').val(),
                    c_dob: $('#c_dob').val()
                };

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/User/RegisterUser',
                    method: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': token },
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if (res && res.success) {
                            Swal.fire({ icon: 'success', title: 'Registered', toast: true, position: 'top-end', showConfirmButton: false, timer: 1800 });
                            setTimeout(function() { window.location.href = '/User/Improve'; }, 1400);
                        } else {
                            Swal.fire({ icon: 'error', title: 'Registration failed', text: res?.message || 'Please try again.' });
                        }
                    },
                    error: function() { Swal.fire({ icon: 'error', title: 'Error', text: 'Server error. Try later.' }); }
                });
            });
        });
    </script>

</body>

</html>
