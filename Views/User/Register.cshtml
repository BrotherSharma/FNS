@model FNS.Models.Register
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <link rel="shortcut icon" href="/Logo/cp.png" />
    <title>Create Account - NutrInfo FNS</title>

    <!-- Google Fonts & FontAwesome -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <!-- Bootstrap & SweetAlert -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>

    <link href="/css/fns-ui.css" rel="stylesheet" />
</head>

<body class="fns-auth-shell">
    <div class="container" style="max-width: 600px;">
        <div class="card-center" style="max-width: 600px;">
            <div class="text-center mb-4">
                <img src="/Logo/nutrinfo-logo.png" class="brand-logo" alt="NutrInfo Logo" style="height: 52px; object-fit: contain; margin-bottom: 12px;" />
                <h3 class="mb-1">Create Your Account</h3>
                <p class="muted">Join NutrInfo FNS and start your wellness journey</p>
            </div>

            <form id="registerForm" method="post" novalidate>
                
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="c_firstname" class="form-label text-secondary small fw-semibold mb-1">First Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-user"></i></span>
                            <input asp-for="c_firstname" class="form-control border-start-0" placeholder="First name" autocomplete="given-name" style="border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;" />
                        </div>
                        <span id="firstNameValidateMessage" class="error-message" hidden></span>
                    </div>

                    <div class="col-md-6">
                        <label for="c_lastname" class="form-label text-secondary small fw-semibold mb-1">Last Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-user"></i></span>
                            <input asp-for="c_lastname" class="form-control border-start-0" placeholder="Last name" autocomplete="family-name" style="border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;" />
                        </div>
                        <span id="lastNameValidateMessage" class="error-message" hidden></span>
                    </div>
                </div>

                <div class="mt-3">
                    <label for="c_username" class="form-label text-secondary small fw-semibold mb-1">Username</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-at"></i></span>
                        <input asp-for="c_username" class="form-control border-start-0" placeholder="johndoe" autocomplete="username" style="border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;" />
                    </div>
                    <span id="usernameValidateMessage" class="error-message" hidden></span>
                </div>

                <div class="mt-3">
                    <label for="c_email" class="form-label text-secondary small fw-semibold mb-1">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-envelope"></i></span>
                        <input asp-for="c_email" type="email" class="form-control border-start-0" placeholder="name@example.com" autocomplete="email" style="border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;" />
                    </div>
                    <span id="emailIdValidateMessage" class="error-message" hidden></span>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label for="c_password" class="form-label text-secondary small fw-semibold mb-1">Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-lock"></i></span>
                            <input asp-for="c_password" type="password" class="form-control border-start-0" placeholder="••••••••" autocomplete="new-password" style="border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;" />
                        </div>
                        <span id="passwordValidateMessage" class="error-message" hidden></span>
                    </div>

                    <div class="col-md-6">
                        <label for="c_confirmPassword" class="form-label text-secondary small fw-semibold mb-1">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-shield-alt"></i></span>
                            <input type="password" class="form-control border-start-0" placeholder="••••••••" id="c_confirmPassword" name="c_confirmPassword" autocomplete="new-password" style="border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;" />
                        </div>
                        <span id="confirmPasswordValidateMessage" class="error-message" hidden></span>
                    </div>
                </div>

                <div class="row g-3 mt-1">
                    <div class="col-md-6">
                        <label for="c_gender" class="form-label text-secondary small fw-semibold mb-1">Gender</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-venus-mars"></i></span>
                            <select id="c_gender" name="c_gender" class="form-control border-start-0" style="border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;">
                                <option value="">Select Gender</option>
                                <option value="Male">Male</option>
                                <option value="Female">Female</option>
                                <option value="Other">Other</option>
                            </select>
                        </div>
                        <span id="genderValidateMessage" class="error-message" hidden></span>
                    </div>

                    <div class="col-md-6">
                        <label for="c_dob" class="form-label text-secondary small fw-semibold mb-1">Date of Birth</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-calendar-alt"></i></span>
                            <input type="date" class="form-control border-start-0" id="c_dob" name="c_dob" style="border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;" />
                        </div>
                        <span id="dobValidateMessage" class="error-message" hidden></span>
                    </div>
                </div>

                <div class="d-grid mt-4">
                    <button type="button" id="registerBtn" class="btn btn-primary shadow-sm py-2">
                        <span>Complete Registration</span>
                        <i class="fas fa-user-plus ms-2"></i>
                    </button>
                </div>

                <div class="divider-or d-flex align-items-center gap-3 my-3">
                    <hr class="flex-grow-1 m-0" style="border-color: #cbd5e1;" />
                    <span class="text-uppercase text-muted fw-bold" style="font-size: 11px; letter-spacing: 1px;">OR</span>
                    <hr class="flex-grow-1 m-0" style="border-color: #cbd5e1;" />
                </div>

                <div class="d-grid mb-3">
                    <a href="/User/GoogleLogin" id="googleRegisterBtn" class="btn btn-light d-flex align-items-center justify-content-center gap-2 py-2 px-3 border" style="border-radius: 12px; font-size: 14.5px; font-weight: 600; color: #334155; background: #ffffff; box-shadow: 0 2px 6px rgba(0,0,0,0.05); transition: all 0.25s ease;">
                        <svg width="20" height="20" viewBox="0 0 48 48">
                            <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                            <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                            <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                            <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            <path fill="none" d="M0 0h48v48H0z"/>
                        </svg>
                        <span>Continue with Google</span>
                    </a>
                </div>

                <div class="text-center small text-secondary">
                    <span>Already have an account? </span>
                    <a href="/User/Login" class="fw-bold text-success text-decoration-none">Sign In</a>
                </div>
            </form>
        </div>
    </div>

    <script>
        $(function() {
            function clearErrors() {
                $('#firstNameValidateMessage').text('').attr('hidden', true);
                $('#lastNameValidateMessage').text('').attr('hidden', true);
                $('#usernameValidateMessage').text('').attr('hidden', true);
                $('#emailIdValidateMessage').text('').attr('hidden', true);
                $('#passwordValidateMessage').text('').attr('hidden', true);
                $('#confirmPasswordValidateMessage').text('').attr('hidden', true);
                $('#genderValidateMessage').text('').attr('hidden', true);
                $('#dobValidateMessage').text('').attr('hidden', true);
            }

            function validateForm() {
                clearErrors();
                let ok = true;
                const first = $('#c_firstname').val().trim();
                const last = $('#c_lastname').val().trim();
                const user = $('#c_username').val().trim();
                const email = $('#c_email').val().trim();
                const pass = $('#c_password').val().trim();
                const conf = $('#c_confirmPassword').val().trim();
                const gender = $('#c_gender').val().trim();
                const dob = $('#c_dob').val().trim();

                if (!first) {
                    $('#firstNameValidateMessage').text('First name is required.').removeAttr('hidden');
                    ok = false;
                }

                if (!last) {
                    $('#lastNameValidateMessage').text('Last name is required.').removeAttr('hidden');
                    ok = false;
                }

                if (!user) {
                    $('#usernameValidateMessage').text('Username is required.').removeAttr('hidden');
                    ok = false;
                }

                if (!email) {
                    $('#emailIdValidateMessage').text('Email is required.').removeAttr('hidden');
                    ok = false;
                }

                if (!pass) {
                    $('#passwordValidateMessage').text('Password is required.').removeAttr('hidden');
                    ok = false;
                }
                else if (pass.length < 6) {
                    $('#passwordValidateMessage').text('Password must be at least 6 characters.').removeAttr('hidden');
                    ok = false;
                }

                if (!conf) {
                    $('#confirmPasswordValidateMessage').text('Confirm your password.').removeAttr('hidden');
                    ok = false;
                }
                else if (pass !== conf) {
                    $('#confirmPasswordValidateMessage').text('Passwords do not match.').removeAttr('hidden');
                    ok = false;
                }

                if (!gender) {
                    $('#genderValidateMessage').text('Gender is required.').removeAttr('hidden');
                    ok = false;
                }

                if (!dob) {
                    $('#dobValidateMessage').text('Date of birth is required.').removeAttr('hidden');
                    ok = false;
                }

                return ok;
            }

            $('#registerBtn').on('click', function(e) {
                e.preventDefault();
                if (!validateForm()) return;

                const payload = {
                    c_firstname: $('#c_firstname').val(),
                    c_lastname: $('#c_lastname').val(),
                    c_username: $('#c_username').val(),
                    c_email: $('#c_email').val(),
                    c_password: $('#c_password').val(),
                    c_gender: $('#c_gender').val(),
                    c_dob: $('#c_dob').val()
                };

                var token = $('input[name="__RequestVerificationToken"]').val();

                $.ajax({
                    url: '/User/RegisterUser',
                    method: 'POST',
                    contentType: 'application/json',
                    headers: { 'RequestVerificationToken': token },
                    data: JSON.stringify(payload),
                    success: function(res) {
                        if (res && res.success) {
                            Swal.fire({ icon: 'success', title: 'Registered successfully!', toast: true, position: 'top-end', showConfirmButton: false, timer: 1800 });
                            setTimeout(function() { window.location.href = '/User/Improve'; }, 1400);
                        } else {
                            Swal.fire({ icon: 'error', title: 'Registration failed', text: res?.message || 'Please try again.' });
                        }
                    },
                    error: function() { Swal.fire({ icon: 'error', title: 'Error', text: 'Server error. Try later.' }); }
                });
            });
        });
    </script>
</body>
</html>
