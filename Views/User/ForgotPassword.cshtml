<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password - NutrInfo FNS</title>
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>
    <link href="/css/fns-ui.css" rel="stylesheet" />
</head>
<body class="fns-auth-shell">
    <div class="container">
        <div class="reset-card">
            <div class="text-center mb-4">
                <img src="/Logo/nutrinfo-logo.png" class="brand-logo" alt="NutrInfo Logo" style="height: 52px; object-fit: contain; margin-bottom: 12px;" />
                <h3 class="mb-2">Reset Password</h3>
                <p class="muted">Enter your registered email address. We will send a secure password reset link to your inbox.</p>
            </div>

            <div class="mb-4">
                <label for="email" class="form-label text-secondary small fw-semibold mb-1">Email Address</label>
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-envelope"></i></span>
                    <input type="email" id="email" class="form-control border-start-0" placeholder="name@example.com" autocomplete="email" style="border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;" />
                </div>
                <span id="emailError" class="error-message"></span>
            </div>

            <div class="d-grid mb-4">
                <button type="button" id="sendResetBtn" class="btn btn-primary shadow-sm py-2">
                    <span>Send Reset Link</span>
                    <i class="fas fa-paper-plane ms-2"></i>
                </button>
            </div>

            <div class="text-center small text-secondary">
                <a href="/User/Login" class="text-decoration-none fw-semibold text-success d-inline-flex align-items-center gap-1">
                    <i class="fas fa-arrow-left"></i>
                    <span>Back to Sign In</span>
                </a>
            </div>
        </div>
    </div>

    <script>
        $(function () {
            $('#sendResetBtn').on('click', function () {
                const email = $('#email').val().trim();
                $('#emailError').text('');

                if (!email) {
                    $('#emailError').text('Email is required.');
                    return;
                }

                $.ajax({
                    url: '/User/RequestPasswordReset',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ email: email }),
                    success: function (res) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Check your email',
                            text: res.message || 'If an account exists, a reset link has been sent.'
                        });
                    },
                    error: function (xhr) {
                        const res = xhr.responseJSON || {};
                        Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'Unable to send reset link.' });
                    }
                });
            });
        });
    </script>
</body>
</html>
