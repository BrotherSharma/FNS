<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Forgot Password - NutrInfo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>
    <style>
        body { background: #f1f5f9; min-height: 100vh; display: flex; align-items: center; }
        .reset-card { max-width: 460px; margin: 0 auto; padding: 28px; border-radius: 12px; background: #fff; box-shadow: 0 12px 34px rgba(16,24,40,0.08); }
        .reset-title { color: #2e5942; font-weight: 700; }
        .form-control { min-height: 46px; border-radius: 8px; }
        .btn-primary { background: #2e5942; border-color: #2e5942; min-height: 46px; border-radius: 8px; font-weight: 600; }
        .btn-primary:hover { background: #244a36; border-color: #244a36; }
        .muted { color: #64748b; }
    </style>
    <link href="/css/fns-ui.css" rel="stylesheet" />
</head>
<body class="fns-auth-shell">
    <div class="container">
        <div class="reset-card">
            <h3 class="text-center reset-title mb-2">Forgot Password</h3>
            <p class="text-center muted mb-4">Enter your registered email. We will send a secure password reset link.</p>

            <div class="mb-3">
                <input type="email" id="email" class="form-control" placeholder="Email address" autocomplete="email" />
                <span id="emailError" class="text-danger small"></span>
            </div>

            <div class="d-grid mb-3">
                <button type="button" id="sendResetBtn" class="btn btn-primary">Send Reset Link</button>
            </div>

            <div class="text-center small">
                <a href="/User/Login">Back to login</a>
            </div>
        </div>
    </div>

    <script>
        $(function () {
            $('#sendResetBtn').on('click', function () {
                const email = $('#email').val().trim();
                $('#emailError').text('');

                if (!email) {
                    $('#emailError').text('Email is required.');
                    return;
                }

                $.ajax({
                    url: '/User/RequestPasswordReset',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ email: email }),
                    success: function (res) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Check your email',
                            text: res.message || 'If an account exists, a reset link has been sent.'
                        });
                    },
                    error: function (xhr) {
                        const res = xhr.responseJSON || {};
                        Swal.fire({ icon: 'error', title: 'Error', text: res.message || 'Unable to send reset link.' });
                    }
                });
            });
        });
    </script>
</body>
</html>
