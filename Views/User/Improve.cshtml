@{
    ViewData["Title"] = "Personalized Nutrition Form";
    string Name = ViewBag.Name;
    string Email = ViewBag.Email;
}

@* Include Kendo UI CSS and JS files *@
<link href="https://kendo.cdn.telerik.com/2023.2.621/styles/kendo.default-v2.min.css" rel="stylesheet" />
<script src="https://kendo.cdn.telerik.com/2023.2.621/js/jquery.min.js"></script>
<script src="https://kendo.cdn.telerik.com/2023.2.621/js/kendo.all.min.js"></script>

@* Link to your external CSS and JS files *@
<link href="../../Default/css/Improve.css" rel="stylesheet" />
<!-- Include jQuery (ensure it's loaded before Kendo UI) -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>

<style>
    .improve-card {
        border-radius: 14px;
        box-shadow: 0 0 20px rgba(0,0,0,0.08);
        background: #ffffff;
        border: 1px solid #e5ebed;
        max-height: calc(100vh - 6rem);
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .improve-card .card-body {
        padding: 2rem;
        overflow-y: auto;
        overflow-x: hidden;
        max-height: calc(100vh - 6rem);
        scrollbar-width: thin;
        scrollbar-color: #8aa6ba #eef4f7;
    }

    .improve-card .card-body::-webkit-scrollbar {
        width: 10px;
    }

    .improve-card .card-body::-webkit-scrollbar-track {
        background: #eef4f7;
        border-radius: 999px;
    }

    .improve-card .card-body::-webkit-scrollbar-thumb {
        background: #8aa6ba;
        border: 2px solid #eef4f7;
        border-radius: 999px;
    }

    .improve-form .form-group {
        margin-bottom: 1rem;
    }

    .improve-form .form-control {
        border: 1px solid #ced4da;
        border-radius: .6rem;
        min-height: 44px;
        box-shadow: none;
    }

    .improve-form .form-control:focus {
        border-color: #3f80ff;
        box-shadow: 0 0 0 0.08rem rgba(63,128,255,0.2);
    }

    .improve-title {
        color: #1f3c6a;
        font-weight: 700;
        font-size: 1.7rem;
    }

    .required {
        color: #d91a2a;
        margin-left: 0.25rem;
        font-weight: 700;
    }

    .improve-action-btn {
        background: linear-gradient(90deg, #1a73e8 0%, #2f80ed 100%);
        border: none;
        border-radius: .6rem;
        font-size: 1rem;
        font-weight: 600;
        padding: .75rem 1rem;
    }

    .improve-action-btn:hover {
        background: linear-gradient(90deg, #1358c2 0%, #1f66d5 100%);
    }

    .improve-data-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1.25rem;
    }

    @@media(min-width: 768px) {
        .improve-data-list {
            grid-template-columns: 1fr 1fr;
        }
    }
</style>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-md-12">
            <div class="card shadow-lg rounded-lg improve-card">
                <div class="card-body">
                    <p class="mb-1 text-muted">Name: @Context.Session.GetString("Name")</p>
                    <p class="mb-4 text-muted">Email: @Context.Session.GetString("Email")</p>

                    <h3 class="text-center mb-4 improve-title">Personal Health Information</h3>
                    <form id="healthForm" class="improve-form">
                        <div class="row">

                            <!-- Left Portion -->
                            <div class="col-md-6">

                                <!-- Weight -->
                                <div class="form-group">
                                    <label for="weight" class="font-weight-bold">Weight (kg)<span class="required">*</span></label>
                                    <input type="number" class="form-control" id="weight" placeholder="Enter your weight" required>
                                    <small id="weightHelp" class="form-text text-muted">Your weight in kilograms.</small>
                                </div>

                                <!-- Height -->
                                <div class="form-group">
                                    <label for="height" class="font-weight-bold">Height (cm)<span class="required">*</span></label>
                                    <input type="number" class="form-control" id="height" placeholder="Enter your height" required>
                                    <small id="heightHelp" class="form-text text-muted">Your height in centimeters.</small>
                                </div>

                                <!-- Age -->
                                <div class="form-group">
                                    <label for="age" class="font-weight-bold">Age (years)<span class="required">*</span></label>
                                    <input type="number" class="form-control" id="age" placeholder="Enter your age" min="1" required>
                                    <small id="ageHelp" class="form-text text-muted">Your age in years.</small>
                                </div>

                                <!-- Goal -->
                                <div class="form-group">
                                    <label for="goal" class="font-weight-bold">Goal<span class="required">*</span></label>
                                    <select class="form-control" id="goal" required>
                                        <option value="">Select Goal</option>
                                        <option value="Weight Loss">Weight Loss</option>
                                        <option value="Maintain">Maintain</option>
                                        <option value="Gain">Weight Gain</option>
                                    </select>
                                </div>

                                <!-- Referral -->
                                <div class="form-group">
                                    <label for="referral" class="font-weight-bold">Referral</label>
                                    <input type="text" class="form-control" id="referral" placeholder="How did you hear about us?">
                                </div>
                            </div>

                            <!-- Right Portion -->
                            <div class="col-md-6">

                                <!-- Veg/Non-Veg -->
                                <div class="form-group">
                                    <label for="diet" class="font-weight-bold">Diet Preference<span class="required">*</span></label>
                                    <select class="form-control" id="diet" required>
                                        <option value="">Select Diet</option>
                                        <option value="Veg">Vegetarian</option>
                                        <option value="Non-Veg">Non-Vegetarian</option>
                                    </select>
                                </div>

                                <!-- Lifestyle -->
                                <div class="form-group">
                                    <label for="lifestyle" class="font-weight-bold">Lifestyle<span class="required">*</span></label>
                                    <select class="form-control" id="lifestyle" required>
                                        <option value="">Select Lifestyle</option>
                                        <option value="Sedentary">Sedentary</option>
                                        <option value="Active">Active</option>
                                        <option value="Hyperactive">Hyperactive</option>
                                    </select>
                                </div>

                                <!-- Blood Type -->
                                <div class="form-group">
                                    <label for="bloodType" class="font-weight-bold">Blood Type<span class="required">*</span></label>
                                    <select class="form-control" id="bloodType" required>
                                        <option value="">Select Blood Type</option>
                                        <option value="A+">A+</option>
                                        <option value="A-">A-</option>
                                        <option value="B+">B+</option>
                                        <option value="B-">B-</option>
                                        <option value="O+">O+</option>
                                        <option value="O-">O-</option>
                                        <option value="AB+">AB+</option>
                                        <option value="AB-">AB-</option>
                                    </select>
                                </div>

                                <!-- Sleep Patterns -->
                                <div class="form-group">
                                    <label for="sleepPatterns" class="font-weight-bold">Sleep Patterns (hours)<span class="required">*</span></label>
                                    <input type="number" class="form-control" id="sleepPatterns" placeholder="How many hours do you sleep on average?" required>
                                </div>

                                <!-- Alcohol Consumption -->
                                <div class="form-group">
                                    <label for="alcoholConsumption" class="font-weight-bold">Alcohol Consumption<span class="required">*</span></label>
                                    <select class="form-control" id="alcoholConsumption" required>
                                        <option value="">Select Option</option>
                                        <option value="None">None</option>
                                        <option value="Occasionally">Occasionally</option>
                                        <option value="Regularly">Regularly</option>
                                    </select>
                                </div>

                            </div>

                        </div>

                        <!-- Submit Button -->
                        <div class="form-group text-center">
                            <button type="submit" class="btn btn-primary w-100 improve-action-btn">Submit</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
<script>
    $(document).ready(function() {
        var name = '@Context.Session.GetString("Name")';
        var email = '@Context.Session.GetString("Email")';
        $('#healthForm').on('submit', function(e) {
            e.preventDefault(); // Prevent the form from submitting normally
            var age = Number($('#age').val());
            if (!age || age < 1) {
                Swal.fire({
                    icon: 'error',
                    title: 'Invalid Age',
                    text: 'Age must be greater than 0.'
                });
                $('#age').focus();
                return;
            }

            // Collect all the form data
            var formData = {
                weight: $('#weight').val(),
                height: $('#height').val(),
                age: age,
                goal: $('#goal').val(),
                referral: $('#referral').val(),
                diet: $('#diet').val(),
                lifestyle: $('#lifestyle').val(),
                bloodType: $('#bloodType').val(),
                sleepPatterns: $('#sleepPatterns').val(),
                alcoholConsumption: $('#alcoholConsumption').val(),
                name : name,
                email: email,
            };

            // Call the API via AJAX (assuming you are calling a POST method)
            $.ajax({
                url: '/Improve/SubmitHealthInfo', // Replace with your actual API endpoint
                method: 'POST',
                contentType: 'application/json', // <--- IMPORTANT: Set content type to JSON
                data: JSON.stringify(formData), 
                success: function(response) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Information Saved Successfully.',
                        text: response.message,
                        toast: true, // Enable toast style
                        position: 'top-end', // Position the toast at the top-right
                        showConfirmButton: false, // No confirm button
                        timer: 3000, 
                        timerProgressBar: true
                    });
                    if (response.success) {
                        setTimeout(function() {
                            window.location.href = '/Home/Index'; 
                        }, 3000); 
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Register Failed',
                            text: response.message || 'Something Went wrong. Please try again.'
                        });
                    }
                },
                error: function(xhr, status, error) {
                    const resp = xhr.responseJSON || {};
                    Swal.fire({
                        icon: 'error',
                        title: 'Submission Failed',
                        text: resp.message || 'Something went wrong. Please try again.'
                    });
                }
            });
        });
    });
</script>
