@{
    ViewData["Title"] = "Personalized Health Profile";
    string Name = ViewBag.Name;
    string Email = ViewBag.Email;
}

<!-- Google Fonts & FontAwesome -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>
<link href="/css/fns-ui.css" rel="stylesheet" />

<div class="container py-4 my-3">
    <div class="row justify-content-center">
        <div class="col-lg-10 col-xl-9">
            <div class="card improve-card border-0 shadow-lg" style="border-radius: 24px; background: rgba(255, 255, 255, 0.96); backdrop-filter: blur(20px);">
                <div class="card-body p-4 p-md-5">
                    
                    <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                        <div class="d-flex align-items-center gap-3">
                            <div class="bg-success text-white rounded-3 p-3 d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; background: linear-gradient(135deg, #10b981, #059669) !important; box-shadow: 0 8px 20px rgba(16,185,129,0.3);">
                                <i class="fas fa-heartbeat fs-4"></i>
                            </div>
                            <div>
                                <h3 class="m-0 improve-title fw-bold" style="font-family: 'Outfit', sans-serif;">Personal Health Profile</h3>
                                <p class="text-secondary small m-0">Tell us about your metrics to get customized recommendations</p>
                            </div>
                        </div>
                        <div class="text-end d-none d-sm-block">
                            <span class="badge bg-light text-dark px-3 py-2 border rounded-pill fw-semibold">
                                <i class="fas fa-user-circle me-1 text-success"></i> @(Context.Session.GetString("Name") ?? "User")
                            </span>
                        </div>
                    </div>

                    <form id="healthForm" class="improve-form">
                        <div class="row g-4">

                            <!-- Left Column: Biometrics & Primary Goals -->
                            <div class="col-md-6">
                                <div class="bg-light p-3 rounded-4 mb-3 border">
                                    <h6 class="fw-bold text-success mb-3"><i class="fas fa-ruler-combined me-2"></i>Biometrics</h6>

                                    <div class="form-group mb-3">
                                        <label for="weight" class="fw-semibold text-secondary small">Weight (kg)<span class="text-danger ms-1">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-weight-hanging"></i></span>
                                            <input type="number" class="form-control border-start-0" id="weight" placeholder="e.g. 70" required>
                                        </div>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label for="height" class="fw-semibold text-secondary small">Height (cm)<span class="text-danger ms-1">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-ruler-vertical"></i></span>
                                            <input type="number" class="form-control border-start-0" id="height" placeholder="e.g. 175" required>
                                        </div>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label for="age" class="fw-semibold text-secondary small">Age (years)<span class="text-danger ms-1">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-calendar-alt"></i></span>
                                            <input type="number" class="form-control border-start-0" id="age" placeholder="e.g. 25" min="1" required>
                                        </div>
                                    </div>
                                </div>

                                <div class="bg-light p-3 rounded-4 border">
                                    <h6 class="fw-bold text-success mb-3"><i class="fas fa-bullseye me-2"></i>Goal & Source</h6>

                                    <div class="form-group mb-3">
                                        <label for="goal" class="fw-semibold text-secondary small">Fitness Goal<span class="text-danger ms-1">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-trophy"></i></span>
                                            <select class="form-control border-start-0" id="goal" required>
                                                <option value="">Select Goal</option>
                                                <option value="Weight Loss">Weight Loss</option>
                                                <option value="Maintain">Maintain Weight</option>
                                                <option value="Gain">Weight Gain</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="form-group mb-2">
                                        <label for="referral" class="fw-semibold text-secondary small">Referral Source</label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-share-alt"></i></span>
                                            <input type="text" class="form-control border-start-0" id="referral" placeholder="How did you hear about us?">
                                        </div>
                                    </div>

                                    @if (Context.Session.GetString("NeedsDobAndGender") == "true")
                                    {
                                        <div class="form-group mb-3 mt-3">
                                            <label for="gender" class="fw-semibold text-secondary small">Gender<span class="text-danger ms-1">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-venus-mars"></i></span>
                                                <select class="form-control border-start-0" id="gender" required>
                                                    <option value="">Select Gender</option>
                                                    <option value="Male">Male</option>
                                                    <option value="Female">Female</option>
                                                    <option value="Other">Other</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="form-group mb-2">
                                            <label for="dob" class="fw-semibold text-secondary small">Date of Birth<span class="text-danger ms-1">*</span></label>
                                            <div class="input-group">
                                                <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-birthday-cake"></i></span>
                                                <input type="date" class="form-control border-start-0" id="dob" required>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>

                            <!-- Right Column: Lifestyle & Health Preferences -->
                            <div class="col-md-6">
                                <div class="bg-light p-3 rounded-4 mb-3 border">
                                    <h6 class="fw-bold text-success mb-3"><i class="fas fa-utensils me-2"></i>Diet & Activity</h6>

                                    <div class="form-group mb-3">
                                        <label for="diet" class="fw-semibold text-secondary small">Diet Preference<span class="text-danger ms-1">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-carrot"></i></span>
                                            <select class="form-control border-start-0" id="diet" required>
                                                <option value="">Select Diet</option>
                                                <option value="Veg">Vegetarian</option>
                                                <option value="Non-Veg">Non-Vegetarian</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="form-group mb-3">
                                        <label for="lifestyle" class="fw-semibold text-secondary small">Lifestyle Activity<span class="text-danger ms-1">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-running"></i></span>
                                            <select class="form-control border-start-0" id="lifestyle" required>
                                                <option value="">Select Lifestyle</option>
                                                <option value="Sedentary">Sedentary (Little or no exercise)</option>
                                                <option value="Active">Active (Moderate exercise)</option>
                                                <option value="Hyperactive">Hyperactive (Heavy exercise/Athlete)</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="form-group mb-2">
                                        <label for="bloodType" class="fw-semibold text-secondary small">Blood Type<span class="text-danger ms-1">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-tint text-danger"></i></span>
                                            <select class="form-control border-start-0" id="bloodType" required>
                                                <option value="">Select Blood Type</option>
                                                <option value="A+">A+</option>
                                                <option value="A-">A-</option>
                                                <option value="B+">B+</option>
                                                <option value="B-">B-</option>
                                                <option value="O+">O+</option>
                                                <option value="O-">O-</option>
                                                <option value="AB+">AB+</option>
                                                <option value="AB-">AB-</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <div class="bg-light p-3 rounded-4 border">
                                    <h6 class="fw-bold text-success mb-3"><i class="fas fa-bed me-2"></i>Sleep & Habit Factors</h6>

                                    <div class="form-group mb-3">
                                        <label for="sleepPatterns" class="fw-semibold text-secondary small">Sleep Duration (hrs/day)<span class="text-danger ms-1">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-moon"></i></span>
                                            <input type="number" class="form-control border-start-0" id="sleepPatterns" placeholder="e.g. 8" required>
                                        </div>
                                    </div>

                                    <div class="form-group mb-2">
                                        <label for="alcoholConsumption" class="fw-semibold text-secondary small">Alcohol Consumption<span class="text-danger ms-1">*</span></label>
                                        <div class="input-group">
                                            <span class="input-group-text bg-white border-end-0 text-muted"><i class="fas fa-glass-martini-alt"></i></span>
                                            <select class="form-control border-start-0" id="alcoholConsumption" required>
                                                <option value="">Select Option</option>
                                                <option value="None">None</option>
                                                <option value="Occasionally">Occasionally</option>
                                                <option value="Regularly">Regularly</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>

                        </div>

                        <!-- Submit Button -->
                        <div class="form-group text-center mt-4">
                            <button type="submit" class="btn btn-primary w-100 py-3 shadow improve-action-btn fw-bold fs-6 rounded-3">
                                <span>Save & Continue to Dashboard</span>
                                <i class="fas fa-arrow-right ms-2"></i>
                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    $(document).ready(function() {
        var name = '@Context.Session.GetString("Name")';
        var email = '@Context.Session.GetString("Email")';
        $('#healthForm').on('submit', function(e) {
            e.preventDefault();
            var age = Number($('#age').val());
            if (!age || age < 1) {
                Swal.fire({
                    icon: 'error',
                    title: 'Invalid Age',
                    text: 'Age must be greater than 0.'
                });
                $('#age').focus();
                return;
            }

            var formData = {
                weight: $('#weight').val(),
                height: $('#height').val(),
                age: age,
                goal: $('#goal').val(),
                referral: $('#referral').val(),
                diet: $('#diet').val(),
                lifestyle: $('#lifestyle').val(),
                bloodType: $('#bloodType').val(),
                sleepPatterns: $('#sleepPatterns').val(),
                alcoholConsumption: $('#alcoholConsumption').val(),
                name : name,
                email: email,
            };

            var gender = $('#gender').val();
            if (gender) formData.gender = gender;
            var dob = $('#dob').val();
            if (dob) formData.dob = dob;

            $.ajax({
                url: '/Improve/SubmitHealthInfo',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData), 
                success: function(response) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Health Profile Saved!',
                        text: response.message,
                        toast: true,
                        position: 'top-end',
                        showConfirmButton: false,
                        timer: 2500, 
                        timerProgressBar: true
                    });
                    if (response.success) {
                        setTimeout(function() {
                            window.location.href = '/Home/Index'; 
                        }, 2000); 
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Submission Failed',
                            text: response.message || 'Something went wrong. Please try again.'
                        });
                    }
                },
                error: function(xhr, status, error) {
                    const resp = xhr.responseJSON || {};
                    Swal.fire({
                        icon: 'error',
                        title: 'Submission Failed',
                        text: resp.message || 'Something went wrong. Please try again.'
                    });
                }
            });
        });
    });
</script>
