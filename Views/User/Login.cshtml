@model FNS.Models.Login
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
    <link rel="shortcut icon" href="/Logo/cp.png" />
    <title>ReserveEase - Login</title>

    <!-- Bootstrap for simple layout -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>

    <style>
        body { background: white; }
        .login-card { max-width: 420px; margin: 13% auto; padding: 24px; border-radius: 8px; background: #fff; box-shadow: 0 6px 18px rgba(0,0,0,0.08); }
        .login-logo { height:48px; display:block; margin: 0 auto 12px; }
        .form-control { height: calc(2.2em + .75rem + 2px); }
        .error-message { color: #d9534f; font-size: 0.9rem; margin-top:6px; display:block; }
        .small-links { font-size:0.9rem; }
    </style>
    <link href="/css/fns-ui.css" rel="stylesheet" />
</head>

<body class="fns-auth-shell">
    <div class="container">
        <div class="login-card">
            <img src="/logo/logoo.jpeg" class="login-logo" alt="Logo" />
            <h3 class="text-center mb-3">Sign In</h3>

            <div>
                <div class="mb-3">
                    <label for="c_email" class="form-label visually-hidden">Email</label>
                    <input type="email" class="form-control" placeholder="Email" name="c_email" id="c_email" asp-for="c_email" />
                    <span id="emailIdValidateMessage" class="error-message"></span>
                </div>

                <div class="mb-3">
                    <label for="c_password" class="form-label visually-hidden">Password</label>
                    <input type="password" class="form-control" placeholder="Password" id="c_password" name="c_password" asp-for="c_password" />
                    <span id="passwordValidateMessage" class="error-message"></span>
                </div>

                <div class="d-grid mb-2">
                    <button id="loginBtn" class="btn btn-primary">Log In</button>
                </div>

                <div class="d-flex justify-content-between small-links">
                    <a class="btn btn-link p-0" id="forgotpassword" href="/User/ForgotPassword">Forgot Password?</a>
                    <div>Don't have an account? <a href="/User/Register">Register</a></div>
                </div>
            </div>
        </div>
    </div>

    <script src="/Javascript/Validation_login.js"></script>

    <script>
        // Keep the existing inline validation & AJAX logic but ensure selectors match the simplified UI

$(document).ready(function() {
    function validateLoginForm() {
        $('#emailIdValidateMessage').text('');
        $('#passwordValidateMessage').text('');

        let isValid = true;
        const email = $('#c_email').val().trim();
        const password = $('#c_password').val().trim();

        if (email === '') {
            $('#emailIdValidateMessage').text('Email is required.').show();
            isValid = false;
        }

        if (password === '') {
            $('#passwordValidateMessage').text('Password is required.').show();
            isValid = false;
        } else if (password.length < 6) {
            $('#passwordValidateMessage').text('Password must be at least 6 characters long.').show();
            isValid = false;
        }

        return isValid;
    }

    $('#loginBtn').click(function(event) {
        event.preventDefault();
        if (validateLoginForm()) {
            const data = { c_email: $('#c_email').val(), c_password: $('#c_password').val() };
            $.ajax({
                url: '@Url.Action("Authenticate","User")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response) {
                    if (response && response.success) {
                        Swal.fire({ icon: 'success', title: 'Login Successful', toast: true, position: 'top-end', showConfirmButton: false, timer: 1500 });
                        setTimeout(function() { window.location.href = '/Home/index'; }, 500);
                    } else {
                        Swal.fire({ icon: 'error', title: 'Login Failed', text: response.message || 'Invalid email or password.' });
                    }
                },
                error: function() { Swal.fire({ icon: 'error', title: 'Error', text: 'An error occurred. Please try again later.' }); }
            });
        }
    });

    $('#c_email').on('input', function() { $('#emailIdValidateMessage').text('').hide(); });
    $('#c_password').on('input', function() { $('#passwordValidateMessage').text('').hide(); });
});
    </script>

</body>

</html>
