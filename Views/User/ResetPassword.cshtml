<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset Password - NutrInfo FNS</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>
    <link href="/css/fns-ui.css" rel="stylesheet" />
</head>
<body class="fns-auth-shell">
    <div class="container">
        <div class="reset-card">
            <div class="text-center mb-4">
                <img src="/Logo/nutrinfo-logo.png" class="brand-logo" alt="NutrInfo Logo" style="height: 52px; object-fit: contain; margin-bottom: 12px;" />
                <h3 class="mb-2">Create New Password</h3>
            </div>

            @if (!(ViewBag.IsValidToken ?? false))
            {
                <div class="alert alert-danger rounded-3 text-center border-0 p-3 mb-4" style="background:#fef2f2; color:#b91c1c;">
                    <i class="fas fa-exclamation-circle me-1"></i> This reset link is invalid or has expired.
                </div>
                <div class="text-center">
                    <a href="/User/ForgotPassword" class="btn btn-outline-secondary rounded-3 px-4 py-2 text-decoration-none fw-semibold">
                        <span>Request a New Link</span>
                    </a>
                </div>
            }
            else
            {
                <p class="text-center muted mb-4">Create a strong, new password for your NutrInfo account.</p>
                <input type="hidden" id="token" value="@ViewBag.Token" />

                <div class="mb-3">
                    <label for="password" class="form-label text-secondary small fw-semibold mb-1">New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-key"></i></span>
                        <input type="password" id="password" class="form-control border-start-0" placeholder="••••••••" autocomplete="new-password" style="border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;" />
                    </div>
                    <span id="passwordError" class="error-message"></span>
                </div>

                <div class="mb-4">
                    <label for="confirmPassword" class="form-label text-secondary small fw-semibold mb-1">Confirm New Password</label>
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-lock"></i></span>
                        <input type="password" id="confirmPassword" class="form-control border-start-0" placeholder="••••••••" autocomplete="new-password" style="border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;" />
                    </div>
                    <span id="confirmError" class="error-message"></span>
                </div>

                <div class="d-grid mb-3">
                    <button type="button" id="resetPasswordBtn" class="btn btn-primary shadow-sm py-2">
                        <span>Set New Password</span>
                        <i class="fas fa-check-circle ms-2"></i>
                    </button>
                </div>
            }
        </div>
    </div>

    <script>
        $(function () {
            $('#resetPasswordBtn').on('click', function () {
                const token = $('#token').val();
                const password = $('#password').val().trim();
                const confirmPassword = $('#confirmPassword').val().trim();
                $('#passwordError').text('');
                $('#confirmError').text('');

                if (!password || password.length < 6) {
                    $('#passwordError').text('Password must be at least 6 characters long.');
                    return;
                }

                if (password !== confirmPassword) {
                    $('#confirmError').text('Passwords do not match.');
                    return;
                }

                $.ajax({
                    url: '/User/ResetPasswordSubmit',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ token: token, password: password }),
                    success: function (res) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Password reset',
                            text: res.message || 'Password reset successfully.'
                        }).then(function () {
                            window.location.href = '/User/Login';
                        });
                    },
                    error: function (xhr) {
                        const res = xhr.responseJSON || {};
                        Swal.fire({ icon: 'error', title: 'Reset failed', text: res.message || 'Reset link is invalid or expired.' });
                    }
                });
            });
        });
    </script>
</body>
</html>
