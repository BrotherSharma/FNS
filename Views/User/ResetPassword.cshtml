<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Reset Password - NutrInfo</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>
    <style>
        body { background: #f1f5f9; min-height: 100vh; display: flex; align-items: center; }
        .reset-card { max-width: 460px; margin: 0 auto; padding: 28px; border-radius: 12px; background: #fff; box-shadow: 0 12px 34px rgba(16,24,40,0.08); }
        .reset-title { color: #2e5942; font-weight: 700; }
        .form-control { min-height: 46px; border-radius: 8px; }
        .btn-primary { background: #2e5942; border-color: #2e5942; min-height: 46px; border-radius: 8px; font-weight: 600; }
        .btn-primary:hover { background: #244a36; border-color: #244a36; }
        .muted { color: #64748b; }
    </style>
    <link href="/css/fns-ui.css" rel="stylesheet" />
</head>
<body class="fns-auth-shell">
    <div class="container">
        <div class="reset-card">
            <h3 class="text-center reset-title mb-2">Reset Password</h3>

            @if (!(ViewBag.IsValidToken ?? false))
            {
                <p class="text-center text-danger mb-4">This reset link is invalid or expired.</p>
                <div class="text-center">
                    <a href="/User/ForgotPassword">Request a new reset link</a>
                </div>
            }
            else
            {
                <p class="text-center muted mb-4">Create a new password for your NutrInfo account.</p>
                <input type="hidden" id="token" value="@ViewBag.Token" />

                <div class="mb-3">
                    <input type="password" id="password" class="form-control" placeholder="New password" autocomplete="new-password" />
                    <span id="passwordError" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <input type="password" id="confirmPassword" class="form-control" placeholder="Confirm password" autocomplete="new-password" />
                    <span id="confirmError" class="text-danger small"></span>
                </div>

                <div class="d-grid mb-3">
                    <button type="button" id="resetPasswordBtn" class="btn btn-primary">Reset Password</button>
                </div>
            }
        </div>
    </div>

    <script>
        $(function () {
            $('#resetPasswordBtn').on('click', function () {
                const token = $('#token').val();
                const password = $('#password').val().trim();
                const confirmPassword = $('#confirmPassword').val().trim();
                $('#passwordError').text('');
                $('#confirmError').text('');

                if (!password || password.length < 6) {
                    $('#passwordError').text('Password must be at least 6 characters long.');
                    return;
                }

                if (password !== confirmPassword) {
                    $('#confirmError').text('Passwords do not match.');
                    return;
                }

                $.ajax({
                    url: '/User/ResetPasswordSubmit',
                    method: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({ token: token, password: password }),
                    success: function (res) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Password reset',
                            text: res.message || 'Password reset successfully.'
                        }).then(function () {
                            window.location.href = '/User/Login';
                        });
                    },
                    error: function (xhr) {
                        const res = xhr.responseJSON || {};
                        Swal.fire({ icon: 'error', title: 'Reset failed', text: res.message || 'Reset link is invalid or expired.' });
                    }
                });
            });
        });
    </script>
</body>
</html>
