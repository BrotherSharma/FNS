@* @model FNS.Models.FoodLog *@
<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Nutrition Tracker</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@9"></script>

    <style>
        body { background: #f1f5f9; }
        .food-card { max-width: 800px; margin: 40px auto; padding: 20px; border-radius: 8px; background: #fff; box-shadow: 0 6px 18px rgba(0,0,0,0.08); }
        .modal-custom { max-width: 500px; width: 90%; }
    </style>
</head>

<body>
    <div class="container">
        <div class="food-card">
            <h3 class="mb-3">Foods Details</h3>

            <div class="d-flex mb-3 gap-2">
                <input type="search" id="foodSearch" class="form-control" placeholder="Search food..." />
                <button class="btn btn-success" id="addFoodBtn">Add Food</button>
            </div>

            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Meal</th>
                        <th>Food</th>
                        <th>Amount</th>
                        <th>Category</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody id="foodLogBody">
                    <tr><td colspan="5" class="text-center text-muted">No entries yet.</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="addModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-custom">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Add Food</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="addModalForm">
                        <div class="mb-3">
                            <label for="modalFoodName" class="form-label">Food Name</label>
                            <input type="text" class="form-control" id="modalFoodName" required>
                        </div>
                        <div class="mb-3">
                            <label for="modalMeal" class="form-label">Meal</label>
                            <select class="form-select" id="modalMeal">
                                <option>Breakfast</option>
                                <option>Lunch</option>
                                <option>Dinner</option>
                                <option>Snack</option>
                                <option>Other</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="modalNotes" class="form-label">Notes (optional)</label>
                            <textarea class="form-control" id="modalNotes" rows="3"></textarea>
                        </div>
                        <div class="d-flex justify-content-end gap-2">
                            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                            <button type="submit" class="btn btn-primary">Add Food</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {
    // FIX: Move the modal element to the end of the body tag
    // This solves the z-index/backdrop overlay issue
    $('#addModal').appendTo("body"); 

    const addModal = new bootstrap.Modal(document.getElementById('addModal'));

    $('#addFoodBtn').click(function () {
        addModal.show();
    });

    $('#addModalForm').submit(function (e) {
        e.preventDefault();
        const food = $('#modalFoodName').val();
        const meal = $('#modalMeal').val();
        const notes = $('#modalNotes').val();

        const newRow = `<tr>
            <td>${meal}</td>
            <td>${food}</td>
            <td>-</td>
            <td>-</td>
            <td>${notes}</td>
        </tr>`;

        // Remove placeholder if exists
        if ($('#foodLogBody tr').length === 1 && $('#foodLogBody tr td').hasClass('text-center')) {
            $('#foodLogBody').html('');
        }

        $('#foodLogBody').append(newRow);

        addModal.hide();
        // Reset the form
        $('#addModalForm')[0].reset();
    });
});

    </script>
</body>
</html>
