@{
    ViewData["Title"] = "Personalized Nutrition Form";
    string Name = ViewBag.Name;
    string Email = ViewBag.Email;
}

<div class="grid-card shadow-sm border-0 rounded-4" style="min-height: auto; padding: 28px; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(16px);">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <div>
            <h3 style="font-size: 20px; font-weight: 800; color: #0f172a; font-family: 'Outfit', sans-serif;" class="m-0">Daily Food Journal</h3>
            <p class="text-secondary small m-0">Track your logged meals and nutrition breakdown</p>
        </div>
        <button class="btn btn-primary d-inline-flex align-items-center gap-2 px-3 py-2 fw-bold rounded-3 shadow-sm" id="addFoodBtn">
            <i class="fas fa-plus"></i>
            <span>Log Food Item</span>
        </button>
    </div>

    <!-- Control bar -->
    <div class="d-flex gap-2 mb-3 flex-wrap align-items-center">
        <div class="position-relative flex-grow-1" style="min-width: 240px;">
            <i class="fas fa-search position-absolute text-muted" style="left: 14px; top: 50%; transform: translateY(-50%);"></i>
            <input type="search" id="foodSearch" class="form-control ps-5" style="min-height: 44px; border-radius: 12px !important; border: 1.5px solid #cbd5e1 !important; font-size: 14px;" placeholder="Search logged meals or foods..." />
        </div>
        <select id="foodPageSize" class="form-select border" style="max-width: 120px; min-height: 44px; border-radius: 12px; border: 1.5px solid #cbd5e1; font-weight: 500; font-size: 14px;">
            <option value="10">10 / page</option>
            <option value="25">25 / page</option>
            <option value="50">50 / page</option>
            <option value="100">100 / page</option>
        </select>
    </div>

    <!-- Log Table -->
    <div class="checklist-table-wrap rounded-3 border overflow-hidden mb-3">
        <table class="checklist-table table table-hover m-0 align-middle">
            <thead class="table-light">
                <tr class="text-uppercase small text-muted fw-bold" style="letter-spacing: 0.5px;">
                    <th class="py-3 px-3">Meal</th>
                    <th class="py-3">Food Item</th>
                    <th class="py-3">Notes</th>
                    <th class="py-3 text-end px-3">Logged Date</th>
                </tr>
            </thead>
            <tbody id="foodLogBody">
                <tr><td colspan="4" class="text-center text-muted py-4">No entries logged yet today.</td></tr>
            </tbody>
        </table>
    </div>

    <!-- Pagination -->
    <div class="d-flex align-items-center justify-content-between gap-3 flex-wrap pt-2">
        <div id="foodPaginationInfo" class="small text-muted fw-semibold">Showing 0-0 of 0</div>
        <div class="btn-group" role="group" aria-label="Food pagination">
            <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-start-3" id="foodPrevPage">Previous</button>
            <button type="button" class="btn btn-outline-secondary btn-sm px-3 rounded-end-3" id="foodNextPage">Next</button>
        </div>
    </div>
</div>

<!-- Modal Dialog -->
<div class="modal fade" id="addModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 480px;">
        <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden; background: rgba(255, 255, 255, 0.98);">
            <div class="modal-header border-bottom py-3 px-4" style="background: linear-gradient(135deg, #10b981 0%, #059669 100%); color: #ffffff;">
                <h5 class="modal-title fw-bold m-0" style="font-family: 'Outfit', sans-serif;"><i class="fas fa-utensils me-2"></i>Log Food Item</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="addModalForm">
                    <div class="mb-3">
                        <label for="modalFoodName" class="form-label text-secondary small fw-bold text-uppercase">Food Name</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-apple-alt"></i></span>
                            <input type="text" id="modalFoodName" class="form-control border-start-0" style="min-height: 46px; border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;" placeholder="e.g. Grilled Chicken Salad" required>
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        <label for="modalMeal" class="form-label text-secondary small fw-bold text-uppercase">Meal Category</label>
                        <div class="input-group">
                            <span class="input-group-text bg-white border-end-0 text-muted" style="border-top-left-radius:12px; border-bottom-left-radius:12px; border: 1.5px solid #cbd5e1;"><i class="fas fa-clock"></i></span>
                            <select id="modalMeal" class="form-control border-start-0" style="min-height: 46px; border-top-left-radius:0 !important; border-bottom-left-radius:0 !important;">
                                <option>Breakfast</option>
                                <option>Lunch</option>
                                <option>Dinner</option>
                                <option>Snack</option>
                                <option>Other</option>
                            </select>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label for="modalNotes" class="form-label text-secondary small fw-bold text-uppercase">Notes & Portion (optional)</label>
                        <textarea id="modalNotes" class="form-control" rows="3" style="border-radius: 12px !important; border: 1.5px solid #cbd5e1 !important; padding: 12px 16px !important;" placeholder="Add portion size, calories, or recipe notes..."></textarea>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <button type="button" class="btn btn-light border px-4 py-2 fw-semibold rounded-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary px-4 py-2 fw-bold shadow-sm rounded-3">
                            <span>Save Log</span>
                            <i class="fas fa-check ms-1"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Load JQuery only once if not loaded -->
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    $(document).ready(function () {
        $('#addModal').appendTo("body"); 

        const addModal = new bootstrap.Modal(document.getElementById('addModal'));
        const userEmail = '@Email';
        let foodPage = 1;
        let foodPageSize = 10;
        let foodTotalPages = 0;
        let foodTotalRecords = 0;

        function getMealBadge(meal) {
            const m = (meal || '').toLowerCase();
            if (m.includes('breakfast')) return '<span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3">Breakfast</span>';
            if (m.includes('lunch')) return '<span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Lunch</span>';
            if (m.includes('dinner')) return '<span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">Dinner</span>';
            if (m.includes('snack')) return '<span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3">Snack</span>';
            return `<span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3">${$('<div/>').text(meal).html()}</span>`;
        }

        function renderFoodLog(items) {
            const $body = $('#foodLogBody');
            $body.empty();
            if (!items || items.length === 0) {
                $body.append('<tr><td colspan="4" class="text-center text-muted py-4">No entries logged yet today.</td></tr>');
                return;
            }
            for (let i = 0; i < items.length; i++) {
                const it = items[i];
                const badge = getMealBadge(it.meal);
                const row = `<tr>
                    <td class="px-3">${badge}</td>
                    <td class="fw-bold text-dark">${$('<div/>').text(it.foodName).html()}</td>
                    <td class="text-secondary small">${$('<div/>').text(it.notes || '-').html()}</td>
                    <td class="text-end px-3 text-muted small fw-semibold">${$('<div/>').text(it.date || '').html()}</td>
                </tr>`;
                $body.append(row);
            }
        }

        function renderPagination() {
            const from = foodTotalRecords === 0 ? 0 : ((foodPage - 1) * foodPageSize) + 1;
            const to = Math.min(foodPage * foodPageSize, foodTotalRecords);
            $('#foodPaginationInfo').text(foodTotalRecords === 0
                ? 'No logged meals'
                : `Showing ${from}-${to} of ${foodTotalRecords}`);
            $('#foodPrevPage').prop('disabled', foodPage <= 1);
            $('#foodNextPage').prop('disabled', foodPage >= foodTotalPages || foodTotalPages === 0);
        }

        function loadFoodLog(email) {
            const query = $('#foodSearch').val() || '';
            $.get('/FoodLog/List', { email: email, page: foodPage, pageSize: foodPageSize, search: query })
                .done(function (res) {
                    if (res && res.success === false) {
                        console.error('Failed to load food log:', res.message);
                        renderFoodLog([]);
                        foodTotalPages = 0;
                        foodTotalRecords = 0;
                        renderPagination();
                        return;
                    }
                    const items = res.items || [];
                    foodPage = res.page || 1;
                    foodPageSize = res.pageSize || foodPageSize;
                    foodTotalPages = res.totalPages || 0;
                    foodTotalRecords = res.totalRecords || 0;
                    $('#foodPageSize').val(foodPageSize.toString());
                    renderFoodLog(items);
                    renderPagination();
                })
                .fail(function () {
                    renderFoodLog([]);
                    foodTotalPages = 0;
                    foodTotalRecords = 0;
                    renderPagination();
                });
        }

        function debounce(fn, wait) { let t; return function() { const args = arguments; const ctx = this; clearTimeout(t); t = setTimeout(function(){ fn.apply(ctx, args); }, wait); }; }

        $('#foodSearch').on('input', debounce(function () {
            foodPage = 1;
            loadFoodLog(userEmail);
        }, 250));

        $('#foodPageSize').on('change', function () {
            foodPageSize = parseInt($(this).val(), 10) || 10;
            foodPage = 1;
            loadFoodLog(userEmail);
        });

        $('#foodPrevPage').on('click', function () {
            if (foodPage > 1) {
                foodPage--;
                loadFoodLog(userEmail);
            }
        });

        $('#foodNextPage').on('click', function () {
            if (foodPage < foodTotalPages) {
                foodPage++;
                loadFoodLog(userEmail);
            }
        });

        $('#addFoodBtn').click(function () {
            addModal.show();
        });

        $('#addModalForm').submit(function (e) {
            e.preventDefault();
            const data = {
                foodName: $('#modalFoodName').val(),
                meal: $('#modalMeal').val(),
                notes: $('#modalNotes').val(),
                email: userEmail
            };

            $.ajax({
                url: '/FoodLog/Save',
                type: 'POST',
                data: data,
                success: function (res) {
                    if (res && res.success) {
                        addModal.hide();
                        $('#addModalForm')[0].reset();
                        foodPage = 1;
                        loadFoodLog(userEmail);
                        
                        Swal.fire({
                            icon: 'success',
                            title: 'Food Logged!',
                            text: 'Your food log was saved successfully',
                            toast: true,
                            position: 'top-end',
                            showConfirmButton: false,
                            timer: 2000
                        });
                        
                        if (typeof window.loadDailyNutrition === 'function') {
                            window.loadDailyNutrition();
                        } else if (parent && typeof parent.loadDailyNutrition === 'function') {
                            parent.loadDailyNutrition();
                        } else {
                            const todayStrVal = new Date().toDateString();
                            location.reload();
                        }
                    } else {
                        Swal.fire('Error', res?.message || 'Save failed', 'error');
                    }
                },
                error: function () {
                    Swal.fire('Error', 'Something went wrong', 'error');
                }
            });
        });

        if (userEmail && userEmail.length > 0) {
            loadFoodLog(userEmail);
        }
    });
</script>
